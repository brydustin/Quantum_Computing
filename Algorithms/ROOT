chapter AFP

session HHL_Algorithm = Quantum_Computing_CP_Maps +
  description "
    Quantum phase estimation and the HHL algorithm for linear systems: exact and inexact
    analysis, approximate Hamiltonian simulation, programs of quantum Hoare logic, circuits."
  options [document = pdf, document_output = "output",
           document_variants = "document=/proof,/ML",
           quick_and_dirty = false, timeout = 3600]
  sessions
    QHLProver
    Hermitian_Functional_Calculus
  theories
    Phase_Estimation
    QFT_Fourier
    HHL
    HHL_Approximate
    HHL_Window
