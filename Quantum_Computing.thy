(* ============================================================================
   DAY 47
   Topic: Singleton Pauli lists are valid Kraus-operator lists

   The singleton list [P], where P is a self-adjoint involution
   (P^dagger = P, P^2 = I), satisfies the kraus_operators predicate
   on M_2.  This recovers the Pauli channels' \<open>p = 1\<close> case as a
   genuine Kraus map.
   ============================================================================ *)

lemma singleton_kraus_operators:
  assumes W_c: "W \<in> carrier_mat n n"
      and W_dag: "W\<^sup>\<dagger> = W"
      and W_sq: "W * W = 1\<^sub>m n"
  shows "kraus_operators n n [W]"
proof -
  have all_in: "\<forall>X \<in> set [W]. X \<in> carrier_mat n n"
    using W_c by simp
  have step:
    "foldr (\<lambda>X acc. (X\<^sup>\<dagger>) * X + acc) [W] (0\<^sub>m n n)
       = W * W + 0\<^sub>m n n"
    using W_dag by simp
  also have "\<dots> = 1\<^sub>m n + 0\<^sub>m n n"
    using W_sq by simp
  also have "\<dots> = 1\<^sub>m n"
    using W_c by (intro eq_matI) auto
  finally have sum_eq:
    "foldr (\<lambda>X acc. (X\<^sup>\<dagger>) * X + acc) [W] (0\<^sub>m n n) = 1\<^sub>m n" .
  show ?thesis
    unfolding kraus_operators_def
    using all_in sum_eq by blast
qed

lemma pauli_X_kraus_operators:
  "kraus_operators 2 2 [pauli_X]"
  using singleton_kraus_operators[OF pauli_X_carrier pauli_X_dagger pauli_X_squared] .

lemma pauli_Y_kraus_operators:
  "kraus_operators 2 2 [pauli_Y]"
  using singleton_kraus_operators[OF pauli_Y_carrier pauli_Y_dagger pauli_Y_squared] .

