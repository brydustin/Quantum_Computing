lemma bit_phase_flip_channel_fixes_max_mixed:
  fixes p :: real
  shows "bit_phase_flip_channel p (maximally_mixed_state 2)
           = maximally_mixed_state 2"
  using unitary_conj_channel_fixes_max_mixed[OF pauli_Y_carrier
                                                 pauli_Y_unitary]
