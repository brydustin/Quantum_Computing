lemma hamming_weight_append:
  "hamming_weight (xs @ ys) = hamming_weight xs + hamming_weight ys"
  by (simp add: hamming_weight_def)

lemma hamming_weight_repetition_encode:
  "hamming_weight (repetition_encode v) = 2 * hamming_weight v"
  by (simp only: repetition_encode_def hamming_weight_append)

lemma repetition_encode_binary:
  assumes "\<forall>x \<in> set v. x < 2"
  shows "\<forall>x \<in> set (repetition_encode v). x < 2"
  using assms by (auto simp: repetition_encode_def)


(* ============================================================================
   DAY 33 \<mdash> 16 / Nov / 11
   Topic: "Pauli Magic" \<mdash> Hilbert-Schmidt orthogonality of {I, X, Y, Z}
   in M\<^sub>2 and the decomposition of a unitary U as a\<^sub>0 I + a\<^sub>1 X
   + a\<^sub>2 Y + a\<^sub>3 Z with \<bar>a\<^sub>0\<bar>\<^sup>2 + \<dots> + \<bar>a\<^sub>3\<bar>\<^sup>2 = 1.

   These are the algebraic prerequisites for the recovery-map analysis of the
   Shor 9-qubit code (the geometric / 9-qubit subspace facts from PDF
   34.1-34.2 require a 2\<^sup>9-dimensional construction that is deferred).
   ============================================================================ *)

(* ---- Traces of the Pauli matrices and the 2x2 identity ---- *)

lemma Tr_pauli_X: "Tr pauli_X = 0"
  by (simp add: Tr_def pauli_X_def numeral_2_eq_2)

lemma Tr_pauli_Y: "Tr pauli_Y = 0"
  by (simp add: Tr_def pauli_Y_def numeral_2_eq_2)

lemma Tr_pauli_Z: "Tr pauli_Z = 0"
  by (simp add: Tr_def pauli_Z_def numeral_2_eq_2)

lemma Tr_id_2: "Tr (1\<^sub>m 2 :: complex Matrix.mat) = 2"
  by (simp add: Tr_def numeral_2_eq_2)

(* ---- Pauli products needed for HS orthogonality ---- *)

lemma pauli_X_pauli_Y: "pauli_X * pauli_Y = - \<i> \<cdot>\<^sub>m pauli_Z"
  by (simp only: pauli_X_def pauli_Y_def pauli_Z_def times_mat_def smult_mat_def map_mat_def,
                   rule cong_mat, auto simp: scalar_prod_def)

lemma pauli_Y_pauli_X: "pauli_Y * pauli_X = \<i> \<cdot>\<^sub>m pauli_Z"
  by (simp only: pauli_X_def pauli_Y_def pauli_Z_def times_mat_def smult_mat_def map_mat_def,
                   rule cong_mat, auto simp: scalar_prod_def)

lemma pauli_Y_pauli_Z: "pauli_Y * pauli_Z = - \<i> \<cdot>\<^sub>m pauli_X"
  by (simp only: pauli_X_def pauli_Y_def pauli_Z_def times_mat_def smult_mat_def map_mat_def,
                   rule cong_mat, auto simp: scalar_prod_def)

lemma pauli_Z_pauli_Y: "pauli_Z * pauli_Y = \<i> \<cdot>\<^sub>m pauli_X"
  by (simp only: pauli_X_def pauli_Y_def pauli_Z_def times_mat_def smult_mat_def map_mat_def,
                   rule cong_mat, auto simp: scalar_prod_def)

lemma pauli_Z_pauli_X: "pauli_Z * pauli_X = - \<i> \<cdot>\<^sub>m pauli_Y"
  by (simp only: pauli_X_def pauli_Y_def pauli_Z_def times_mat_def smult_mat_def map_mat_def,
                   rule cong_mat, auto simp: scalar_prod_def)

lemma pauli_X_pauli_Z: "pauli_X * pauli_Z = \<i> \<cdot>\<^sub>m pauli_Y"
  by (simp only: pauli_X_def pauli_Y_def pauli_Z_def times_mat_def smult_mat_def map_mat_def,
                   rule cong_mat, auto simp: scalar_prod_def)

(* ---- Hilbert-Schmidt inner products: \<langle>A | B\<rangle>\<^sub>HS = Tr(A\<^sup>\<dagger> * B) ----
   Since X, Y, Z, I are Hermitian, A\<^sup>\<dagger> = A here, so we compute Tr(A * B). *)

lemma Tr_smult_2:
  fixes c :: complex
  assumes "M \<in> carrier_mat 2 2"
  shows "Tr (c \<cdot>\<^sub>m M) = c * Tr M"
  using assms by (simp only: Tr_smult)

lemma pauli_X_X_Tr: "Tr (pauli_X * pauli_X) = 2"
  using pauli_X_squared Tr_id_2 by simp

lemma pauli_Y_Y_Tr: "Tr (pauli_Y * pauli_Y) = 2"
  using pauli_Y_squared Tr_id_2 by simp

lemma pauli_Z_Z_Tr: "Tr (pauli_Z * pauli_Z) = 2"
  using pauli_Z_squared Tr_id_2 by simp

lemma pauli_I_I_Tr: "Tr ((1\<^sub>m 2 :: complex Matrix.mat) * 1\<^sub>m 2) = 2"
  using Tr_id_2 by simp

(* Off-diagonal HS inner products are zero *)

lemma pauli_I_X_Tr: "Tr ((1\<^sub>m 2 :: complex Matrix.mat) * pauli_X) = 0"
proof -
  have "(1\<^sub>m 2 :: complex Matrix.mat) * pauli_X = pauli_X"
    using pauli_X_carrier by (rule left_mult_one_mat)
  thus ?thesis using Tr_pauli_X by simp
qed

lemma pauli_I_Y_Tr: "Tr ((1\<^sub>m 2 :: complex Matrix.mat) * pauli_Y) = 0"
proof -
  have "(1\<^sub>m 2 :: complex Matrix.mat) * pauli_Y = pauli_Y"
    using pauli_Y_carrier by (rule left_mult_one_mat)
  thus ?thesis using Tr_pauli_Y by simp
qed

lemma pauli_I_Z_Tr: "Tr ((1\<^sub>m 2 :: complex Matrix.mat) * pauli_Z) = 0"
proof -
  have "(1\<^sub>m 2 :: complex Matrix.mat) * pauli_Z = pauli_Z"
    using pauli_Z_carrier by (rule left_mult_one_mat)
  thus ?thesis using Tr_pauli_Z by simp
qed

lemma pauli_X_Y_Tr: "Tr (pauli_X * pauli_Y) = 0"
proof -
  have "Tr (pauli_X * pauli_Y) = Tr (- \<i> \<cdot>\<^sub>m pauli_Z)"
    by (simp add: pauli_X_pauli_Y)
  also have "\<dots> = - \<i> * Tr pauli_Z"
    using pauli_Z_carrier by (rule Tr_smult_2)
  also have "\<dots> = 0" using Tr_pauli_Z by simp
  finally show ?thesis.
qed

lemma pauli_Y_X_Tr: "Tr (pauli_Y * pauli_X) = 0"
proof -
  have "Tr (pauli_Y * pauli_X) = Tr (\<i> \<cdot>\<^sub>m pauli_Z)"
    by (simp add: pauli_Y_pauli_X)
  also have "\<dots> = \<i> * Tr pauli_Z"
    using pauli_Z_carrier by (rule Tr_smult_2)
  also have "\<dots> = 0" using Tr_pauli_Z by simp
  finally show ?thesis.
qed

lemma pauli_X_Z_Tr: "Tr (pauli_X * pauli_Z) = 0"
proof -
  have "Tr (pauli_X * pauli_Z) = Tr (\<i> \<cdot>\<^sub>m pauli_Y)"
    by (simp add: pauli_X_pauli_Z)
  also have "\<dots> = \<i> * Tr pauli_Y"
    using pauli_Y_carrier by (rule Tr_smult_2)
  also have "\<dots> = 0" using Tr_pauli_Y by simp
  finally show ?thesis.
qed

lemma pauli_Z_X_Tr: "Tr (pauli_Z * pauli_X) = 0"
proof -
  have "Tr (pauli_Z * pauli_X) = Tr (- \<i> \<cdot>\<^sub>m pauli_Y)"
    by (simp only: pauli_Z_pauli_X)
  also have "\<dots> = - \<i> * Tr pauli_Y"
    using pauli_Y_carrier by (rule Tr_smult_2)
  also have "\<dots> = 0" using Tr_pauli_Y by simp
  finally show ?thesis .
qed

lemma pauli_Y_Z_Tr: "Tr (pauli_Y * pauli_Z) = 0"
proof -
  have "Tr (pauli_Y * pauli_Z) = Tr (- \<i> \<cdot>\<^sub>m pauli_X)"
    by (simp only: pauli_Y_pauli_Z)
  also have "\<dots> = - \<i> * Tr pauli_X"
    using pauli_X_carrier by (rule Tr_smult_2)
  also have "\<dots> = 0" using Tr_pauli_X by simp
  finally show ?thesis .
qed

lemma pauli_Z_Y_Tr: "Tr (pauli_Z * pauli_Y) = 0"
proof -
  have "Tr (pauli_Z * pauli_Y) = Tr (\<i> \<cdot>\<^sub>m pauli_X)"
    by (simp only: pauli_Z_pauli_Y)
  also have "\<dots> = \<i> * Tr pauli_X"
    using pauli_X_carrier by (rule Tr_smult_2)
  also have "\<dots> = 0" using Tr_pauli_X by simp
  finally show ?thesis .
qed

(* ---- Pauli decomposition of an arbitrary 2x2 matrix ----

   The four matrices {I, X, Y, Z} form an HS-orthogonal basis of M\<^sub>2;
   for any M \<in> carrier_mat 2 2 we can read off the coefficients of
   that basis directly from the matrix entries. *)

lemma pauli_decomposition:
  fixes M :: "complex Matrix.mat"
  assumes Mc: "M \<in> carrier_mat 2 2"
  shows "M = (M $$ (0,0) + M $$ (1,1)) / 2 \<cdot>\<^sub>m 1\<^sub>m 2
           + (M $$ (1,0) + M $$ (0,1)) / 2 \<cdot>\<^sub>m pauli_X
           + \<i> * (M $$ (1,0) - M $$ (0,1)) / 2 \<cdot>\<^sub>m pauli_Y
           + (M $$ (0,0) - M $$ (1,1)) / 2 \<cdot>\<^sub>m pauli_Z"
proof (rule eq_matI)
  let ?a0 = "(M $$ (0,0) + M $$ (1,1)) / 2"
  let ?a1 = "(M $$ (1,0) + M $$ (0,1)) / 2"
  let ?a2 = "\<i> * (M $$ (1,0) - M $$ (0,1)) / 2"
  let ?a3 = "(M $$ (0,0) - M $$ (1,1)) / 2"
  let ?R = "?a0 \<cdot>\<^sub>m 1\<^sub>m 2 + ?a1 \<cdot>\<^sub>m pauli_X
            + ?a2 \<cdot>\<^sub>m pauli_Y + ?a3 \<cdot>\<^sub>m pauli_Z"
  show "dim_row M = dim_row ?R"
    using Mc by (simp add: pauli_X_def pauli_Y_def pauli_Z_def)
  show "dim_col M = dim_col ?R"
    using Mc by (simp add: pauli_X_def pauli_Y_def pauli_Z_def)
next
  fix i j
  let ?a0 = "(M $$ (0,0) + M $$ (1,1)) / 2"
  let ?a1 = "(M $$ (1,0) + M $$ (0,1)) / 2"
  let ?a2 = "\<i> * (M $$ (1,0) - M $$ (0,1)) / 2"
  let ?a3 = "(M $$ (0,0) - M $$ (1,1)) / 2"
  let ?R = "?a0 \<cdot>\<^sub>m 1\<^sub>m 2 + ?a1 \<cdot>\<^sub>m pauli_X
            + ?a2 \<cdot>\<^sub>m pauli_Y + ?a3 \<cdot>\<^sub>m pauli_Z"
  assume i: "i < dim_row ?R" and j: "j < dim_col ?R"
  hence ij: "i < 2" "j < 2" by (auto simp: pauli_X_def pauli_Y_def pauli_Z_def)
  show "M $$ (i,j) = ?R $$ (i,j)"
    using ij Mc unfolding pauli_X_def pauli_Y_def pauli_Z_def
    by (cases i; cases j; simp add: field_simps)
qed

(* ---- Norm-squared identity for unitary U expressed in the Pauli basis ----
   Strategy: read the four entries of U directly from the decomposition,
   then compute Tr(U\<^sup>\<dagger> U) entry-by-entry. The parallelogram identity
   \<bar>x+y\<bar>\<^sup>2 + \<bar>x-y\<bar>\<^sup>2 = 2\<bar>x\<bar>\<^sup>2 + 2\<bar>y\<bar>\<^sup>2
   collapses the four cross-terms into 2 \<sqdot> sum-of-squares. *)

lemma unitary_pauli_decomp_norm_sq:
  fixes a0 a1 a2 a3 :: complex
  assumes Uc:    "U \<in> carrier_mat 2 2"
      and Uunit: "unitary U"
      and decomp: "U = a0 \<cdot>\<^sub>m 1\<^sub>m 2 + a1 \<cdot>\<^sub>m pauli_X
                       + a2 \<cdot>\<^sub>m pauli_Y + a3 \<cdot>\<^sub>m pauli_Z"
  shows "(cmod a0)\<^sup>2 + (cmod a1)\<^sup>2 + (cmod a2)\<^sup>2 + (cmod a3)\<^sup>2 = 1"
proof -
  (* Step 1: read off the four entries of U from the decomposition. *)
  have U00: "U $$ (0,0) = a0 + a3"
    using decomp by (simp add: pauli_X_def pauli_Y_def pauli_Z_def)
  have U01: "U $$ (0,1) = a1 + \<i> * a2"
    using decomp by (simp add: pauli_X_def pauli_Y_def pauli_Z_def)
  have U10: "U $$ (1,0) = a1 - \<i> * a2"
    using decomp by (simp add: pauli_X_def pauli_Y_def pauli_Z_def)
  have U11: "U $$ (1,1) = a0 - a3"
    using decomp by (simp add: pauli_X_def pauli_Y_def pauli_Z_def)

  (* Step 2: Tr(U\<^sup>\<dagger> U) = 2 from unitarity. *)
  have UdU: "U\<^sup>\<dagger> * U = 1\<^sub>m 2"
    using Uunit Uc by (auto simp: unitary_def)
  have Tr_eq_2: "Tr (U\<^sup>\<dagger> * U) = 2"
    using UdU Tr_id_2 by simp

  (* Step 3: expand Tr(U\<^sup>\<dagger> U) = sum_i (U\<^sup>\<dagger> U)(i,i),
     which by definition equals the sum of \<bar>U(i,j)\<bar>\<^sup>2. *)
  have Udag_c: "U\<^sup>\<dagger> \<in> carrier_mat 2 2" using Uc by (rule dagger_carrier)
  have UdU_c:  "U\<^sup>\<dagger> * U \<in> carrier_mat 2 2"
    using Udag_c Uc by (rule mult_carrier_mat)

  have UdU_00: "(U\<^sup>\<dagger> * U) $$ (0,0)
              = cnj (U $$ (0,0)) * U $$ (0,0) + cnj (U $$ (1,0)) * U $$ (1,0)"
    using Uc by (simp add: dagger_def scalar_prod_def numeral_2_eq_2)
  have UdU_11: "(U\<^sup>\<dagger> * U) $$ (1,1)
              = cnj (U $$ (0,1)) * U $$ (0,1) + cnj (U $$ (1,1)) * U $$ (1,1)"
    using Uc by (simp add: dagger_def scalar_prod_def numeral_2_eq_2)

  have UdU_dr: "dim_row (U\<^sup>\<dagger> * U) = 2" using UdU_c by (rule carrier_matD(1))
  have UdU_dc: "dim_col (U\<^sup>\<dagger> * U) = 2" using UdU_c by (rule carrier_matD(2))
  have Tr_split:
    "Tr (U\<^sup>\<dagger> * U) = (U\<^sup>\<dagger> * U) $$ (0,0) + (U\<^sup>\<dagger> * U) $$ (1,1)"
  proof -
    have "Tr (U\<^sup>\<dagger> * U)
            = (\<Sum>i<dim_col (U\<^sup>\<dagger> * U).
                  if i < dim_row (U\<^sup>\<dagger> * U)
                  then (U\<^sup>\<dagger> * U) $$ (i,i) else 0)"
      by (simp add: Tr_def)
    also have "\<dots> = (\<Sum>i<2.
                       (U\<^sup>\<dagger> * U) $$ (i,i))"
      using UdU_dr UdU_dc by simp
    also have "\<dots> = (U\<^sup>\<dagger> * U) $$ (0,0) + (U\<^sup>\<dagger> * U) $$ (1,1)"
      by (simp add: numeral_2_eq_2)
    finally show ?thesis .
  qed
  have Tr_expand:
    "Tr (U\<^sup>\<dagger> * U)
       = cnj (U $$ (0,0)) * U $$ (0,0) + cnj (U $$ (1,0)) * U $$ (1,0)
       + cnj (U $$ (0,1)) * U $$ (0,1) + cnj (U $$ (1,1)) * U $$ (1,1)"
    using Tr_split UdU_00 UdU_11 by (simp only: ac_simps)

  (* Step 4: use cnj z * z = of_real ((cmod z)\<^sup>2). *)
  have cnj_self: "\<And>z :: complex. cnj z * z = complex_of_real ((cmod z)\<^sup>2)"
    by (metis complex_norm_square mult.commute)

  have abs_sum: "Tr (U\<^sup>\<dagger> * U)
       = complex_of_real ((cmod (U $$ (0,0)))\<^sup>2)
       + complex_of_real ((cmod (U $$ (1,0)))\<^sup>2)
       + complex_of_real ((cmod (U $$ (0,1)))\<^sup>2)
       + complex_of_real ((cmod (U $$ (1,1)))\<^sup>2)"
    using Tr_expand cnj_self by simp

  (* Step 5: substitute the entries from Step 1 and apply the
     parallelogram identity \<bar>x+y\<bar>\<^sup>2 + \<bar>x-y\<bar>\<^sup>2
     = 2\<bar>x\<bar>\<^sup>2 + 2\<bar>y\<bar>\<^sup>2. *)
  have parallelogram:
    "\<And>x y :: complex.
       (cmod (x + y))\<^sup>2 + (cmod (x - y))\<^sup>2
     = 2 * (cmod x)\<^sup>2 + 2 * (cmod y)\<^sup>2"
    by (simp only: cmod_power2)
       (simp add: power2_eq_square algebra_simps)

  have step_a:
    "(cmod (a0 + a3))\<^sup>2 + (cmod (a0 - a3))\<^sup>2
   = 2 * (cmod a0)\<^sup>2 + 2 * (cmod a3)\<^sup>2"
    by (rule parallelogram)
  have step_b:
    "(cmod (a1 + \<i> * a2))\<^sup>2 + (cmod (a1 - \<i> * a2))\<^sup>2
   = 2 * (cmod a1)\<^sup>2 + 2 * (cmod (\<i> * a2))\<^sup>2"
    by (rule parallelogram)
  have ia2: "cmod (\<i> * a2) = cmod a2"
    by (simp add: norm_mult)

  (* Now we work with the real number obtained from Tr(U\<^sup>\<dagger> U). *)
  have real_sum: "(cmod (a0 + a3))\<^sup>2 + (cmod (a1 - \<i> * a2))\<^sup>2
                  + (cmod (a1 + \<i> * a2))\<^sup>2 + (cmod (a0 - a3))\<^sup>2
                = 2 * ((cmod a0)\<^sup>2 + (cmod a1)\<^sup>2
                       + (cmod a2)\<^sup>2 + (cmod a3)\<^sup>2)"
    using step_a step_b ia2 by (simp only: algebra_simps)

  have "complex_of_real ((cmod (a0 + a3))\<^sup>2)
      + complex_of_real ((cmod (a1 - \<i> * a2))\<^sup>2)
      + complex_of_real ((cmod (a1 + \<i> * a2))\<^sup>2)
      + complex_of_real ((cmod (a0 - a3))\<^sup>2)
      = Tr (U\<^sup>\<dagger> * U)"
    using abs_sum U00 U01 U10 U11 by simp
  also have "Tr (U\<^sup>\<dagger> * U) = 2" using Tr_eq_2 .
  finally have complex_eq:
    "complex_of_real ((cmod (a0 + a3))\<^sup>2 + (cmod (a1 - \<i> * a2))\<^sup>2
                      + (cmod (a1 + \<i> * a2))\<^sup>2 + (cmod (a0 - a3))\<^sup>2)
       = complex_of_real 2"
    by (simp add: of_real_add)

  hence "(cmod (a0 + a3))\<^sup>2 + (cmod (a1 - \<i> * a2))\<^sup>2
       + (cmod (a1 + \<i> * a2))\<^sup>2 + (cmod (a0 - a3))\<^sup>2 = 2"
    by (simp only: of_real_eq_iff)
  with real_sum
  have "2 * ((cmod a0)\<^sup>2 + (cmod a1)\<^sup>2 + (cmod a2)\<^sup>2 + (cmod a3)\<^sup>2) = 2"
    by linarith
  thus ?thesis by simp
qed


(* ============================================================================
   DAY 34 \<mdash> 18 / Nov / 11
   Topic: Algebra of Projections (Building Blocks for Knill-Laflamme)

   The standard algebraic facts about projections that underlie the
   orthogonal-syndrome / Knill-Laflamme construction.  The full
   Knill-Laflamme theorems remain deferred; they need eigenbasis
   decomposition machinery beyond the current scope.
   ============================================================================ *)

(* The complementary projection \<open>1 - P\<close> is itself a projection. *)

lemma projection_complement:
  assumes "projection n P"
  shows "projection n (1\<^sub>m n - P)"
proof -
  have P_c: "P \<in> carrier_mat n n" using assms by (rule projection_carrier)
  have P_h: "hermitian P" using assms by (rule projection_hermitian)
  have P_dag: "P\<^sup>\<dagger> = P" using P_h by (simp only: hermitian_def)
  have I_dag: "(1\<^sub>m n :: complex Matrix.mat)\<^sup>\<dagger> = 1\<^sub>m n"
    by (intro eq_matI) (auto simp: dagger_def)
  have I_c: "(1\<^sub>m n :: complex Matrix.mat) \<in> carrier_mat n n" by simp
  have IP_c: "(1\<^sub>m n - P) \<in> carrier_mat n n"
    using P_c by (rule minus_carrier_mat)
  have IP_dag: "(1\<^sub>m n - P)\<^sup>\<dagger> = 1\<^sub>m n - P"
  proof (rule eq_matI)
    show "dim_row ((1\<^sub>m n - P)\<^sup>\<dagger>) = dim_row (1\<^sub>m n - P)"
      using P_c by simp
    show "dim_col ((1\<^sub>m n - P)\<^sup>\<dagger>) = dim_col (1\<^sub>m n - P)"
      using P_c by simp
  next
    fix i j
    assume i: "i < dim_row (1\<^sub>m n - P)"
       and j: "j < dim_col (1\<^sub>m n - P)"
    hence ij: "i < n" "j < n" using P_c by simp_all
    have P_swap: "P $$ (j, i) = cnj (P $$ (i, j))"
    proof -
      have "(P\<^sup>\<dagger>) $$ (i, j) = cnj (P $$ (j, i))"
        using ij P_c by (simp add: dagger_def)
      hence "P $$ (i, j) = cnj (P $$ (j, i))"
        using P_dag by simp
      thus ?thesis by simp
    qed
    have one_entry_self_cnj:
      "(1\<^sub>m n :: complex Matrix.mat) $$ (j, i)
        = cnj ((1\<^sub>m n :: complex Matrix.mat) $$ (i, j))"
      using ij by auto
    show "((1\<^sub>m n - P)\<^sup>\<dagger>) $$ (i, j) = (1\<^sub>m n - P) $$ (i, j)"
      using ij P_c P_swap one_entry_self_cnj
      by (simp add: dagger_def)
  qed
  have IP_h: "hermitian (1\<^sub>m n - P)" using IP_dag by (simp add: hermitian_def)
  have IP_idem: "(1\<^sub>m n - P) * (1\<^sub>m n - P) = 1\<^sub>m n - P"
    using assms by (rule projection_complement_idempotent)
  show ?thesis
    unfolding projection_def using IP_c IP_h IP_idem by blast
qed

(* Two projections are *orthogonal* if their product (in either order) is zero. *)

definition orthogonal_projections ::
  "nat \<Rightarrow> complex Matrix.mat \<Rightarrow> complex Matrix.mat \<Rightarrow> bool" where
  "orthogonal_projections n P Q \<equiv>
     projection n P \<and> projection n Q \<and>
     P * Q = 0\<^sub>m n n \<and> Q * P = 0\<^sub>m n n"

lemma orthogonal_projections_carrier_left:
  "orthogonal_projections n P Q \<Longrightarrow> P \<in> carrier_mat n n"
  by (simp only: orthogonal_projections_def projection_def)

lemma orthogonal_projections_carrier_right:
  "orthogonal_projections n P Q \<Longrightarrow> Q \<in> carrier_mat n n"
  by (simp only: orthogonal_projections_def projection_def)

lemma orthogonal_projections_symm:
  "orthogonal_projections n P Q \<longleftrightarrow> orthogonal_projections n Q P"
  by (auto simp: orthogonal_projections_def)

(* The sum of orthogonal projections is a projection. *)

lemma orthogonal_projections_sum:
  assumes opq: "orthogonal_projections n P Q"
  shows "projection n (P + Q)"
proof -
  have P_proj: "projection n P"
    using opq by (simp add: orthogonal_projections_def)
  have Q_proj: "projection n Q"
    using opq by (simp add: orthogonal_projections_def)
  have PQ_zero: "P * Q = 0\<^sub>m n n"
    using opq by (simp add: orthogonal_projections_def)
  have QP_zero: "Q * P = 0\<^sub>m n n"
    using opq by (simp add: orthogonal_projections_def)
  have P_c: "P \<in> carrier_mat n n" using P_proj by (rule projection_carrier)
  have Q_c: "Q \<in> carrier_mat n n" using Q_proj by (rule projection_carrier)
  have P_idem: "P * P = P" using P_proj by (rule projection_idempotent)
  have Q_idem: "Q * Q = Q" using Q_proj by (rule projection_idempotent)
  have P_h: "hermitian P" using P_proj by (rule projection_hermitian)
  have Q_h: "hermitian Q" using Q_proj by (rule projection_hermitian)
  have P_dag: "P\<^sup>\<dagger> = P" using P_h by (simp only: hermitian_def)
  have Q_dag: "Q\<^sup>\<dagger> = Q" using Q_h by (simp only: hermitian_def)

  have PQ_c: "P + Q \<in> carrier_mat n n" using P_c Q_c by simp

  have PQ_dag: "(P + Q)\<^sup>\<dagger> = P + Q"
  proof -
    have "(P + Q)\<^sup>\<dagger> = (P\<^sup>\<dagger>) + (Q\<^sup>\<dagger>)"
      using P_c Q_c
      by (intro eq_matI, auto simp: dagger_def)
    also have "\<dots> = P + Q" using P_dag Q_dag by simp
    finally show ?thesis.
  qed
  have PQ_h: "hermitian (P + Q)" using PQ_dag by (simp only: hermitian_def)

  have PQ_idem: "(P + Q) * (P + Q) = P + Q"
  proof -
    have expand:
      "(P + Q) * (P + Q) = P * P + P * Q + (Q * P + Q * Q)"
      using P_c Q_c
      by (smt (verit) add_carrier_mat add_mult_distrib_mat
          mult_add_distrib_mat assoc_add_mat)
    have "P * P + P * Q + (Q * P + Q * Q)
            = P + 0\<^sub>m n n + (0\<^sub>m n n + Q)"
      using P_idem Q_idem PQ_zero QP_zero by simp
    also have "\<dots> = P + Q"
      using P_c Q_c by (intro eq_matI, auto)
    finally show ?thesis using expand by simp
  qed
  show ?thesis unfolding projection_def using PQ_c PQ_h PQ_idem by blast
qed

(* Pythagorean decomposition: P + Q + (I - P - Q) = I when P, Q are
   orthogonal projections.  Building block for the Day-33 syndrome
   decomposition I = (sum P_i) + (I - sum P_i). *)

lemma orthogonal_projections_decomp_id:
  assumes "orthogonal_projections n P Q"
  shows "P + Q + (1\<^sub>m n - P - Q) = 1\<^sub>m n"
proof -
  have P_c: "P \<in> carrier_mat n n"
    using assms by (rule orthogonal_projections_carrier_left)
  have Q_c: "Q \<in> carrier_mat n n"
    using assms by (rule orthogonal_projections_carrier_right)
  show ?thesis using P_c Q_c by (intro eq_matI) auto
qed


