(* ============================================================================
   DAY 28 \<mdash> 2 / Nov / 11
   Topic: Universal Entanglement Witnesses.

   A density matrix \<rho> on H\<^sub>A \<otimes> H\<^sub>B is separable iff for every
   entanglement witness W (Hermitian, Tr(W \<sigma>) \<ge> 0 for all separable
   \<sigma>) we have Tr(W \<rho>) \<ge> 0.  The "iff" requires Hahn-Banach;
   here we record the easy (forward) direction together with the
   underlying definitions of separability and witness.
   ============================================================================ *)

fun sep_sum :: "nat \<Rightarrow> nat \<Rightarrow> (real \<times> complex Matrix.mat \<times> complex Matrix.mat) list
                 \<Rightarrow> complex Matrix.mat" where
  "sep_sum m p [] = 0\<^sub>m (m*p) (m*p)"
| "sep_sum m p ((w, \<sigma>, \<tau>) # ts) =
     complex_of_real w \<cdot>\<^sub>m (\<sigma> \<Otimes> \<tau>) + sep_sum m p ts"

definition sep_decomp_valid ::
  "nat \<Rightarrow> nat \<Rightarrow> (real \<times> complex Matrix.mat \<times> complex Matrix.mat) list \<Rightarrow> bool"
where
  "sep_decomp_valid m p ts \<equiv>
     (\<forall>(w, \<sigma>, \<tau>) \<in> set ts.
         w \<ge> 0
         \<and> \<sigma> \<in> carrier_mat m m \<and> psd \<sigma>
         \<and> \<tau> \<in> carrier_mat p p \<and> psd \<tau>)
     \<and> sum_list (map (\<lambda>(w, _, _). w) ts) = 1"

definition separable_density :: "nat \<Rightarrow> nat \<Rightarrow> complex Matrix.mat \<Rightarrow> bool" where
  "separable_density m p \<rho> \<equiv>
     \<exists>ts. sep_decomp_valid m p ts \<and> \<rho> = sep_sum m p ts"

definition entanglement_witness ::
  "nat \<Rightarrow> nat \<Rightarrow> complex Matrix.mat \<Rightarrow> bool"
where
  "entanglement_witness m p W \<equiv>
     W \<in> carrier_mat (m*p) (m*p)
     \<and> hermitian W
     \<and> (\<forall>\<sigma> \<tau>. \<sigma> \<in> carrier_mat m m \<and> psd \<sigma>
                  \<and> \<tau> \<in> carrier_mat p p \<and> psd \<tau>
                  \<longrightarrow> Re (Tr (W * (\<sigma> \<Otimes> \<tau>))) \<ge> 0)"

lemma sep_sum_carrier:
  "sep_sum m p ts \<in> carrier_mat (m*p) (m*p)"
proof (induction ts)
  case Nil
  show ?case by simp
next
  case (Cons t ts)
  obtain w \<sigma> \<tau> where t_eq: "t = (w, \<sigma>, \<tau>)" by (cases t)
  show ?case
    using Cons.IH unfolding t_eq
    by (simp add: add_carrier_mat)
qed

theorem separable_witness_nonneg:
  fixes m p :: nat and \<rho> W :: "complex Matrix.mat"
  assumes sep: "separable_density m p \<rho>"
      and wit: "entanglement_witness m p W"
  shows "Re (Tr (W * \<rho>)) \<ge> 0"
proof -
  obtain ts where ts_v: "sep_decomp_valid m p ts"
              and \<rho>_eq: "\<rho> = sep_sum m p ts"
    using sep unfolding separable_density_def by blast
  have W_c: "W \<in> carrier_mat (m*p) (m*p)"
    using wit unfolding entanglement_witness_def by simp
  have step: "Re (Tr (W * sep_sum m p ts)) \<ge> 0"
    if "\<forall>(w, \<sigma>, \<tau>) \<in> set ts.
           w \<ge> 0 \<and> \<sigma> \<in> carrier_mat m m \<and> psd \<sigma>
                 \<and> \<tau> \<in> carrier_mat p p \<and> psd \<tau>"
    for ts
    using that
  proof (induction ts)
    case Nil
    have W0: "W * 0\<^sub>m (m*p) (m*p) = 0\<^sub>m (m*p) (m*p)"
      using W_c by (rule right_mult_zero_mat)
    show ?case by (simp add: W0)
  next
    case (Cons t ts)
    obtain w \<sigma> \<tau> where t_eq: "t = (w, \<sigma>, \<tau>)" by (cases t)
    from Cons.prems t_eq have
      w_nn: "w \<ge> 0" and
      \<sigma>_c: "\<sigma> \<in> carrier_mat m m" and
      \<sigma>_psd: "psd \<sigma>" and
      \<tau>_c: "\<tau> \<in> carrier_mat p p" and
      \<tau>_psd: "psd \<tau>"
      by auto
    from Cons.prems t_eq have ts_v':
      "\<forall>(w, \<sigma>, \<tau>) \<in> set ts.
           w \<ge> 0 \<and> \<sigma> \<in> carrier_mat m m \<and> psd \<sigma>
                 \<and> \<tau> \<in> carrier_mat p p \<and> psd \<tau>"
      by auto
    have st_c: "\<sigma> \<Otimes> \<tau> \<in> carrier_mat (m*p) (m*p)"
      using \<sigma>_c \<tau>_c by auto
    have ws_c: "complex_of_real w \<cdot>\<^sub>m (\<sigma> \<Otimes> \<tau>) \<in> carrier_mat (m*p) (m*p)"
      using st_c by auto
    have rest_c: "sep_sum m p ts \<in> carrier_mat (m*p) (m*p)"
      using sep_sum_carrier by simp
    have W\<sigma>\<tau>_c: "W * (\<sigma> \<Otimes> \<tau>) \<in> carrier_mat (m*p) (m*p)"
      using W_c st_c by auto
    have Wts_c: "W * sep_sum m p ts \<in> carrier_mat (m*p) (m*p)"
      using W_c rest_c by auto
    have Wsmcc_c: "complex_of_real w \<cdot>\<^sub>m (W * (\<sigma> \<Otimes> \<tau>)) \<in> carrier_mat (m*p) (m*p)"
      using W\<sigma>\<tau>_c by auto
    have step1:
      "W * sep_sum m p (t#ts)
         = W * (complex_of_real w \<cdot>\<^sub>m (\<sigma> \<Otimes> \<tau>)) + W * sep_sum m p ts"
      using W_c ws_c rest_c
      by (simp add: t_eq mult_add_distrib_mat)
    have step2:
      "W * (complex_of_real w \<cdot>\<^sub>m (\<sigma> \<Otimes> \<tau>))
         = complex_of_real w \<cdot>\<^sub>m (W * (\<sigma> \<Otimes> \<tau>))"
      using W_c st_c by (simp add: mult_smult_distrib)
    have W\<rho>_eq:
      "W * sep_sum m p (t#ts)
         = complex_of_real w \<cdot>\<^sub>m (W * (\<sigma> \<Otimes> \<tau>)) + W * sep_sum m p ts"
      using step1 step2 by simp
    have Treq:
      "Tr (W * sep_sum m p (t#ts))
         = complex_of_real w * Tr (W * (\<sigma> \<Otimes> \<tau>)) + Tr (W * sep_sum m p ts)"
    proof -
      have "Tr (W * sep_sum m p (t#ts))
              = Tr (complex_of_real w \<cdot>\<^sub>m (W * (\<sigma> \<Otimes> \<tau>)) + W * sep_sum m p ts)"
        using W\<rho>_eq by simp
      also have "\<dots> = Tr (complex_of_real w \<cdot>\<^sub>m (W * (\<sigma> \<Otimes> \<tau>))) + Tr (W * sep_sum m p ts)"
      proof (rule Tr_add)
        have dr1: "dim_row (complex_of_real w \<cdot>\<^sub>m (W * (\<sigma> \<Otimes> \<tau>))) = m*p"
          using Wsmcc_c by (rule carrier_matD(1))
        have dr2: "dim_row (W * sep_sum m p ts) = m*p"
          using Wts_c by (rule carrier_matD(1))
        have dc1: "dim_col (complex_of_real w \<cdot>\<^sub>m (W * (\<sigma> \<Otimes> \<tau>))) = m*p"
          using Wsmcc_c by (rule carrier_matD(2))
        have dc2: "dim_col (W * sep_sum m p ts) = m*p"
          using Wts_c by (rule carrier_matD(2))
        show "dim_row (complex_of_real w \<cdot>\<^sub>m (W * (\<sigma> \<Otimes> \<tau>))) = dim_row (W * sep_sum m p ts)"
          using dr1 dr2 by simp
        show "dim_col (complex_of_real w \<cdot>\<^sub>m (W * (\<sigma> \<Otimes> \<tau>))) = dim_col (W * sep_sum m p ts)"
          using dc1 dc2 by simp
      qed
      also have "\<dots> = complex_of_real w * Tr (W * (\<sigma> \<Otimes> \<tau>)) + Tr (W * sep_sum m p ts)"
        by (simp add: Tr_smult)
      finally show ?thesis .
    qed
    have wit_term: "Re (Tr (W * (\<sigma> \<Otimes> \<tau>))) \<ge> 0"
      using wit \<sigma>_c \<sigma>_psd \<tau>_c \<tau>_psd
      unfolding entanglement_witness_def by blast
    have IH: "Re (Tr (W * sep_sum m p ts)) \<ge> 0"
      using Cons.IH ts_v' by blast
    have re_sum:
      "Re (Tr (W * sep_sum m p (t#ts)))
         = w * Re (Tr (W * (\<sigma> \<Otimes> \<tau>))) + Re (Tr (W * sep_sum m p ts))"
      using Treq by simp
    show ?case
      using re_sum w_nn wit_term IH
      by (simp add: mult_nonneg_nonneg)
  qed
  have ts_terms:
    "\<forall>(w, \<sigma>, \<tau>) \<in> set ts.
        w \<ge> 0 \<and> \<sigma> \<in> carrier_mat m m \<and> psd \<sigma>
              \<and> \<tau> \<in> carrier_mat p p \<and> psd \<tau>"
    using ts_v unfolding sep_decomp_valid_def by blast
  show ?thesis using step[OF ts_terms] \<rho>_eq by simp
qed

(* Contrapositive: a density matrix that violates a witness is non-separable. *)

corollary nonseparable_from_witness:
  fixes m p :: nat and \<rho> W :: "complex Matrix.mat"
  assumes wit: "entanglement_witness m p W"
      and neg: "Re (Tr (W * \<rho>)) < 0"
    shows "\<not> separable_density m p \<rho>"
  using separable_witness_nonneg[OF _ wit] neg by force


(* ---- Building block for the converse direction: tensor product of
   PSD matrices is PSD.  Proof: take square roots, use the mixed
   product law \<open>(A \<Otimes> B) (C \<Otimes> D) = (AC) \<Otimes> (BD)\<close>
   (\<open>mult_distr_tensor\<close>) and tensor adjoint
   (\<open>tensor_mat_dagger\<close>) to write \<open>\<sigma> \<Otimes> \<tau>\<close> as
   \<open>(Q \<Otimes> R)\<^sup>\<dagger> (Q \<Otimes> R)\<close> for square roots Q, R; then
   \<open>psd_MdagM\<close> closes. ---- *)

lemma tensor_psd:
  fixes \<sigma> \<tau> :: "complex Matrix.mat" and m p :: nat
  assumes \<sigma>_c: "\<sigma> \<in> carrier_mat m m" and \<sigma>_psd: "psd \<sigma>"
      and \<tau>_c: "\<tau> \<in> carrier_mat p p" and \<tau>_psd: "psd \<tau>"
      and m_pos: "0 < m" and p_pos: "0 < p"
  shows "psd (\<sigma> \<Otimes> \<tau>)"
proof -
  obtain Q where Q_c: "Q \<in> carrier_mat m m" and Q_psd: "psd Q"
             and Q_sq: "Q * Q = \<sigma>"
    using psd_sqrt_exists[OF \<sigma>_c \<sigma>_psd] by blast
  obtain R where R_c: "R \<in> carrier_mat p p" and R_psd: "psd R"
             and R_sq: "R * R = \<tau>"
    using psd_sqrt_exists[OF \<tau>_c \<tau>_psd] by blast
  have Q_h: "Q\<^sup>\<dagger> = Q"
    using psd_hermitian[OF Q_psd] unfolding hermitian_def by simp
  have R_h: "R\<^sup>\<dagger> = R"
    using psd_hermitian[OF R_psd] unfolding hermitian_def by simp
  have Q_dc: "dim_col Q = m" using Q_c by simp
  have Q_dr: "dim_row Q = m" using Q_c by simp
  have R_dc: "dim_col R = p" using R_c by simp
  have R_dr: "dim_row R = p" using R_c by simp

  have mixed:
    "(Q * Q) \<Otimes> (R * R) = (Q \<Otimes> R) * (Q \<Otimes> R)"
    using Q_dc Q_dr R_dc R_dr m_pos p_pos
    by (intro mult_distr_tensor) auto
  have st_eq: "\<sigma> \<Otimes> \<tau> = (Q \<Otimes> R) * (Q \<Otimes> R)"
    using mixed Q_sq R_sq by simp

  have QR_c: "Q \<Otimes> R \<in> carrier_mat (m*p) (m*p)"
    using Q_c R_c by simp
  have QR_dag_c: "(Q \<Otimes> R)\<^sup>\<dagger> \<in> carrier_mat (m*p) (m*p)"
    using QR_c by (rule dagger_carrier)
  have QR_dag_eq: "(Q \<Otimes> R)\<^sup>\<dagger> = Q \<Otimes> R"
  proof -
    have "(Q \<Otimes> R)\<^sup>\<dagger> = (Q\<^sup>\<dagger>) \<Otimes> (R\<^sup>\<dagger>)"
      by (rule tensor_mat_dagger[OF Q_c R_c m_pos m_pos p_pos p_pos])
    also have "\<dots> = Q \<Otimes> R" using Q_h R_h by simp
    finally show ?thesis .
  qed
  have st_psd: "psd ((Q \<Otimes> R)\<^sup>\<dagger> * (Q \<Otimes> R))"
    by (rule psd_MdagM[OF QR_c])
  show "psd (\<sigma> \<Otimes> \<tau>)"
    using st_eq st_psd QR_dag_eq by simp
qed


(* Trace of the product of two PSD matrices has non-negative real
   part.  Standard proof: \<open>X = Q\<^sup>2\<close> with Q PSD; cyclic
   trace gives \<open>Tr (W X) = Tr (Q W Q)\<close>, and
   \<open>Q W Q = (R Q)\<^sup>\<dagger> (R Q)\<close> for the PSD square root R of
   W; conclude via \<open>psd_MdagM\<close> + \<open>Re_Tr_psd_nonneg\<close>. *)

lemma Re_Tr_psd_psd_nonneg:
  fixes W X :: "complex Matrix.mat" and n :: nat
  assumes W_c: "W \<in> carrier_mat n n" and W_psd: "psd W"
      and X_c: "X \<in> carrier_mat n n" and X_psd: "psd X"
  shows "0 \<le> Re (Tr (W * X))"
proof -
  obtain Q where Q_c: "Q \<in> carrier_mat n n" and Q_psd: "psd Q"
             and Q_sq: "Q * Q = X"
    using psd_sqrt_exists[OF X_c X_psd] by blast
  obtain R where R_c: "R \<in> carrier_mat n n" and R_psd: "psd R"
             and R_sq: "R * R = W"
    using psd_sqrt_exists[OF W_c W_psd] by blast
  have Q_h: "Q\<^sup>\<dagger> = Q"
    using psd_hermitian[OF Q_psd] unfolding hermitian_def by simp
  have R_h: "R\<^sup>\<dagger> = R"
    using psd_hermitian[OF R_psd] unfolding hermitian_def by simp
  have W_Q_c: "W * Q \<in> carrier_mat n n" using W_c Q_c by simp
  have R_Q_c: "R * Q \<in> carrier_mat n n" using R_c Q_c by simp

  have Tr_eq: "Tr (W * X) = Tr (Q * W * Q)"
  proof -
    have "Tr (W * X) = Tr (W * (Q * Q))" using Q_sq by simp
    also have "\<dots> = Tr ((W * Q) * Q)"
      using assoc_mult_mat[OF W_c Q_c Q_c] by simp
    also have "\<dots> = Tr (Q * (W * Q))"
    proof (rule Tr_cyclic)
      show "dim_col (W * Q) = dim_row Q" using W_c Q_c by simp
      show "dim_row (W * Q) = dim_col Q" using W_c Q_c by simp
    qed
    also have "\<dots> = Tr (Q * W * Q)"
      using assoc_mult_mat[OF Q_c W_c Q_c] by simp
    finally show ?thesis .
  qed

  have QWQ_eq: "Q * W * Q = (R * Q)\<^sup>\<dagger> * (R * Q)"
  proof -
    have RQ_dim: "dim_col R = dim_row Q" using R_c Q_c by simp
    have "(R * Q)\<^sup>\<dagger> = (Q\<^sup>\<dagger>) * (R\<^sup>\<dagger>)"
      by (rule dagger_of_prod[OF RQ_dim])
    also have "\<dots> = Q * R" using Q_h R_h by simp
    finally have dag_RQ: "(R * Q)\<^sup>\<dagger> = Q * R" .
    have RQ_c: "R * Q \<in> carrier_mat n n" using R_c Q_c by simp
    have RR_c: "R * R \<in> carrier_mat n n" using R_c by simp
    have "(R * Q)\<^sup>\<dagger> * (R * Q) = (Q * R) * (R * Q)"
      using dag_RQ by simp
    also have "\<dots> = Q * (R * (R * Q))"
      by (rule assoc_mult_mat[OF Q_c R_c RQ_c])
    also have "\<dots> = Q * ((R * R) * Q)"
    proof -
      have "R * (R * Q) = (R * R) * Q"
        by (rule assoc_mult_mat[OF R_c R_c Q_c, symmetric])
      thus ?thesis by simp
    qed
    also have "\<dots> = (Q * (R * R)) * Q"
      by (rule assoc_mult_mat[OF Q_c RR_c Q_c, symmetric])
    also have "\<dots> = Q * W * Q"
      using R_sq by simp
    finally show ?thesis by (rule sym)
  qed

  have QWQ_c: "Q * W * Q \<in> carrier_mat n n"
    using Q_c W_c by simp
  have QWQ_psd: "psd (Q * W * Q)"
    using QWQ_eq psd_MdagM[OF R_Q_c] by simp

  have "0 \<le> Re (Tr (Q * W * Q))"
    by (rule Re_Tr_psd_nonneg[OF QWQ_c QWQ_psd])
  thus "0 \<le> Re (Tr (W * X))" using Tr_eq by simp
qed


(* Every PSD matrix in M_{m*p} is an entanglement witness.  Combines
   tensor_psd (\<sigma> \<otimes> \<tau> is PSD) with Re_Tr_psd_psd_nonneg
   (Re Tr of PSD-PSD is non-negative). *)

lemma psd_is_entanglement_witness:
  fixes W :: "complex Matrix.mat" and m p :: nat
  assumes W_c: "W \<in> carrier_mat (m*p) (m*p)" and W_psd: "psd W"
      and m_pos: "0 < m" and p_pos: "0 < p"
  shows "entanglement_witness m p W"
proof -
  have W_h: "hermitian W" by (rule psd_hermitian[OF W_psd])
  have witness_bound: "\<forall>\<sigma> \<tau>. \<sigma> \<in> carrier_mat m m \<and> psd \<sigma>
                            \<and> \<tau> \<in> carrier_mat p p \<and> psd \<tau>
                            \<longrightarrow> 0 \<le> Re (Tr (W * (\<sigma> \<Otimes> \<tau>)))"
  proof (intro allI impI)
    fix \<sigma> \<tau>
    assume h: "\<sigma> \<in> carrier_mat m m \<and> psd \<sigma>
                \<and> \<tau> \<in> carrier_mat p p \<and> psd \<tau>"
    have \<sigma>_c: "\<sigma> \<in> carrier_mat m m" using h by simp
    have \<sigma>_psd: "psd \<sigma>" using h by simp
    have \<tau>_c: "\<tau> \<in> carrier_mat p p" using h by simp
    have \<tau>_psd: "psd \<tau>" using h by simp
    have st_c: "\<sigma> \<Otimes> \<tau> \<in> carrier_mat (m*p) (m*p)"
      using \<sigma>_c \<tau>_c by auto
    have st_psd: "psd (\<sigma> \<Otimes> \<tau>)"
      by (rule tensor_psd[OF \<sigma>_c \<sigma>_psd \<tau>_c \<tau>_psd m_pos p_pos])
    show "0 \<le> Re (Tr (W * (\<sigma> \<Otimes> \<tau>)))"
      by (rule Re_Tr_psd_psd_nonneg[OF W_c W_psd st_c st_psd])
  qed
  show ?thesis
    unfolding entanglement_witness_def
    using W_c W_h witness_bound by blast
qed


(* ============================================================================
   DAY 28 (continued): Hard direction of Universal Entanglement Witnesses.

   PDF Section 29.1 derives the contrapositive of the easy direction
   from the closed-cone separation theorem: if the Hermitian
   matrix \<open>\<rho>\<close> is outside the closure of the separable cone, then
   there is a real-linear functional separating \<open>\<rho>\<close> from the
   cone.  The complex linear extension via \<open>X = H + iK\<close> + Riesz
   representation on the HS inner product produces a Hermitian
   witness \<open>W\<close> with \<open>Re Tr (W \<rho>) < 0\<close>.

   Below we set up the structure: predicates, lemmas, and the main
   theorem, with each non-trivial step admitted via \<open>sorry\<close>.
   Subsequent commits discharge them.
   ============================================================================ *)

(* Cone of separable PSD matrices: same shape as
   \<open>sep_decomp_valid\<close> but without the trace-1 normalisation.
   This is the closed convex cone the separation theorem operates on. *)

definition sep_cone_valid ::
  "nat \<Rightarrow> nat \<Rightarrow> (real \<times> complex Matrix.mat \<times> complex Matrix.mat) list \<Rightarrow> bool"
where
  "sep_cone_valid m p ts \<equiv>
     (\<forall>(w, \<sigma>, \<tau>) \<in> set ts.
         w \<ge> 0
         \<and> \<sigma> \<in> carrier_mat m m \<and> psd \<sigma>
         \<and> \<tau> \<in> carrier_mat p p \<and> psd \<tau>)"

definition separable_cone :: "nat \<Rightarrow> nat \<Rightarrow> complex Matrix.mat \<Rightarrow> bool" where
  "separable_cone m p \<rho> \<equiv>
     \<rho> \<in> carrier_mat (m*p) (m*p)
     \<and> (\<exists>ts. sep_cone_valid m p ts \<and> \<rho> = sep_sum m p ts)"

(* Step 1: \<open>separable_density\<close> implies \<open>separable_cone\<close> -- the
   trace-1 normalisation is one constraint on top of the cone. *)

lemma separable_density_imp_separable_cone:
  fixes m p :: nat and \<rho> :: "complex Matrix.mat"
  assumes "separable_density m p \<rho>"
      and "0 < m" and "0 < p"
  shows "separable_cone m p \<rho>"
proof -
  obtain ts where ts_v: "sep_decomp_valid m p ts"
              and \<rho>_eq: "\<rho> = sep_sum m p ts"
    using assms(1) unfolding separable_density_def by blast
  have ts_cone: "sep_cone_valid m p ts"
    using ts_v unfolding sep_decomp_valid_def sep_cone_valid_def by blast
  have \<rho>_c: "\<rho> \<in> carrier_mat (m*p) (m*p)"
    using \<rho>_eq sep_sum_carrier by simp
  show ?thesis
    unfolding separable_cone_def
    using \<rho>_c ts_cone \<rho>_eq by blast
qed

(* Step 2: every element of the separable cone is PSD. *)

lemma separable_cone_psd:
  fixes m p :: nat and \<rho> :: "complex Matrix.mat"
  assumes \<rho>_cone: "separable_cone m p \<rho>"
      and m_pos: "0 < m" and p_pos: "0 < p"
  shows "psd \<rho>"
proof -
  obtain ts where ts_v: "sep_cone_valid m p ts"
              and \<rho>_eq: "\<rho> = sep_sum m p ts"
    using \<rho>_cone unfolding separable_cone_def by blast
  have psd_sum: "psd (sep_sum m p ts)"
    if "sep_cone_valid m p ts" for ts using that
  proof (induction ts)
    case Nil
    show ?case using m_pos p_pos by simp
  next
    case (Cons t ts)
    obtain w \<sigma> \<tau> where t_eq: "t = (w, \<sigma>, \<tau>)" by (cases t)
    from Cons.prems t_eq have
      w_nn: "0 \<le> w" and
      \<sigma>_c: "\<sigma> \<in> carrier_mat m m" and \<sigma>_psd: "psd \<sigma>" and
      \<tau>_c: "\<tau> \<in> carrier_mat p p" and \<tau>_psd: "psd \<tau>"
      unfolding sep_cone_valid_def by auto
    from Cons.prems t_eq have ts_v': "sep_cone_valid m p ts"
      unfolding sep_cone_valid_def by auto
    have st_psd: "psd (\<sigma> \<Otimes> \<tau>)"
      by (rule tensor_psd[OF \<sigma>_c \<sigma>_psd \<tau>_c \<tau>_psd m_pos p_pos])
    have st_c: "\<sigma> \<Otimes> \<tau> \<in> carrier_mat (m*p) (m*p)"
      using \<sigma>_c \<tau>_c by auto
    have wstm_psd: "psd (complex_of_real w \<cdot>\<^sub>m (\<sigma> \<Otimes> \<tau>))"
      by (rule psd_smult_nonneg[OF w_nn st_psd st_c])
    have wstm_c: "complex_of_real w \<cdot>\<^sub>m (\<sigma> \<Otimes> \<tau>) \<in> carrier_mat (m*p) (m*p)"
      using st_c by auto
    have IH_psd: "psd (sep_sum m p ts)"
      using Cons.IH ts_v' by blast
    have IH_c: "sep_sum m p ts \<in> carrier_mat (m*p) (m*p)"
      using sep_sum_carrier by simp
    have "psd (complex_of_real w \<cdot>\<^sub>m (\<sigma> \<Otimes> \<tau>) + sep_sum m p ts)"
      using wstm_psd IH_psd wstm_c IH_c by (rule psd_add_psd)
    thus ?case using t_eq by simp
  qed
  show "psd \<rho>" using \<rho>_eq psd_sum[OF ts_v] by simp
qed

(* Step 3: separable_density implies psd (corollary of steps 1, 2). *)

lemma separable_density_psd:
  fixes m p :: nat and \<rho> :: "complex Matrix.mat"
  assumes "separable_density m p \<rho>"
      and "0 < m" and "0 < p"
  shows "psd \<rho>"
  using separable_density_imp_separable_cone[OF assms]
        separable_cone_psd[OF _ assms(2,3)]
  by blast

(* Step 4: closure under non-negative scaling and addition. *)

lemma sep_sum_smult:
  fixes m p :: nat and c :: real
      and ts :: "(real \<times> complex Matrix.mat \<times> complex Matrix.mat) list"
  assumes "sep_cone_valid m p ts"
  shows "complex_of_real c \<cdot>\<^sub>m sep_sum m p ts
         = sep_sum m p (map (\<lambda>(w,\<sigma>,\<tau>). (c * w, \<sigma>, \<tau>)) ts)"
  using assms
proof (induction ts)
  case Nil
  have z_c: "(0\<^sub>m (m*p) (m*p) :: complex Matrix.mat) \<in> carrier_mat (m*p) (m*p)"
    by simp
  show ?case by (intro eq_matI) (auto simp: zero_mat_def)
next
  case (Cons t ts)
  obtain w \<sigma> \<tau> where t_eq: "t = (w, \<sigma>, \<tau>)" by (cases t)
  from Cons.prems t_eq have \<sigma>_c: "\<sigma> \<in> carrier_mat m m"
                       and \<tau>_c: "\<tau> \<in> carrier_mat p p"
    unfolding sep_cone_valid_def by auto
  from Cons.prems t_eq have ts_v: "sep_cone_valid m p ts"
    unfolding sep_cone_valid_def by auto
  have st_c: "\<sigma> \<Otimes> \<tau> \<in> carrier_mat (m*p) (m*p)"
    using \<sigma>_c \<tau>_c by auto
  let ?S = "complex_of_real w \<cdot>\<^sub>m (\<sigma> \<Otimes> \<tau>)"
  let ?R = "sep_sum m p ts"
  have S_c: "?S \<in> carrier_mat (m*p) (m*p)" using st_c by auto
  have R_c: "?R \<in> carrier_mat (m*p) (m*p)" by (rule sep_sum_carrier)
  have "complex_of_real c \<cdot>\<^sub>m sep_sum m p ((w, \<sigma>, \<tau>) # ts)
        = complex_of_real c \<cdot>\<^sub>m (?S + ?R)" by simp
  also have "\<dots> = complex_of_real c \<cdot>\<^sub>m ?S + complex_of_real c \<cdot>\<^sub>m ?R"
    by (rule add_smult_distrib_left_mat[OF S_c R_c])
  also have "complex_of_real c \<cdot>\<^sub>m ?S
              = complex_of_real (c * w) \<cdot>\<^sub>m (\<sigma> \<Otimes> \<tau>)"
    by (intro eq_matI) (auto simp: ac_simps)
  also have "complex_of_real c \<cdot>\<^sub>m ?R
              = sep_sum m p (map (\<lambda>(w,\<sigma>,\<tau>). (c * w, \<sigma>, \<tau>)) ts)"
    using Cons.IH ts_v by blast
  finally show ?case by (simp add: t_eq)
qed

lemma separable_cone_smult:
  fixes m p :: nat and \<rho> :: "complex Matrix.mat" and c :: real
  assumes \<rho>_cone: "separable_cone m p \<rho>" and c_nn: "0 \<le> c"
      and m_pos: "0 < m" and p_pos: "0 < p"
  shows "separable_cone m p (complex_of_real c \<cdot>\<^sub>m \<rho>)"
proof -
  obtain ts where ts_v: "sep_cone_valid m p ts"
              and \<rho>_eq: "\<rho> = sep_sum m p ts"
              and \<rho>_c: "\<rho> \<in> carrier_mat (m*p) (m*p)"
    using \<rho>_cone unfolding separable_cone_def by blast
  let ?ts' = "map (\<lambda>(w,\<sigma>,\<tau>). (c * w, \<sigma>, \<tau>)) ts"
  have ts'_v: "sep_cone_valid m p ?ts'"
    using ts_v c_nn unfolding sep_cone_valid_def
    by (force simp: case_prod_beta mult_nonneg_nonneg)
  have eq: "complex_of_real c \<cdot>\<^sub>m \<rho> = sep_sum m p ?ts'"
    using \<rho>_eq sep_sum_smult[OF ts_v] by simp
  have c_carr: "complex_of_real c \<cdot>\<^sub>m \<rho> \<in> carrier_mat (m*p) (m*p)"
    using \<rho>_c by auto
  show ?thesis
    unfolding separable_cone_def using c_carr ts'_v eq by blast
qed

lemma sep_sum_append:
  fixes m p :: nat
      and ts\<^sub>1 ts\<^sub>2 :: "(real \<times> complex Matrix.mat \<times> complex Matrix.mat) list"
  assumes "sep_cone_valid m p ts\<^sub>1"
  shows "sep_sum m p (ts\<^sub>1 @ ts\<^sub>2)
         = sep_sum m p ts\<^sub>1 + sep_sum m p ts\<^sub>2"
  using assms
proof (induction ts\<^sub>1)
  case Nil
  have R\<^sub>2_c: "sep_sum m p ts\<^sub>2 \<in> carrier_mat (m*p) (m*p)"
    by (rule sep_sum_carrier)
  show ?case using R\<^sub>2_c by (intro eq_matI) auto
next
  case (Cons t ts)
  obtain w \<sigma> \<tau> where t_eq: "t = (w, \<sigma>, \<tau>)" by (cases t)
  from Cons.prems t_eq have \<sigma>_c: "\<sigma> \<in> carrier_mat m m"
                       and \<tau>_c: "\<tau> \<in> carrier_mat p p"
    unfolding sep_cone_valid_def by auto
  from Cons.prems t_eq have ts_v: "sep_cone_valid m p ts"
    unfolding sep_cone_valid_def by auto
  have st_c: "\<sigma> \<Otimes> \<tau> \<in> carrier_mat (m*p) (m*p)"
    using \<sigma>_c \<tau>_c by auto
  let ?S = "complex_of_real w \<cdot>\<^sub>m (\<sigma> \<Otimes> \<tau>)"
  let ?R\<^sub>1 = "sep_sum m p ts"
  let ?R\<^sub>2 = "sep_sum m p ts\<^sub>2"
  have S_c: "?S \<in> carrier_mat (m*p) (m*p)" using st_c by auto
  have R\<^sub>1_c: "?R\<^sub>1 \<in> carrier_mat (m*p) (m*p)" by (rule sep_sum_carrier)
  have R\<^sub>2_c: "?R\<^sub>2 \<in> carrier_mat (m*p) (m*p)" by (rule sep_sum_carrier)
  have "sep_sum m p (((w, \<sigma>, \<tau>) # ts) @ ts\<^sub>2)
        = ?S + sep_sum m p (ts @ ts\<^sub>2)" by simp
  also have "\<dots> = ?S + (?R\<^sub>1 + ?R\<^sub>2)"
    using Cons.IH ts_v by simp
  also have "\<dots> = (?S + ?R\<^sub>1) + ?R\<^sub>2"
    by (rule assoc_add_mat[OF S_c R\<^sub>1_c R\<^sub>2_c, symmetric])
  also have "\<dots> = sep_sum m p ((w, \<sigma>, \<tau>) # ts) + ?R\<^sub>2" by simp
  finally show ?case by (simp add: t_eq)
qed

lemma separable_cone_add:
  fixes m p :: nat and \<rho>\<^sub>1 \<rho>\<^sub>2 :: "complex Matrix.mat"
  assumes \<rho>\<^sub>1_cone: "separable_cone m p \<rho>\<^sub>1"
      and \<rho>\<^sub>2_cone: "separable_cone m p \<rho>\<^sub>2"
  shows "separable_cone m p (\<rho>\<^sub>1 + \<rho>\<^sub>2)"
proof -
  obtain ts\<^sub>1 where ts\<^sub>1_v: "sep_cone_valid m p ts\<^sub>1"
               and \<rho>\<^sub>1_eq: "\<rho>\<^sub>1 = sep_sum m p ts\<^sub>1"
               and \<rho>\<^sub>1_c: "\<rho>\<^sub>1 \<in> carrier_mat (m*p) (m*p)"
    using \<rho>\<^sub>1_cone unfolding separable_cone_def by blast
  obtain ts\<^sub>2 where ts\<^sub>2_v: "sep_cone_valid m p ts\<^sub>2"
               and \<rho>\<^sub>2_eq: "\<rho>\<^sub>2 = sep_sum m p ts\<^sub>2"
               and \<rho>\<^sub>2_c: "\<rho>\<^sub>2 \<in> carrier_mat (m*p) (m*p)"
    using \<rho>\<^sub>2_cone unfolding separable_cone_def by blast
  let ?ts = "ts\<^sub>1 @ ts\<^sub>2"
  have ts_v: "sep_cone_valid m p ?ts"
    using ts\<^sub>1_v ts\<^sub>2_v unfolding sep_cone_valid_def by auto
  have eq: "\<rho>\<^sub>1 + \<rho>\<^sub>2 = sep_sum m p ?ts"
    using \<rho>\<^sub>1_eq \<rho>\<^sub>2_eq sep_sum_append[OF ts\<^sub>1_v] by simp
  have c_carr: "\<rho>\<^sub>1 + \<rho>\<^sub>2 \<in> carrier_mat (m*p) (m*p)"
    using \<rho>\<^sub>1_c \<rho>\<^sub>2_c by simp
  show ?thesis
    unfolding separable_cone_def using c_carr ts_v eq by blast
qed

(* Step 5: closed-cone separation in finite-dim Hilbert space.
   This is the geometric Hahn-Banach used by PDF Section 29.1.
   Given \<open>\<rho>\<close> Hermitian and outside the (closed) separable cone,
   there is a Hermitian \<open>W\<close> with \<open>Re Tr (W \<sigma>) \<ge> 0\<close> for every
   \<open>\<sigma>\<close> in the cone and \<open>Re Tr (W \<rho>) < 0\<close>.

   We split the proof into structural sub-lemmas:
     5a. \<open>separable_cone\<close> contains 0 (cone basepoint).
     5b. \<open>separable_cone\<close> is convex.
     5c. \<open>separable_cone\<close> is closed in HS-norm topology
         (the heavy compactness step).
     5d. closed convex set + external point \<Rightarrow> closest point exists.
     5e. closest-point geometry gives a separating element \<open>a\<close>.
     5f. for cones the threshold collapses to 0:
         \<open>0 \<le> Re \<langle>\<langle>a|\<sigma>\<rangle>\<rangle>\<close> for all \<sigma> in cone.
     5g. taking the Hermitian part of \<open>a\<close> preserves \<open>Re Tr (\<cdot> \<sigma>)\<close>
         on hermitian \<sigma>; the resulting \<open>W\<close> is the witness. *)

(* Step 5a: zero matrix is in the separable cone. *)

lemma separable_cone_zero:
  fixes m p :: nat
  shows "separable_cone m p (0\<^sub>m (m*p) (m*p))"
proof -
  have eq: "(0\<^sub>m (m*p) (m*p) :: complex Matrix.mat) = sep_sum m p []"
    by simp
  have v: "sep_cone_valid m p []"
    unfolding sep_cone_valid_def by simp
  have c: "(0\<^sub>m (m*p) (m*p) :: complex Matrix.mat) \<in> carrier_mat (m*p) (m*p)"
    by simp
  show ?thesis
    unfolding separable_cone_def using c v eq by blast
qed

(* Step 5b: separable cone is convex. (Convex combination of cone
   elements is in the cone.) *)

lemma separable_cone_convex:
  fixes \<sigma>\<^sub>1 \<sigma>\<^sub>2 :: "complex Matrix.mat" and t :: real
  assumes \<sigma>\<^sub>1_cone: "separable_cone m p \<sigma>\<^sub>1"
      and \<sigma>\<^sub>2_cone: "separable_cone m p \<sigma>\<^sub>2"
      and t_nn: "0 \<le> t" and t_le: "t \<le> 1"
      and m_pos: "0 < m" and p_pos: "0 < p"
  shows "separable_cone m p
           (complex_of_real t \<cdot>\<^sub>m \<sigma>\<^sub>1 + complex_of_real (1 - t) \<cdot>\<^sub>m \<sigma>\<^sub>2)"
proof -
  have one_t_nn: "0 \<le> 1 - t" using t_le by simp
  have part1: "separable_cone m p (complex_of_real t \<cdot>\<^sub>m \<sigma>\<^sub>1)"
    by (rule separable_cone_smult[OF \<sigma>\<^sub>1_cone t_nn m_pos p_pos])
  have part2: "separable_cone m p (complex_of_real (1 - t) \<cdot>\<^sub>m \<sigma>\<^sub>2)"
    by (rule separable_cone_smult[OF \<sigma>\<^sub>2_cone one_t_nn m_pos p_pos])
  show ?thesis by (rule separable_cone_add[OF part1 part2])
qed

(* Step 5c: separable cone is closed in HS-norm topology.
   This is the heart of the geometric argument: the cone equals the
   conical hull of the compact set \<open>{\<sigma>\<otimes>\<tau> : \<sigma>\<in>DM_m, \<tau>\<in>DM_p}\<close>, and
   the conical hull of a compact set not containing 0 is closed.
   Pending full embedding into a HOL-Analysis Euclidean space. *)

(* The closedness of separable_cone in HS-norm topology.

   The standard finite-dim argument:
   1. Any \<rho>\<^sub>n in cone equals \<open>\<Sum>i w\<^sub>i \<sigma>\<^sub>i \<otimes> \<tau>\<^sub>i\<close> with weights and
      PSD factors satisfying typing constraints.
   2. By Carath\<eacute>odory's theorem the number of terms can be
      uniformly bounded by \<open>(m*p)\<^sup>2 + 1\<close>.
   3. By unit-trace normalisation (Step 8 in the cone\<rightarrow>density
      conversion) the factors live in compact PSD-density slices.
   4. Bolzano\<endash>Weierstrass: extract convergent subsequences in
      each coordinate.
   5. Tensor and addition are HS-continuous; the limit reconstructs
      \<open>\<rho>\<close> as a separable_cone element.

   The full proof requires substantial Carath\<eacute>odory + compactness
   infrastructure.  Pending; statement preserved as the single deep
   sorry blocking nonseparable_implies_witness. *)

lemma separable_cone_HS_closed:
  fixes m p :: nat
  assumes m_pos: "0 < m" and p_pos: "0 < p"
  shows "\<forall>(\<rho>\<^sub>n :: nat \<Rightarrow> complex Matrix.mat) \<rho>.
            (\<forall>n. separable_cone m p (\<rho>\<^sub>n n))
            \<and> \<rho> \<in> carrier_mat (m*p) (m*p)
            \<and> (\<lambda>n. hs_norm (\<rho>\<^sub>n n - \<rho>)) \<longlonglongrightarrow> 0
          \<longrightarrow> separable_cone m p \<rho>"
  sorry

(* Step 5d: in a closed convex subset of finite-dim matrix space,
   a closest point to any external matrix exists.

   This uses HS-norm completeness of matrix space and the convex
   parallelogram argument: the minimising sequence is HS-Cauchy. *)

(* The lemma exists_closest_point_in_separable_cone is proved in
   exists_closest_point_in_separable_cone_assembly later in this
   block, after the supporting helpers (cone_dist_minimizing_sequence,
   minimizing_sequence_HS_Cauchy, HS_Cauchy_imp_convergent). The
   assembled version is wrapped here for forward reference. *)

(* Sub-helper for closest-point existence: the infimum
   \<open>D = \<sqinter> {hs_norm (\<rho>-q) | q \<in> cone}\<close> is well-defined and \<ge> 0,
   and there is an approximating sequence \<open>q\<^sub>n\<close> in the cone whose
   distances to \<rho> tend to \<open>D\<close>.

   These are pure real-analysis facts not using closedness. *)

definition cone_dist_set ::
    "nat \<Rightarrow> nat \<Rightarrow> complex Matrix.mat \<Rightarrow> real set" where
  "cone_dist_set m p \<rho> = {hs_norm (\<rho> - q) | q. separable_cone m p q}"

lemma cone_dist_set_nonempty:
  "cone_dist_set m p \<rho> \<noteq> {}"
proof -
  have "hs_norm (\<rho> - 0\<^sub>m (m*p) (m*p)) \<in> cone_dist_set m p \<rho>"
    unfolding cone_dist_set_def
    using separable_cone_zero by blast
  thus ?thesis by auto
qed

lemma cone_dist_set_bdd_below:
  "bdd_below (cone_dist_set m p \<rho>)"
  unfolding cone_dist_set_def bdd_below_def
  by (rule_tac x=0 in exI) (auto simp: hs_norm_nonneg)

lemma cone_dist_set_inf_nonneg:
  "0 \<le> Inf (cone_dist_set m p \<rho>)"
proof (rule cInf_greatest)
  show "cone_dist_set m p \<rho> \<noteq> {}" by (rule cone_dist_set_nonempty)
  fix x assume "x \<in> cone_dist_set m p \<rho>"
  thus "0 \<le> x"
    unfolding cone_dist_set_def by (auto simp: hs_norm_nonneg)
qed

lemma cone_dist_approximator:
  fixes \<epsilon> :: real
  assumes "0 < \<epsilon>"
  shows "\<exists>q. separable_cone m p q
            \<and> hs_norm (\<rho> - q) < Inf (cone_dist_set m p \<rho>) + \<epsilon>"
proof -
  let ?D = "Inf (cone_dist_set m p \<rho>)"
  have ne: "cone_dist_set m p \<rho> \<noteq> {}" by (rule cone_dist_set_nonempty)
  have bd: "bdd_below (cone_dist_set m p \<rho>)" by (rule cone_dist_set_bdd_below)
  obtain x where x_in: "x \<in> cone_dist_set m p \<rho>"
             and x_lt: "x < ?D + \<epsilon>"
    using cInf_lessD[OF ne, of "?D + \<epsilon>"] assms by auto
  from x_in obtain q where q_cone: "separable_cone m p q"
                       and x_eq: "x = hs_norm (\<rho> - q)"
    unfolding cone_dist_set_def by auto
  show ?thesis using q_cone x_eq x_lt by auto
qed

(* Approximating-minimizer sequence whose distances to \<rho> tend to \<open>D\<close>. *)

lemma cone_dist_minimizing_sequence:
  shows "\<exists>q\<^sub>n :: nat \<Rightarrow> complex Matrix.mat.
           (\<forall>n. separable_cone m p (q\<^sub>n n))
           \<and> (\<forall>n. hs_norm (\<rho> - q\<^sub>n n)
                   < Inf (cone_dist_set m p \<rho>) + 1 / (real n + 1))"
proof -
  have step: "\<And>n :: nat. \<exists>q. separable_cone m p q
                              \<and> hs_norm (\<rho> - q)
                                  < Inf (cone_dist_set m p \<rho>)
                                    + 1 / (real n + 1)"
  proof -
    fix n :: nat
    have eps_pos: "0 < (1 :: real) / (real n + 1)" by simp
    show "\<exists>q. separable_cone m p q
                \<and> hs_norm (\<rho> - q) < Inf (cone_dist_set m p \<rho>)
                                      + 1 / (real n + 1)"
      by (rule cone_dist_approximator[OF eps_pos])
  qed
  show ?thesis
    using step by metis
qed


(* Step 5e: given a closest point p_star \<in> cone to external point \<rho>,
   the matrix \<open>p_star - \<rho>\<close> separates: \<open>Re \<langle>\<langle>p_star-\<rho> | \<sigma>\<rangle>\<rangle> \<ge> Re \<langle>\<langle>p_star-\<rho> | p_star\<rangle>\<rangle>\<close>
   for all \<sigma> in the (closed convex) cone, and the value at \<rho> is
   strictly smaller (by \<open>\<parallel>p_star-\<rho>\<parallel>\<^sup>2\<close>). *)

(* Helper: HS-self inner product is real, so equals of_real of its Re. *)

lemma hs_inner_prod_self_eq_of_real:
  "\<langle>\<langle> A | A \<rangle>\<rangle> = complex_of_real (Re (\<langle>\<langle> A | A \<rangle>\<rangle>))"
  using hs_inner_prod_self_real complex_eq_iff
  by (metis Reals_cases of_real_Re)

(* Helper: HS-self inner product equals zero iff the matrix is zero. *)

lemma hs_inner_prod_self_zero_iff:
  fixes A :: "complex Matrix.mat"
  shows "\<langle>\<langle> A | A \<rangle>\<rangle> = 0 \<longleftrightarrow> A = 0\<^sub>m (dim_row A) (dim_col A)"
proof
  assume h: "\<langle>\<langle> A | A \<rangle>\<rangle> = 0"
  have entries_zero: "\<And>i j. i < dim_row A \<Longrightarrow> j < dim_col A
                            \<Longrightarrow> A $$ (i,j) = 0"
    using hs_inner_prod_eq_zero_imp[OF h] by simp
  show "A = 0\<^sub>m (dim_row A) (dim_col A)"
    by (intro eq_matI) (auto simp: entries_zero)
next
  assume eq: "A = 0\<^sub>m (dim_row A) (dim_col A)"
  have entries_zero:
    "\<And>i j. i < dim_row A \<Longrightarrow> j < dim_col A \<Longrightarrow> A $$ (i,j) = 0"
  proof -
    fix i j assume i: "i < dim_row A" and j: "j < dim_col A"
    have "A $$ (i,j) = (0\<^sub>m (dim_row A) (dim_col A)) $$ (i,j)"
      using eq by simp
    also have "\<dots> = 0" using i j by simp
    finally show "A $$ (i,j) = 0" .
  qed
  show "\<langle>\<langle> A | A \<rangle>\<rangle> = 0"
    unfolding hs_inner_prod_def
    by (intro sum.neutral ballI) (simp add: entries_zero)
qed

(* Helper: Re of HS inner product is bilinear over real-scaled matrices. *)

lemma Re_hs_inner_prod_right_smult_real:
  fixes A B :: "complex Matrix.mat" and t :: real
  assumes "dim_row A = dim_row B" and "dim_col A = dim_col B"
  shows "Re (\<langle>\<langle> A | complex_of_real t \<cdot>\<^sub>m B \<rangle>\<rangle>) = t * Re (\<langle>\<langle> A | B \<rangle>\<rangle>)"
proof -
  have d1: "dim_row B = dim_row A" using assms by simp
  have d2: "dim_col B = dim_col A" using assms by simp
  have "\<langle>\<langle> A | complex_of_real t \<cdot>\<^sub>m B \<rangle>\<rangle> = complex_of_real t * \<langle>\<langle> A | B \<rangle>\<rangle>"
    by (rule hs_inner_prod_right_smult[OF d1 d2])
  thus ?thesis by simp
qed

(* Helper: Re of HS inner product, conjugate symmetry. *)

lemma Re_hs_inner_prod_swap:
  fixes A B :: "complex Matrix.mat"
  assumes "dim_row A = dim_row B" and "dim_col A = dim_col B"
  shows "Re (\<langle>\<langle> A | B \<rangle>\<rangle>) = Re (\<langle>\<langle> B | A \<rangle>\<rangle>)"
proof -
  have "\<langle>\<langle> A | B \<rangle>\<rangle> = cnj (\<langle>\<langle> B | A \<rangle>\<rangle>)"
    by (rule hs_inner_prod_cnj[OF assms])
  thus ?thesis by simp
qed

(* Helper: HS-norm-squared of \<open>U + (-t) ⋅ V\<close> expanded over the
   bilinear structure.  We extract this into a stand-alone lemma so
   the lemma's parameter names do not clash with let-bound names in
   the calling context. *)

lemma hs_norm_sq_diff_expand:
  fixes U V :: "complex Matrix.mat" and t :: real
  assumes U_c: "U \<in> carrier_mat n n"
      and V_c: "V \<in> carrier_mat n n"
  shows "(hs_norm (U + complex_of_real (-t) \<cdot>\<^sub>m V))\<^sup>2
          = Re (\<langle>\<langle> U | U \<rangle>\<rangle>) - 2 * t * Re (\<langle>\<langle> U | V \<rangle>\<rangle>)
            + t\<^sup>2 * Re (\<langle>\<langle> V | V \<rangle>\<rangle>)"
proof -
  let ?tV = "complex_of_real (-t) \<cdot>\<^sub>m V"
  let ?Z = "U + ?tV"
  have tV_c: "?tV \<in> carrier_mat n n" using V_c by auto
  have Z_c: "?Z \<in> carrier_mat n n" using U_c tV_c by auto
  have U_dr: "dim_row U = n" using U_c by auto
  have U_dc: "dim_col U = n" using U_c by auto
  have V_dr: "dim_row V = n" using V_c by auto
  have V_dc: "dim_col V = n" using V_c by auto
  have tV_dr: "dim_row ?tV = n" using tV_c by auto
  have tV_dc: "dim_col ?tV = n" using tV_c by auto
  have Z_dr: "dim_row ?Z = n" using Z_c by auto
  have Z_dc: "dim_col ?Z = n" using Z_c by auto
  have ZZ_split: "\<langle>\<langle> ?Z | ?Z \<rangle>\<rangle> = \<langle>\<langle> U | ?Z \<rangle>\<rangle> + \<langle>\<langle> ?tV | ?Z \<rangle>\<rangle>"
  proof -
    have d1: "dim_row ?Z = dim_row U" using Z_dr U_dr by simp
    have d2: "dim_col ?Z = dim_col U" using Z_dc U_dc by simp
    have d1': "dim_row ?Z = dim_row ?tV" using Z_dr tV_dr by simp
    have d2': "dim_col ?Z = dim_col ?tV" using Z_dc tV_dc by simp
    text \<open>Use conjugate-symmetric form to avoid an OF-unification clash
    on the schematic left-add lemma.\<close>
    have step1: "\<langle>\<langle> ?Z | ?Z \<rangle>\<rangle> = cnj (\<langle>\<langle> ?Z | ?Z \<rangle>\<rangle>)"
      by (rule hs_inner_prod_cnj[OF refl refl])
    have rhs_split: "\<langle>\<langle> ?Z | U + ?tV \<rangle>\<rangle>
                       = \<langle>\<langle> ?Z | U \<rangle>\<rangle> + \<langle>\<langle> ?Z | ?tV \<rangle>\<rangle>"
      by (rule hs_inner_prod_right_add)
         (use Z_dr Z_dc U_dr U_dc tV_dr tV_dc in auto)
    have ZZ_eq: "?Z = U + ?tV" by simp
    have IP1: "\<langle>\<langle> ?Z | ?Z \<rangle>\<rangle>
                  = \<langle>\<langle> ?Z | U \<rangle>\<rangle> + \<langle>\<langle> ?Z | ?tV \<rangle>\<rangle>"
      using rhs_split ZZ_eq by simp
    text \<open>Now transpose each \<open>\<langle>\<langle>?Z|x\<rangle>\<rangle>\<close> via conjugate symmetry.\<close>
    have e1: "\<langle>\<langle> ?Z | U \<rangle>\<rangle> = cnj (\<langle>\<langle> U | ?Z \<rangle>\<rangle>)"
      by (rule hs_inner_prod_cnj) (use U_dr U_dc Z_dr Z_dc in auto)
    have e2: "\<langle>\<langle> ?Z | ?tV \<rangle>\<rangle> = cnj (\<langle>\<langle> ?tV | ?Z \<rangle>\<rangle>)"
      by (rule hs_inner_prod_cnj) (use tV_dr tV_dc Z_dr Z_dc in auto)
    text \<open>Self-IP is real, so its conjugate equals itself.\<close>
    have ZZ_real: "\<langle>\<langle> ?Z | ?Z \<rangle>\<rangle> = cnj (\<langle>\<langle> ?Z | ?Z \<rangle>\<rangle>)"
      using hs_inner_prod_self_real by (metis Reals_cnj_iff)
    have "\<langle>\<langle> ?Z | ?Z \<rangle>\<rangle> = cnj (\<langle>\<langle> ?Z | ?Z \<rangle>\<rangle>)" by (rule ZZ_real)
    also have "cnj (\<langle>\<langle> ?Z | ?Z \<rangle>\<rangle>)
                = cnj (\<langle>\<langle> ?Z | U \<rangle>\<rangle> + \<langle>\<langle> ?Z | ?tV \<rangle>\<rangle>)"
      using IP1 by simp
    also have "\<dots> = cnj (\<langle>\<langle> ?Z | U \<rangle>\<rangle>) + cnj (\<langle>\<langle> ?Z | ?tV \<rangle>\<rangle>)"
      by simp
    also have "\<dots> = cnj (cnj (\<langle>\<langle> U | ?Z \<rangle>\<rangle>))
                    + cnj (cnj (\<langle>\<langle> ?tV | ?Z \<rangle>\<rangle>))"
      using e1 e2 by simp
    also have "\<dots> = \<langle>\<langle> U | ?Z \<rangle>\<rangle> + \<langle>\<langle> ?tV | ?Z \<rangle>\<rangle>"
      by simp
    finally show ?thesis .
  qed
  have UZ_split: "\<langle>\<langle> U | ?Z \<rangle>\<rangle> = \<langle>\<langle> U | U \<rangle>\<rangle> + \<langle>\<langle> U | ?tV \<rangle>\<rangle>"
    by (rule hs_inner_prod_right_add)
       (use U_dr U_dc tV_dr tV_dc in auto)
  have tVZ_split: "\<langle>\<langle> ?tV | ?Z \<rangle>\<rangle>
                    = \<langle>\<langle> ?tV | U \<rangle>\<rangle> + \<langle>\<langle> ?tV | ?tV \<rangle>\<rangle>"
    by (rule hs_inner_prod_right_add)
       (use U_dr U_dc tV_dr tV_dc in auto)
  have UtV_smult: "\<langle>\<langle> U | ?tV \<rangle>\<rangle>
                    = complex_of_real (-t) * \<langle>\<langle> U | V \<rangle>\<rangle>"
    by (rule hs_inner_prod_right_smult)
       (use U_dr U_dc V_dr V_dc in auto)
  have tVU_smult: "\<langle>\<langle> ?tV | U \<rangle>\<rangle>
                    = cnj (complex_of_real (-t)) * \<langle>\<langle> V | U \<rangle>\<rangle>"
    by (rule hs_inner_prod_left_smult)
       (use U_dr U_dc V_dr V_dc in auto)
  have tVtV_smult: "\<langle>\<langle> ?tV | ?tV \<rangle>\<rangle>
                     = cnj (complex_of_real (-t)) * \<langle>\<langle> V | ?tV \<rangle>\<rangle>"
    by (rule hs_inner_prod_left_smult)
       (use V_dr V_dc tV_dr tV_dc in auto)
  have VtV_smult: "\<langle>\<langle> V | ?tV \<rangle>\<rangle>
                    = complex_of_real (-t) * \<langle>\<langle> V | V \<rangle>\<rangle>"
    by (rule hs_inner_prod_right_smult)
       (use V_dr V_dc in auto)
  have full:
    "\<langle>\<langle> ?Z | ?Z \<rangle>\<rangle>
       = \<langle>\<langle> U | U \<rangle>\<rangle>
         + complex_of_real (-t) * \<langle>\<langle> U | V \<rangle>\<rangle>
         + (cnj (complex_of_real (-t)) * \<langle>\<langle> V | U \<rangle>\<rangle>
             + cnj (complex_of_real (-t))
                 * (complex_of_real (-t) * \<langle>\<langle> V | V \<rangle>\<rangle>))"
    using ZZ_split UZ_split tVZ_split
          UtV_smult tVU_smult tVtV_smult VtV_smult
    by simp
  have re_eq:
    "Re (\<langle>\<langle> ?Z | ?Z \<rangle>\<rangle>)
        = Re (\<langle>\<langle> U | U \<rangle>\<rangle>)
          - t * Re (\<langle>\<langle> U | V \<rangle>\<rangle>)
          - t * Re (\<langle>\<langle> V | U \<rangle>\<rangle>)
          + t\<^sup>2 * Re (\<langle>\<langle> V | V \<rangle>\<rangle>)"
    using full by (simp add: power2_eq_square)
  have swap: "Re (\<langle>\<langle> V | U \<rangle>\<rangle>) = Re (\<langle>\<langle> U | V \<rangle>\<rangle>)"
  proof -
    have d1: "dim_row V = dim_row U" using V_dr U_dr by simp
    have d2: "dim_col V = dim_col U" using V_dc U_dc by simp
    have "\<langle>\<langle> V | U \<rangle>\<rangle> = cnj (\<langle>\<langle> U | V \<rangle>\<rangle>)"
      by (rule hs_inner_prod_cnj[OF d1 d2])
    thus ?thesis by simp
  qed
  have "(hs_norm ?Z)\<^sup>2 = Re (\<langle>\<langle> ?Z | ?Z \<rangle>\<rangle>)" by (rule hs_norm_sq)
  thus ?thesis using re_eq swap by simp
qed

(* Helper: HS norm satisfies the parallelogram identity. *)

lemma hs_norm_parallelogram:
  fixes U V :: "complex Matrix.mat"
  assumes U_c: "U \<in> carrier_mat n n"
      and V_c: "V \<in> carrier_mat n n"
  shows "(hs_norm (U + V))\<^sup>2 + (hs_norm (U - V))\<^sup>2
          = 2 * (hs_norm U)\<^sup>2 + 2 * (hs_norm V)\<^sup>2"
proof -
  have minus_eq: "U + complex_of_real (-1) \<cdot>\<^sub>m V = U - V"
    using U_c V_c
    by (intro eq_matI) (auto simp: minus_mat_def uminus_mat_def)
  have plus_eq: "U + complex_of_real (-(-1)) \<cdot>\<^sub>m V = U + V"
    using U_c V_c by (intro eq_matI) auto
  have neg_one_expand:
    "(hs_norm (U + complex_of_real (-1) \<cdot>\<^sub>m V))\<^sup>2
       = Re (\<langle>\<langle> U | U \<rangle>\<rangle>) - 2 * 1 * Re (\<langle>\<langle> U | V \<rangle>\<rangle>)
         + 1\<^sup>2 * Re (\<langle>\<langle> V | V \<rangle>\<rangle>)"
    by (rule hs_norm_sq_diff_expand[OF U_c V_c])
  have pos_one_expand:
    "(hs_norm (U + complex_of_real (-(-1)) \<cdot>\<^sub>m V))\<^sup>2
       = Re (\<langle>\<langle> U | U \<rangle>\<rangle>) - 2 * (-1) * Re (\<langle>\<langle> U | V \<rangle>\<rangle>)
         + (-1)\<^sup>2 * Re (\<langle>\<langle> V | V \<rangle>\<rangle>)"
    by (rule hs_norm_sq_diff_expand[OF U_c V_c])
  have UU_eq: "Re (\<langle>\<langle> U | U \<rangle>\<rangle>) = (hs_norm U)\<^sup>2" by (simp add: hs_norm_sq)
  have VV_eq: "Re (\<langle>\<langle> V | V \<rangle>\<rangle>) = (hs_norm V)\<^sup>2" by (simp add: hs_norm_sq)
  have minus_norm: "(hs_norm (U - V))\<^sup>2
                      = (hs_norm U)\<^sup>2 - 2 * Re (\<langle>\<langle> U | V \<rangle>\<rangle>) + (hs_norm V)\<^sup>2"
    using neg_one_expand minus_eq UU_eq VV_eq by simp
  have plus_norm: "(hs_norm (U + V))\<^sup>2
                     = (hs_norm U)\<^sup>2 + 2 * Re (\<langle>\<langle> U | V \<rangle>\<rangle>) + (hs_norm V)\<^sup>2"
    using pos_one_expand plus_eq UU_eq VV_eq by simp
  show ?thesis using minus_norm plus_norm by simp
qed

(* Helper: every entry's modulus squared is bounded by HS norm squared. *)

lemma cmod_entry_sq_le_hs_norm_sq:
  fixes A :: "complex Matrix.mat" and i j :: nat
  assumes A_c: "A \<in> carrier_mat n n"
      and i_lt: "i < n" and j_lt: "j < n"
  shows "(cmod (A $$ (i,j)))\<^sup>2 \<le> (hs_norm A)\<^sup>2"
proof -
  have dr: "dim_row A = n" using A_c by auto
  have dc: "dim_col A = n" using A_c by auto
  let ?term = "\<lambda>i' j'. (cmod (A $$ (i',j')))\<^sup>2"
  have entry_re:
    "\<And>i' j'. Re (cnj (A $$ (i',j')) * A $$ (i',j')) = ?term i' j'"
  proof -
    fix i' j'
    let ?z = "A $$ (i',j')"
    have eq1: "cnj ?z * ?z = ?z * cnj ?z" by (simp add: mult.commute)
    have eq2: "?z * cnj ?z = complex_of_real ((cmod ?z)\<^sup>2)"
      using complex_norm_square[of ?z, symmetric] by simp
    have eq3: "Re (complex_of_real ((cmod ?z)\<^sup>2)) = (cmod ?z)\<^sup>2" by simp
    show "Re (cnj ?z * ?z) = (cmod ?z)\<^sup>2"
      using eq1 eq2 eq3 by simp
  qed
  have hs_eq: "(hs_norm A)\<^sup>2
                 = (\<Sum>i'\<in>{0..<n}. \<Sum>j'\<in>{0..<n}. ?term i' j')"
  proof -
    have step1: "(hs_norm A)\<^sup>2 = Re (\<langle>\<langle> A | A \<rangle>\<rangle>)" by (rule hs_norm_sq)
    have step2: "Re (\<langle>\<langle> A | A \<rangle>\<rangle>)
                  = Re (\<Sum>i'\<in>{0..<n}. \<Sum>j'\<in>{0..<n}.
                          cnj (A $$ (i',j')) * A $$ (i',j'))"
      unfolding hs_inner_prod_def using dr dc by simp
    have step3: "Re (\<Sum>i'\<in>{0..<n}. \<Sum>j'\<in>{0..<n}.
                          cnj (A $$ (i',j')) * A $$ (i',j'))
                   = (\<Sum>i'\<in>{0..<n}. \<Sum>j'\<in>{0..<n}.
                          Re (cnj (A $$ (i',j')) * A $$ (i',j')))"
      by (simp add: Re_sum)
    have step4: "(\<Sum>i'\<in>{0..<n}. \<Sum>j'\<in>{0..<n}.
                     Re (cnj (A $$ (i',j')) * A $$ (i',j')))
                   = (\<Sum>i'\<in>{0..<n}. \<Sum>j'\<in>{0..<n}. ?term i' j')"
    proof (intro sum.cong refl)
      fix i' j'
      show "Re (cnj (A $$ (i',j')) * A $$ (i',j')) = ?term i' j'"
        by (rule entry_re)
    qed
    show ?thesis using step1 step2 step3 step4 by simp
  qed
  have one_term_le_double_sum:
    "?term i j \<le> (\<Sum>i'\<in>{0..<n}. \<Sum>j'\<in>{0..<n}. ?term i' j')"
  proof -
    have inner_bd: "?term i j \<le> (\<Sum>j'\<in>{0..<n}. ?term i j')"
      using j_lt
      by (intro member_le_sum) (auto simp: zero_le_power2)
    have outer_bd:
      "(\<Sum>j'\<in>{0..<n}. ?term i j')
         \<le> (\<Sum>i'\<in>{0..<n}. \<Sum>j'\<in>{0..<n}. ?term i' j')"
      using i_lt
      by (intro member_le_sum) (auto intro: sum_nonneg simp: zero_le_power2)
    show ?thesis using inner_bd outer_bd by linarith
  qed
  show ?thesis using hs_eq one_term_le_double_sum by simp
qed

(* Sub-helper: HS convergence implies entry-wise convergence in \<complex>.
   Dual of HS_Cauchy_entry_Cauchy: from the HS limit we extract
   pointwise limits of the entries. *)

lemma HS_lim_entry_lim:
  fixes M_seq :: "nat \<Rightarrow> complex Matrix.mat" and r :: nat
      and i j :: nat and L :: "complex Matrix.mat"
  assumes carrier: "\<forall>n. M_seq n \<in> carrier_mat r r"
      and L_c: "L \<in> carrier_mat r r"
      and lim: "(\<lambda>n. hs_norm (M_seq n - L)) \<longlonglongrightarrow> 0"
      and i_lt: "i < r" and j_lt: "j < r"
  shows "(\<lambda>n. M_seq n $$ (i,j)) \<longlonglongrightarrow> L $$ (i,j)"
proof (rule metric_LIMSEQ_I)
  fix \<epsilon> :: real assume \<epsilon>_pos: "0 < \<epsilon>"
  obtain N where N_bd: "\<forall>n \<ge> N. hs_norm (M_seq n - L) < \<epsilon>"
    using lim \<epsilon>_pos
    unfolding lim_sequentially
    by (auto simp: dist_real_def hs_norm_nonneg)
  show "\<exists>N. \<forall>n \<ge> N. dist (M_seq n $$ (i,j)) (L $$ (i,j)) < \<epsilon>"
  proof (rule exI[of _ N], intro allI impI)
    fix n assume n_ge: "n \<ge> N"
    let ?D = "M_seq n - L"
    have Mn_c: "M_seq n \<in> carrier_mat r r" using carrier by simp
    have D_c: "?D \<in> carrier_mat r r" by (rule minus_carrier_mat[OF L_c])
    have entry_eq: "?D $$ (i,j) = M_seq n $$ (i,j) - L $$ (i,j)"
    proof -
      have dr: "dim_row L = r" using L_c by auto
      have dc: "dim_col L = r" using L_c by auto
      have "?D $$ (i,j)
              = Matrix.mat (dim_row L) (dim_col L)
                  (\<lambda>ij. M_seq n $$ ij - L $$ ij) $$ (i,j)"
        unfolding minus_mat_def by simp
      also have "\<dots> = M_seq n $$ (i,j) - L $$ (i,j)"
        using i_lt j_lt dr dc by simp
      finally show ?thesis .
    qed
    have cmod_le: "(cmod (?D $$ (i,j)))\<^sup>2 \<le> (hs_norm ?D)\<^sup>2"
      by (rule cmod_entry_sq_le_hs_norm_sq[OF D_c i_lt j_lt])
    have hs_lt: "hs_norm ?D < \<epsilon>" using N_bd n_ge by simp
    have hs_nn: "0 \<le> hs_norm ?D" by (rule hs_norm_nonneg)
    have eps_nn: "0 \<le> \<epsilon>" using \<epsilon>_pos by simp
    have hs_sq_lt: "(hs_norm ?D)\<^sup>2 < \<epsilon>\<^sup>2"
      using hs_lt hs_nn by (intro power_strict_mono) auto
    have cmod_sq_lt: "(cmod (?D $$ (i,j)))\<^sup>2 < \<epsilon>\<^sup>2"
      using cmod_le hs_sq_lt by linarith
    have cmod_lt: "cmod (?D $$ (i,j)) < \<epsilon>"
      by (rule power_less_imp_less_base[OF cmod_sq_lt eps_nn])
    have dist_eq: "dist (M_seq n $$ (i,j)) (L $$ (i,j))
                     = cmod (M_seq n $$ (i,j) - L $$ (i,j))"
      by (simp add: dist_complex_def)
    show "dist (M_seq n $$ (i,j)) (L $$ (i,j)) < \<epsilon>"
      using dist_eq entry_eq cmod_lt by simp
  qed
qed

(* Helper: HS norm vanishes iff the matrix is zero (equivalent of
   hs_inner_prod_self_zero_iff for the norm). *)

lemma hs_norm_zero_iff:
  fixes A :: "complex Matrix.mat"
  shows "hs_norm A = 0 \<longleftrightarrow> A = 0\<^sub>m (dim_row A) (dim_col A)"
proof
  assume "hs_norm A = 0"
  hence "(hs_norm A)\<^sup>2 = 0" by simp
  hence "Re (\<langle>\<langle> A | A \<rangle>\<rangle>) = 0" by (simp add: hs_norm_sq)
  hence "\<langle>\<langle> A | A \<rangle>\<rangle> = 0"
    using hs_inner_prod_self_eq_of_real by (metis of_real_0)
  thus "A = 0\<^sub>m (dim_row A) (dim_col A)"
    by (simp add: hs_inner_prod_self_zero_iff)
next
  assume eq: "A = 0\<^sub>m (dim_row A) (dim_col A)"
  hence "\<langle>\<langle> A | A \<rangle>\<rangle> = 0" using hs_inner_prod_self_zero_iff by simp
  thus "hs_norm A = 0"
    by (simp add: hs_norm_def)
qed

(* Triangle inequality for the raw HS norm.  Adapts the lmat-level
   proof using \<open>hs_cauchy_schwarz_re\<close>. *)

lemma hs_norm_triangle:
  fixes A B :: "complex Matrix.mat"
  assumes A_c: "A \<in> carrier_mat n n"
      and B_c: "B \<in> carrier_mat n n"
  shows "hs_norm (A + B) \<le> hs_norm A + hs_norm B"
proof -
  have dr: "dim_row A = dim_row B" using A_c B_c by auto
  have dc: "dim_col A = dim_col B" using A_c B_c by auto
  let ?aa = "Re (\<langle>\<langle> A | A \<rangle>\<rangle>)"
  let ?bb = "Re (\<langle>\<langle> B | B \<rangle>\<rangle>)"
  let ?ab = "Re (\<langle>\<langle> A | B \<rangle>\<rangle>)"
  have aa_nn: "?aa \<ge> 0" by (rule hs_inner_prod_self_nonneg)
  have bb_nn: "?bb \<ge> 0" by (rule hs_inner_prod_self_nonneg)
  have ab_eq_ba: "?ab = Re (\<langle>\<langle> B | A \<rangle>\<rangle>)"
    by (metis cnj.sel(1) dc dr hs_inner_prod_cnj)

  have ip_sum:
    "\<langle>\<langle> A + B | A + B \<rangle>\<rangle>
       = \<langle>\<langle> A | A \<rangle>\<rangle> + \<langle>\<langle> A | B \<rangle>\<rangle> + \<langle>\<langle> B | A \<rangle>\<rangle> + \<langle>\<langle> B | B \<rangle>\<rangle>"
  proof -
    text \<open>Right-add expansion of \<open>\<langle>\<langle> A | A + B \<rangle>\<rangle>\<close>.\<close>
    have d5: "dim_row A = dim_row A" by simp
    have d6: "dim_col A = dim_col A" by simp
    have d7: "dim_row B = dim_row A" using dr by simp
    have d8: "dim_col B = dim_col A" using dc by simp
    have step2: "\<langle>\<langle> A | A + B \<rangle>\<rangle> = \<langle>\<langle> A | A \<rangle>\<rangle> + \<langle>\<langle> A | B \<rangle>\<rangle>"
      using hs_inner_prod_right_add[OF d5 d6 d7 d8] .
    have d9: "dim_row A = dim_row B" using dr by simp
    have d10: "dim_col A = dim_col B" using dc by simp
    have d11: "dim_row B = dim_row B" by simp
    have d12: "dim_col B = dim_col B" by simp
    have step3: "\<langle>\<langle> B | A + B \<rangle>\<rangle> = \<langle>\<langle> B | A \<rangle>\<rangle> + \<langle>\<langle> B | B \<rangle>\<rangle>"
      using hs_inner_prod_right_add[OF d9 d10 d11 d12] .
    text \<open>Left-add via conjugate symmetry to avoid the
    \<open>hs_inner_prod_left_add\<close> OF-clash.\<close>
    have AB_dr: "dim_row (A + B) = dim_row B" using B_c by auto
    have AB_dc: "dim_col (A + B) = dim_col B" using B_c by auto
    have self_real: "\<langle>\<langle> A + B | A + B \<rangle>\<rangle>
                       = cnj (\<langle>\<langle> A + B | A + B \<rangle>\<rangle>)"
      using hs_inner_prod_self_real by (metis Reals_cnj_iff)
    have flip: "\<langle>\<langle> A + B | A + B \<rangle>\<rangle> = \<langle>\<langle> A + B | A + B \<rangle>\<rangle>" ..
    text \<open>Use right-add on \<open>\<langle>\<langle> A + B | A + B \<rangle>\<rangle>\<close>.\<close>
    have e1: "dim_row (A + B) = dim_row (A + B)" by simp
    have e2: "dim_col (A + B) = dim_col (A + B)" by simp
    have step1_rev: "\<langle>\<langle> A + B | A + B \<rangle>\<rangle>
                      = \<langle>\<langle> A + B | A \<rangle>\<rangle> + \<langle>\<langle> A + B | B \<rangle>\<rangle>"
    proof -
      have h1: "dim_row A = dim_row (A + B)" using dr by simp
      have h2: "dim_col A = dim_col (A + B)" using dc by simp
      have h3: "dim_row B = dim_row (A + B)" using dr by simp
      have h4: "dim_col B = dim_col (A + B)" using dc by simp
      show ?thesis
        using hs_inner_prod_right_add[OF h1 h2 h3 h4] .
    qed
    text \<open>Convert each \<open>\<langle>\<langle> A+B | X \<rangle>\<rangle>\<close> via conjugate symmetry.\<close>
    have flipA: "\<langle>\<langle> A + B | A \<rangle>\<rangle> = cnj (\<langle>\<langle> A | A + B \<rangle>\<rangle>)"
      using AB_dr AB_dc dr dc
      by (intro hs_inner_prod_cnj) auto
    have flipB: "\<langle>\<langle> A + B | B \<rangle>\<rangle> = cnj (\<langle>\<langle> B | A + B \<rangle>\<rangle>)"
      using AB_dr AB_dc dr dc
      by (intro hs_inner_prod_cnj) auto
    text \<open>Compute the right-add expansions of \<open>cnj(...)\<close> via step2/step3.\<close>
    have flipA_eq: "cnj (\<langle>\<langle> A | A + B \<rangle>\<rangle>)
                      = cnj (\<langle>\<langle> A | A \<rangle>\<rangle>) + cnj (\<langle>\<langle> A | B \<rangle>\<rangle>)"
      using step2 by simp
    have flipB_eq: "cnj (\<langle>\<langle> B | A + B \<rangle>\<rangle>)
                      = cnj (\<langle>\<langle> B | A \<rangle>\<rangle>) + cnj (\<langle>\<langle> B | B \<rangle>\<rangle>)"
      using step3 by simp
    text \<open>And then \<open>cnj\<close> on \<open>\<langle>\<langle>X|X\<rangle>\<rangle>\<close> gives the swap.\<close>
    have AA_real: "cnj (\<langle>\<langle> A | A \<rangle>\<rangle>) = \<langle>\<langle> A | A \<rangle>\<rangle>"
      using hs_inner_prod_self_real by (metis Reals_cnj_iff)
    have BB_real: "cnj (\<langle>\<langle> B | B \<rangle>\<rangle>) = \<langle>\<langle> B | B \<rangle>\<rangle>"
      using hs_inner_prod_self_real by (metis Reals_cnj_iff)
    have cnj_AB: "cnj (\<langle>\<langle> A | B \<rangle>\<rangle>) = \<langle>\<langle> B | A \<rangle>\<rangle>"
      using hs_inner_prod_cnj[OF d9 d10] by simp
    have cnj_BA: "cnj (\<langle>\<langle> B | A \<rangle>\<rangle>) = \<langle>\<langle> A | B \<rangle>\<rangle>"
      using hs_inner_prod_cnj[OF d7 d8] by simp
    have flipA_full: "\<langle>\<langle> A + B | A \<rangle>\<rangle>
                        = \<langle>\<langle> A | A \<rangle>\<rangle> + \<langle>\<langle> B | A \<rangle>\<rangle>"
      using flipA flipA_eq AA_real cnj_AB by simp
    have flipB_full: "\<langle>\<langle> A + B | B \<rangle>\<rangle>
                        = \<langle>\<langle> A | B \<rangle>\<rangle> + \<langle>\<langle> B | B \<rangle>\<rangle>"
      using flipB flipB_eq BB_real cnj_BA by simp
    show ?thesis using step1_rev flipA_full flipB_full by (simp add: ac_simps)
  qed
  have re_sum: "Re (\<langle>\<langle> A + B | A + B \<rangle>\<rangle>) = ?aa + 2 * ?ab + ?bb"
    using ip_sum ab_eq_ba by simp

  have cs: "?ab\<^sup>2 \<le> ?aa * ?bb"
    using hs_cauchy_schwarz_re[OF dr dc] .
  have ab_le: "?ab \<le> sqrt ?aa * sqrt ?bb"
  proof -
    have aa_bb_nn: "0 \<le> ?aa * ?bb" using aa_nn bb_nn by simp
    have "?ab \<le> \<bar>?ab\<bar>" by simp
    also have "\<bar>?ab\<bar> = sqrt (?ab\<^sup>2)" by simp
    also have "\<dots> \<le> sqrt (?aa * ?bb)"
      using cs by (rule real_sqrt_le_mono)
    also have "\<dots> = sqrt ?aa * sqrt ?bb"
      by (rule real_sqrt_mult)
    finally show ?thesis .
  qed

  have target_sq:
    "(hs_norm (A + B))\<^sup>2 \<le> (hs_norm A + hs_norm B)\<^sup>2"
  proof -
    have lhs: "(hs_norm (A + B))\<^sup>2 = ?aa + 2 * ?ab + ?bb"
      using hs_norm_sq[of "A + B"] re_sum by simp
    have hA: "hs_norm A = sqrt ?aa" by (simp add: hs_norm_def)
    have hB: "hs_norm B = sqrt ?bb" by (simp add: hs_norm_def)
    have rhs:
      "(hs_norm A + hs_norm B)\<^sup>2
         = ?aa + 2 * (sqrt ?aa * sqrt ?bb) + ?bb"
    proof -
      have "(hs_norm A + hs_norm B)\<^sup>2 = (sqrt ?aa + sqrt ?bb)\<^sup>2"
        by (simp add: hA hB)
      also have "\<dots> = (sqrt ?aa)\<^sup>2 + 2 * (sqrt ?aa * sqrt ?bb) + (sqrt ?bb)\<^sup>2"
        by (simp add: power2_sum)
      also have "\<dots> = ?aa + 2 * (sqrt ?aa * sqrt ?bb) + ?bb"
        using aa_nn bb_nn by simp
      finally show ?thesis .
    qed
    show ?thesis using lhs rhs ab_le by (simp add: algebra_simps)
  qed

  have lhs_nn: "0 \<le> hs_norm (A + B)" by (rule hs_norm_nonneg)
  have rhs_nn: "0 \<le> hs_norm A + hs_norm B"
    using hs_norm_nonneg[of A] hs_norm_nonneg[of B] by simp
  show ?thesis
    using target_sq lhs_nn rhs_nn power2_le_imp_le by blast
qed

(* Quantitative parallelogram identity for matrices: writes the
   distance \<open>\<parallel>q\<^sub>2 - q\<^sub>1\<parallel>\<^sup>2\<close> in terms of distances of \<open>q\<^sub>1\<close>, \<open>q\<^sub>2\<close>
   to a reference point \<open>\<rho>\<close> and the midpoint distance.

   Core Cauchy bound for the closest-point existence proof:
   \<parallel>q\<^sub>2 - q\<^sub>1\<parallel>\<^sup>2 = 2\<parallel>\<rho>-q\<^sub>1\<parallel>\<^sup>2 + 2\<parallel>\<rho>-q\<^sub>2\<parallel>\<^sup>2 - 4\<parallel>\<rho> - midpoint\<parallel>\<^sup>2.
   When q\<^sub>1, q\<^sub>2 are near-minimizers and midpoint \<in> cone (convexity),
   the LHS is forced to 0. *)

lemma hs_quantitative_parallelogram:
  fixes \<rho> q\<^sub>1 q\<^sub>2 :: "complex Matrix.mat"
  assumes \<rho>_c: "\<rho> \<in> carrier_mat n n"
      and q\<^sub>1_c: "q\<^sub>1 \<in> carrier_mat n n"
      and q\<^sub>2_c: "q\<^sub>2 \<in> carrier_mat n n"
  shows "(hs_norm (q\<^sub>2 - q\<^sub>1))\<^sup>2
          + 4 * (hs_norm (\<rho> - complex_of_real (1/2) \<cdot>\<^sub>m (q\<^sub>1 + q\<^sub>2)))\<^sup>2
          = 2 * (hs_norm (\<rho> - q\<^sub>1))\<^sup>2 + 2 * (hs_norm (\<rho> - q\<^sub>2))\<^sup>2"
proof -
  let ?U = "\<rho> - q\<^sub>1"
  let ?V = "\<rho> - q\<^sub>2"
  have U_c: "?U \<in> carrier_mat n n" using \<rho>_c q\<^sub>1_c by auto
  have V_c: "?V \<in> carrier_mat n n" using \<rho>_c q\<^sub>2_c by auto
  have par: "(hs_norm (?U + ?V))\<^sup>2 + (hs_norm (?U - ?V))\<^sup>2
              = 2 * (hs_norm ?U)\<^sup>2 + 2 * (hs_norm ?V)\<^sup>2"
    by (rule hs_norm_parallelogram[OF U_c V_c])
  have UV_eq: "?U + ?V = complex_of_real 2 \<cdot>\<^sub>m (\<rho> - complex_of_real (1/2) \<cdot>\<^sub>m (q\<^sub>1 + q\<^sub>2))"
  proof (intro eq_matI)
    show "dim_row (?U + ?V)
            = dim_row (complex_of_real 2 \<cdot>\<^sub>m (\<rho> - complex_of_real (1/2) \<cdot>\<^sub>m (q\<^sub>1 + q\<^sub>2)))"
      using \<rho>_c q\<^sub>1_c q\<^sub>2_c by auto
    show "dim_col (?U + ?V)
            = dim_col (complex_of_real 2 \<cdot>\<^sub>m (\<rho> - complex_of_real (1/2) \<cdot>\<^sub>m (q\<^sub>1 + q\<^sub>2)))"
      using \<rho>_c q\<^sub>1_c q\<^sub>2_c by auto
    fix i j
    assume i: "i < dim_row (complex_of_real 2 \<cdot>\<^sub>m (\<rho> - complex_of_real (1/2) \<cdot>\<^sub>m (q\<^sub>1 + q\<^sub>2)))"
    assume j: "j < dim_col (complex_of_real 2 \<cdot>\<^sub>m (\<rho> - complex_of_real (1/2) \<cdot>\<^sub>m (q\<^sub>1 + q\<^sub>2)))"
    have ilt: "i < n" using i \<rho>_c q\<^sub>1_c q\<^sub>2_c by auto
    have jlt: "j < n" using j \<rho>_c q\<^sub>1_c q\<^sub>2_c by auto
    show "(?U + ?V) $$ (i,j)
            = (complex_of_real 2 \<cdot>\<^sub>m (\<rho> - complex_of_real (1/2) \<cdot>\<^sub>m (q\<^sub>1 + q\<^sub>2))) $$ (i,j)"
      using ilt jlt \<rho>_c q\<^sub>1_c q\<^sub>2_c
      by (simp add: minus_mat_def algebra_simps)
  qed
  have UV_norm:
    "(hs_norm (?U + ?V))\<^sup>2
       = 4 * (hs_norm (\<rho> - complex_of_real (1/2) \<cdot>\<^sub>m (q\<^sub>1 + q\<^sub>2)))\<^sup>2"
  proof -
    have "hs_norm (?U + ?V)
            = hs_norm (complex_of_real 2
                        \<cdot>\<^sub>m (\<rho> - complex_of_real (1/2) \<cdot>\<^sub>m (q\<^sub>1 + q\<^sub>2)))"
      using UV_eq by simp
    also have "\<dots> = cmod (complex_of_real 2)
                    * hs_norm (\<rho> - complex_of_real (1/2) \<cdot>\<^sub>m (q\<^sub>1 + q\<^sub>2))"
      by (rule hs_norm_smult)
    also have "cmod (complex_of_real 2) = 2" by simp
    finally have "hs_norm (?U + ?V)
                    = 2 * hs_norm (\<rho> - complex_of_real (1/2) \<cdot>\<^sub>m (q\<^sub>1 + q\<^sub>2))" .
    thus ?thesis by (simp add: power2_eq_square)
  qed
  have UV_diff: "?U - ?V = q\<^sub>2 - q\<^sub>1"
  proof (intro eq_matI)
    show "dim_row (?U - ?V) = dim_row (q\<^sub>2 - q\<^sub>1)"
      using \<rho>_c q\<^sub>1_c q\<^sub>2_c by auto
    show "dim_col (?U - ?V) = dim_col (q\<^sub>2 - q\<^sub>1)"
      using \<rho>_c q\<^sub>1_c q\<^sub>2_c by auto
    fix i j
    assume i: "i < dim_row (q\<^sub>2 - q\<^sub>1)" and j: "j < dim_col (q\<^sub>2 - q\<^sub>1)"
    have ilt: "i < n" using i q\<^sub>1_c q\<^sub>2_c by auto
    have jlt: "j < n" using j q\<^sub>1_c q\<^sub>2_c by auto
    show "(?U - ?V) $$ (i,j) = (q\<^sub>2 - q\<^sub>1) $$ (i,j)"
      using ilt jlt \<rho>_c q\<^sub>1_c q\<^sub>2_c by (simp add: minus_mat_def)
  qed
  hence UV_diff_norm: "(hs_norm (?U - ?V))\<^sup>2 = (hs_norm (q\<^sub>2 - q\<^sub>1))\<^sup>2"
    by simp
  show ?thesis using par UV_norm UV_diff_norm by simp
qed

(* Quantitative Cauchy bound: any two near-minimizers in the
   separable cone are HS-close. Concretely, if \<open>q\<^sub>1, q\<^sub>2 \<in> cone\<close>
   with \<open>\<parallel>\<rho> - q\<^sub>i\<parallel> \<le> D + \<delta>\<close> (where \<open>D\<close> is the infimum), then
   \<parallel>q\<^sub>2 - q\<^sub>1\<parallel>\<^sup>2 \<le> 8 D \<delta> + 4 \<delta>\<^sup>2.  Letting \<delta> \<to> 0 gives Cauchy. *)

lemma cone_minimizers_close:
  fixes \<rho> q\<^sub>1 q\<^sub>2 :: "complex Matrix.mat" and \<delta> :: real
  assumes \<rho>_c: "\<rho> \<in> carrier_mat (m*p) (m*p)"
      and q\<^sub>1_cone: "separable_cone m p q\<^sub>1"
      and q\<^sub>2_cone: "separable_cone m p q\<^sub>2"
      and \<delta>_nn: "0 \<le> \<delta>"
      and bd1: "hs_norm (\<rho> - q\<^sub>1) \<le> Inf (cone_dist_set m p \<rho>) + \<delta>"
      and bd2: "hs_norm (\<rho> - q\<^sub>2) \<le> Inf (cone_dist_set m p \<rho>) + \<delta>"
      and m_pos: "0 < m" and p_pos: "0 < p"
  shows "(hs_norm (q\<^sub>2 - q\<^sub>1))\<^sup>2
          \<le> 8 * Inf (cone_dist_set m p \<rho>) * \<delta> + 4 * \<delta>\<^sup>2"
proof -
  let ?D = "Inf (cone_dist_set m p \<rho>)"
  have D_nn: "0 \<le> ?D" by (rule cone_dist_set_inf_nonneg)
  have q\<^sub>1_c: "q\<^sub>1 \<in> carrier_mat (m*p) (m*p)"
    using q\<^sub>1_cone unfolding separable_cone_def by auto
  have q\<^sub>2_c: "q\<^sub>2 \<in> carrier_mat (m*p) (m*p)"
    using q\<^sub>2_cone unfolding separable_cone_def by auto

  text \<open>Midpoint is in the cone (convexity).\<close>
  let ?mid = "complex_of_real (1/2) \<cdot>\<^sub>m (q\<^sub>1 + q\<^sub>2)"
  have mid_eq: "?mid = complex_of_real (1/2) \<cdot>\<^sub>m q\<^sub>1
                       + complex_of_real (1/2) \<cdot>\<^sub>m q\<^sub>2"
    using q\<^sub>1_c q\<^sub>2_c
    by (intro eq_matI) (auto simp: ring_distribs)
  have half_q\<^sub>1_cone: "separable_cone m p (complex_of_real (1/2) \<cdot>\<^sub>m q\<^sub>1)"
    by (rule separable_cone_smult[OF q\<^sub>1_cone _ m_pos p_pos]) simp
  have half_q\<^sub>2_cone: "separable_cone m p (complex_of_real (1/2) \<cdot>\<^sub>m q\<^sub>2)"
    by (rule separable_cone_smult[OF q\<^sub>2_cone _ m_pos p_pos]) simp
  have mid_cone: "separable_cone m p ?mid"
    using separable_cone_add[OF half_q\<^sub>1_cone half_q\<^sub>2_cone]
    using mid_eq by simp

  text \<open>Distance to midpoint \<ge> infimum.\<close>
  have mid_in: "hs_norm (\<rho> - ?mid) \<in> cone_dist_set m p \<rho>"
    unfolding cone_dist_set_def using mid_cone by blast
  have D_le_mid: "?D \<le> hs_norm (\<rho> - ?mid)"
    by (rule cInf_lower[OF mid_in cone_dist_set_bdd_below])
  have D_le_mid_sq: "?D\<^sup>2 \<le> (hs_norm (\<rho> - ?mid))\<^sup>2"
    using D_le_mid D_nn by (simp add: power_mono)

  text \<open>Apply quantitative parallelogram.\<close>
  have par: "(hs_norm (q\<^sub>2 - q\<^sub>1))\<^sup>2 + 4 * (hs_norm (\<rho> - ?mid))\<^sup>2
              = 2 * (hs_norm (\<rho> - q\<^sub>1))\<^sup>2 + 2 * (hs_norm (\<rho> - q\<^sub>2))\<^sup>2"
    by (rule hs_quantitative_parallelogram[OF \<rho>_c q\<^sub>1_c q\<^sub>2_c])

  text \<open>Bound RHS using bd1, bd2.\<close>
  have rho_q1_nn: "0 \<le> hs_norm (\<rho> - q\<^sub>1)" by (simp add: hs_norm_nonneg)
  have rho_q2_nn: "0 \<le> hs_norm (\<rho> - q\<^sub>2)" by (simp add: hs_norm_nonneg)
  have D_d_nn: "0 \<le> ?D + \<delta>" using D_nn \<delta>_nn by simp
  have sq1: "(hs_norm (\<rho> - q\<^sub>1))\<^sup>2 \<le> (?D + \<delta>)\<^sup>2"
    using bd1 rho_q1_nn by (rule power_mono)
  have sq2: "(hs_norm (\<rho> - q\<^sub>2))\<^sup>2 \<le> (?D + \<delta>)\<^sup>2"
    using bd2 rho_q2_nn by (rule power_mono)
  have rhs_bd: "2 * (hs_norm (\<rho> - q\<^sub>1))\<^sup>2 + 2 * (hs_norm (\<rho> - q\<^sub>2))\<^sup>2
                  \<le> 4 * (?D + \<delta>)\<^sup>2"
    using sq1 sq2 by linarith

  text \<open>Lower-bound LHS midpoint distance.\<close>
  have lhs_lb: "4 * ?D\<^sup>2 \<le> 4 * (hs_norm (\<rho> - ?mid))\<^sup>2"
    using D_le_mid_sq by linarith

  have "(hs_norm (q\<^sub>2 - q\<^sub>1))\<^sup>2 + 4 * ?D\<^sup>2
          \<le> (hs_norm (q\<^sub>2 - q\<^sub>1))\<^sup>2 + 4 * (hs_norm (\<rho> - ?mid))\<^sup>2"
    using lhs_lb by linarith
  also have "\<dots> = 2 * (hs_norm (\<rho> - q\<^sub>1))\<^sup>2 + 2 * (hs_norm (\<rho> - q\<^sub>2))\<^sup>2"
    by (rule par)
  also have "\<dots> \<le> 4 * (?D + \<delta>)\<^sup>2" by (rule rhs_bd)
  finally have "(hs_norm (q\<^sub>2 - q\<^sub>1))\<^sup>2 \<le> 4 * (?D + \<delta>)\<^sup>2 - 4 * ?D\<^sup>2"
    by linarith
  also have "4 * (?D + \<delta>)\<^sup>2 - 4 * ?D\<^sup>2 = 8 * ?D * \<delta> + 4 * \<delta>\<^sup>2"
    by (simp add: power2_eq_square algebra_simps)
  finally show ?thesis .
qed

(* HS-Cauchy property of any minimizing sequence: for each \<epsilon> > 0
   there is an \<open>N\<close> such that pairs of indices \<ge> N produce HS-close
   matrices.  Combines \<open>cone_minimizers_close\<close> with the explicit
   \<open>1/(n+1)\<close> bound from \<open>cone_dist_minimizing_sequence\<close>. *)

lemma minimizing_sequence_HS_Cauchy:
  fixes m p :: nat and \<rho> :: "complex Matrix.mat"
      and q\<^sub>n :: "nat \<Rightarrow> complex Matrix.mat"
  assumes \<rho>_c: "\<rho> \<in> carrier_mat (m*p) (m*p)"
      and seq_cone: "\<forall>n. separable_cone m p (q\<^sub>n n)"
      and seq_bd:
        "\<forall>n. hs_norm (\<rho> - q\<^sub>n n)
              < Inf (cone_dist_set m p \<rho>) + 1 / (real n + 1)"
      and m_pos: "0 < m" and p_pos: "0 < p"
  shows "\<forall>\<epsilon>>0. \<exists>N. \<forall>r \<ge> N. \<forall>s \<ge> N. hs_norm (q\<^sub>n r - q\<^sub>n s) < \<epsilon>"
proof (intro allI impI)
  fix \<epsilon> :: real assume \<epsilon>_pos: "0 < \<epsilon>"
  let ?D = "Inf (cone_dist_set m p \<rho>)"
  have D_nn: "0 \<le> ?D" by (rule cone_dist_set_inf_nonneg)
  text \<open>Pick \<open>N\<close> large enough that for all \<open>k \<ge> N\<close>,
  \<open>1/(k+1)\<close> is small enough.\<close>
  have eps2_pos: "0 < \<epsilon>\<^sup>2 / (16 * (?D + 1))"
    using \<epsilon>_pos D_nn by simp
  obtain N where N_bd: "1 / (real N + 1) < \<epsilon>\<^sup>2 / (16 * (?D + 1))"
  proof -
    obtain N where N_big: "real N > 16 * (?D + 1) / \<epsilon>\<^sup>2"
      using reals_Archimedean2[of "16 * (?D + 1) / \<epsilon>\<^sup>2"] by blast
    have factor_pos: "0 < 16 * (?D + 1)" using D_nn by simp
    have eps2_pos: "0 < \<epsilon>\<^sup>2" using \<epsilon>_pos by simp
    have N_plus1_big: "real N + 1 > 16 * (?D + 1) / \<epsilon>\<^sup>2"
      using N_big by linarith
    have N_plus1_pos: "0 < real N + 1" by simp
    have ratio_pos: "0 < 16 * (?D + 1) / \<epsilon>\<^sup>2"
      using factor_pos eps2_pos by simp
    have "(real N + 1) * \<epsilon>\<^sup>2 > 16 * (?D + 1)"
      using N_plus1_big eps2_pos
      by (simp add: pos_divide_less_eq mult.commute)
    hence "1 / (real N + 1) < \<epsilon>\<^sup>2 / (16 * (?D + 1))"
      using N_plus1_pos factor_pos eps2_pos
      by (simp add: less_divide_eq pos_less_divide_eq field_simps)
    thus ?thesis using that by blast
  qed
  show "\<exists>N. \<forall>r \<ge> N. \<forall>s \<ge> N. hs_norm (q\<^sub>n r - q\<^sub>n s) < \<epsilon>"
  proof (rule exI[of _ N], intro allI impI)
    fix r s assume rN: "N \<le> r" and sN: "N \<le> s"
    have one_r: "0 < 1 / (real r + 1)" by simp
    have one_s: "0 < 1 / (real s + 1)" by simp
    define \<delta> where "\<delta> = max (1 / (real r + 1)) (1 / (real s + 1))"
    have \<delta>_pos: "0 < \<delta>"
      unfolding \<delta>_def using one_r one_s by linarith
    have \<delta>_nn: "0 \<le> \<delta>" using \<delta>_pos by simp
    have \<delta>_le_N: "\<delta> \<le> 1 / (real N + 1)"
    proof -
      have a: "1 / (real r + 1) \<le> 1 / (real N + 1)"
        using rN by (simp add: frac_le)
      have b: "1 / (real s + 1) \<le> 1 / (real N + 1)"
        using sN by (simp add: frac_le)
      show ?thesis using a b \<delta>_def by simp
    qed
    have \<delta>_small: "\<delta> < \<epsilon>\<^sup>2 / (16 * (?D + 1))"
      using \<delta>_le_N N_bd by linarith
    text \<open>Both \<open>q\<^sub>n r\<close> and \<open>q\<^sub>n s\<close> are within \<open>?D + \<delta>\<close>.\<close>
    have bd_r: "hs_norm (\<rho> - q\<^sub>n r) \<le> ?D + \<delta>"
    proof -
      have "hs_norm (\<rho> - q\<^sub>n r) < ?D + 1 / (real r + 1)"
        using seq_bd by simp
      moreover have "1 / (real r + 1) \<le> \<delta>" using \<delta>_def by simp
      ultimately show ?thesis by simp
    qed
    have bd_s: "hs_norm (\<rho> - q\<^sub>n s) \<le> ?D + \<delta>"
    proof -
      have "hs_norm (\<rho> - q\<^sub>n s) < ?D + 1 / (real s + 1)"
        using seq_bd by simp
      moreover have "1 / (real s + 1) \<le> \<delta>" using \<delta>_def by simp
      ultimately show ?thesis by simp
    qed
    have qr_cone: "separable_cone m p (q\<^sub>n r)" using seq_cone by simp
    have qs_cone: "separable_cone m p (q\<^sub>n s)" using seq_cone by simp
    have sq_bd: "(hs_norm (q\<^sub>n s - q\<^sub>n r))\<^sup>2 \<le> 8 * ?D * \<delta> + 4 * \<delta>\<^sup>2"
      by (rule cone_minimizers_close
            [OF \<rho>_c qr_cone qs_cone \<delta>_nn bd_r bd_s m_pos p_pos])
    text \<open>Now show \<open>8 D \<delta> + 4 \<delta>\<^sup>2 < \<epsilon>\<^sup>2\<close> using our choice of \<delta>.\<close>
    have factor_pos: "0 < 16 * (?D + 1)" using D_nn by simp
    have step_a: "8 * ?D * \<delta> \<le> 8 * (?D + 1) * \<delta>"
      using D_nn \<delta>_nn by (simp add: mult_right_mono)
    have step_b: "4 * \<delta>\<^sup>2 \<le> 4 * \<delta>"
    proof -
      have one_r_le: "1 / (real r + 1) \<le> 1" by simp
      have one_s_le: "1 / (real s + 1) \<le> 1" by simp
      have \<delta>_le_1: "\<delta> \<le> 1"
        using one_r_le one_s_le unfolding \<delta>_def by simp
      have "\<delta>\<^sup>2 = \<delta> * \<delta>" by (simp add: power2_eq_square)
      also have "\<dots> \<le> \<delta> * 1" using \<delta>_le_1 \<delta>_nn by (rule mult_left_mono)
      also have "\<delta> * 1 = \<delta>" by simp
      finally have "\<delta>\<^sup>2 \<le> \<delta>" .
      thus ?thesis using \<delta>_nn by simp
    qed
    have step_c: "4 * \<delta> \<le> 4 * (?D + 1) * \<delta>"
      using D_nn \<delta>_nn by (simp add: mult_right_mono)
    have combine: "8 * ?D * \<delta> + 4 * \<delta>\<^sup>2 \<le> 16 * (?D + 1) * \<delta>"
    proof -
      have a1: "8 * ?D * \<delta> + 4 * \<delta>\<^sup>2 \<le> 8 * (?D + 1) * \<delta> + 4 * \<delta>"
        using step_a step_b by linarith
      have a2: "8 * (?D + 1) * \<delta> + 4 * \<delta>
                  \<le> 8 * (?D + 1) * \<delta> + 4 * (?D + 1) * \<delta>"
        using step_c by linarith
      have a3: "8 * (?D + 1) * \<delta> + 4 * (?D + 1) * \<delta>
                  = 12 * (?D + 1) * \<delta>"
        by (simp add: algebra_simps)
      have a4: "12 * (?D + 1) * \<delta> \<le> 16 * (?D + 1) * \<delta>"
        using D_nn \<delta>_nn by (intro mult_right_mono) auto
      from a1 a2 a3 a4 show ?thesis by linarith
    qed
    have small: "16 * (?D + 1) * \<delta> < \<epsilon>\<^sup>2"
    proof -
      have "16 * (?D + 1) * \<delta> < 16 * (?D + 1) * (\<epsilon>\<^sup>2 / (16 * (?D + 1)))"
        using \<delta>_small factor_pos by (intro mult_strict_left_mono) auto
      also have "\<dots> = \<epsilon>\<^sup>2" using factor_pos by simp
      finally show ?thesis .
    qed
    have final_sq: "(hs_norm (q\<^sub>n s - q\<^sub>n r))\<^sup>2 < \<epsilon>\<^sup>2"
      using sq_bd combine small by linarith
    text \<open>Take square roots.\<close>
    have norm_nn: "0 \<le> hs_norm (q\<^sub>n s - q\<^sub>n r)" by (rule hs_norm_nonneg)
    have eps_nn: "0 \<le> \<epsilon>" using \<epsilon>_pos by simp
    have "hs_norm (q\<^sub>n s - q\<^sub>n r) < \<epsilon>"
      by (rule power_less_imp_less_base[OF final_sq eps_nn])
    text \<open>Same for \<open>q\<^sub>n r - q\<^sub>n s\<close> by symmetry.\<close>
    moreover have "hs_norm (q\<^sub>n r - q\<^sub>n s) = hs_norm (q\<^sub>n s - q\<^sub>n r)"
    proof -
      have qr_c: "q\<^sub>n r \<in> carrier_mat (m*p) (m*p)"
        using qr_cone unfolding separable_cone_def by auto
      have qs_c: "q\<^sub>n s \<in> carrier_mat (m*p) (m*p)"
        using qs_cone unfolding separable_cone_def by auto
      have eq: "q\<^sub>n r - q\<^sub>n s = complex_of_real (-1) \<cdot>\<^sub>m (q\<^sub>n s - q\<^sub>n r)"
        using qr_c qs_c
        by (intro eq_matI) (auto simp: minus_mat_def)
      have "hs_norm (q\<^sub>n r - q\<^sub>n s)
              = hs_norm (complex_of_real (-1) \<cdot>\<^sub>m (q\<^sub>n s - q\<^sub>n r))"
        using eq by simp
      also have "\<dots> = cmod (complex_of_real (-1)) * hs_norm (q\<^sub>n s - q\<^sub>n r)"
        by (rule hs_norm_smult)
      also have "cmod (complex_of_real (-1)) = 1" by simp
      finally show ?thesis by simp
    qed
    ultimately show "hs_norm (q\<^sub>n r - q\<^sub>n s) < \<epsilon>" by simp
  qed
qed

(* Entry-wise Cauchy: each \<open>(i,j)\<close>-entry of a HS-Cauchy matrix
   sequence is itself a Cauchy sequence in \<open>\<complex>\<close>.  Combined with the
   completeness of \<open>\<complex>\<close>, each entry has a limit. *)

lemma HS_Cauchy_entry_Cauchy:
  fixes M_seq :: "nat \<Rightarrow> complex Matrix.mat" and r c :: nat
      and i j :: nat
  assumes carrier: "\<forall>n. M_seq n \<in> carrier_mat r c"
      and hs_cauchy: "\<forall>\<epsilon>>0. \<exists>N. \<forall>x \<ge> N. \<forall>y \<ge> N.
                                hs_norm (M_seq x - M_seq y) < \<epsilon>"
      and i_lt: "i < r" and j_lt: "j < c"
      and r_eq_c: "r = c"
  shows "Cauchy (\<lambda>n. M_seq n $$ (i,j))"
proof (rule metric_CauchyI)
  fix \<epsilon> :: real assume \<epsilon>_pos: "0 < \<epsilon>"
  obtain N where N_bd: "\<forall>x \<ge> N. \<forall>y \<ge> N. hs_norm (M_seq x - M_seq y) < \<epsilon>"
    using hs_cauchy \<epsilon>_pos by blast
  show "\<exists>N. \<forall>x \<ge> N. \<forall>y \<ge> N.
            dist (M_seq x $$ (i, j)) (M_seq y $$ (i, j)) < \<epsilon>"
  proof (rule exI[of _ N], intro allI impI)
    fix x y assume xN: "N \<le> x" and yN: "N \<le> y"
    let ?D = "M_seq x - M_seq y"
    have Mx_c: "M_seq x \<in> carrier_mat r c" using carrier by simp
    have My_c: "M_seq y \<in> carrier_mat r c" using carrier by simp
    have D_c: "?D \<in> carrier_mat r c"
      by (rule minus_carrier_mat[OF My_c])
    have D_c_eq: "?D \<in> carrier_mat r r" using D_c r_eq_c by simp
    have entry_eq: "?D $$ (i,j) = M_seq x $$ (i,j) - M_seq y $$ (i,j)"
    proof -
      have dr: "dim_row (M_seq y) = r" using My_c by auto
      have dc: "dim_col (M_seq y) = c" using My_c by auto
      have "?D $$ (i,j)
              = Matrix.mat (dim_row (M_seq y)) (dim_col (M_seq y))
                  (\<lambda>ij. M_seq x $$ ij - M_seq y $$ ij) $$ (i,j)"
        unfolding minus_mat_def by simp
      also have "\<dots> = M_seq x $$ (i,j) - M_seq y $$ (i,j)"
        using i_lt j_lt dr dc by simp
      finally show ?thesis .
    qed
    have j_lt_r: "j < r" using j_lt r_eq_c by simp
    have cmod_le: "(cmod (?D $$ (i,j)))\<^sup>2 \<le> (hs_norm ?D)\<^sup>2"
      by (rule cmod_entry_sq_le_hs_norm_sq[OF D_c_eq i_lt j_lt_r])
    have hs_lt_eps: "hs_norm ?D < \<epsilon>" using N_bd xN yN by simp
    have hs_nn: "0 \<le> hs_norm ?D" by (rule hs_norm_nonneg)
    have eps_nn: "0 \<le> \<epsilon>" using \<epsilon>_pos by simp
    have hs_sq_lt: "(hs_norm ?D)\<^sup>2 < \<epsilon>\<^sup>2"
      using hs_lt_eps hs_nn by (intro power_strict_mono) auto
    have cmod_sq_lt: "(cmod (?D $$ (i,j)))\<^sup>2 < \<epsilon>\<^sup>2"
      using cmod_le hs_sq_lt by linarith
    have cmod_nn: "0 \<le> cmod (?D $$ (i,j))" by simp
    have cmod_lt: "cmod (?D $$ (i,j)) < \<epsilon>"
      by (rule power_less_imp_less_base[OF cmod_sq_lt eps_nn])
    have dist_eq: "dist (M_seq x $$ (i,j)) (M_seq y $$ (i,j))
                     = cmod (M_seq x $$ (i,j) - M_seq y $$ (i,j))"
      by (simp add: dist_complex_def)
    show "dist (M_seq x $$ (i,j)) (M_seq y $$ (i,j)) < \<epsilon>"
      using dist_eq entry_eq cmod_lt by simp
  qed
qed

(* HS-Cauchy implies HS-convergent: matrix space with HS norm is
   complete.  Combine HS_Cauchy_entry_Cauchy + Complex_completeness
   to get pointwise limits, then assemble into a matrix and show
   convergence. *)

lemma HS_Cauchy_imp_convergent:
  fixes M_seq :: "nat \<Rightarrow> complex Matrix.mat" and r :: nat
  assumes carrier: "\<forall>n. M_seq n \<in> carrier_mat r r"
      and hs_cauchy: "\<forall>\<epsilon>>0. \<exists>N. \<forall>x \<ge> N. \<forall>y \<ge> N.
                                hs_norm (M_seq x - M_seq y) < \<epsilon>"
  shows "\<exists>M_lim. M_lim \<in> carrier_mat r r
              \<and> (\<forall>\<epsilon>>0. \<exists>N. \<forall>n \<ge> N. hs_norm (M_seq n - M_lim) < \<epsilon>)"
proof -
  text \<open>Step 1: each entry sequence is Cauchy in \<complex>.\<close>
  have entry_cauchy:
    "\<And>i j. i < r \<Longrightarrow> j < r \<Longrightarrow> Cauchy (\<lambda>n. M_seq n $$ (i,j))"
    by (rule HS_Cauchy_entry_Cauchy[OF carrier hs_cauchy _ _ refl])

  text \<open>Step 2: each entry sequence converges (\<complex> is complete).\<close>
  have lim_exists:
    "\<And>i j. i < r \<Longrightarrow> j < r \<Longrightarrow> \<exists>L. (\<lambda>n. M_seq n $$ (i,j)) \<longlonglongrightarrow> L"
    using entry_cauchy Cauchy_convergent unfolding convergent_def by metis

  text \<open>Step 3: define the limit matrix entry-wise.\<close>
  define L :: "nat \<Rightarrow> nat \<Rightarrow> complex" where
    "L i j = (SOME L. (\<lambda>n. M_seq n $$ (i,j)) \<longlonglongrightarrow> L)" for i j
  define M_lim where "M_lim = Matrix.mat r r (\<lambda>(i,j). L i j)"
  have M_lim_c: "M_lim \<in> carrier_mat r r"
    unfolding M_lim_def by simp

  have entry_lim:
    "\<And>i j. i < r \<Longrightarrow> j < r
            \<Longrightarrow> (\<lambda>n. M_seq n $$ (i,j)) \<longlonglongrightarrow> M_lim $$ (i,j)"
  proof -
    fix i j assume i: "i < r" and j: "j < r"
    have entry_eq: "M_lim $$ (i,j) = L i j"
      unfolding M_lim_def using i j by simp
    have "(\<lambda>n. M_seq n $$ (i,j)) \<longlonglongrightarrow> L i j"
      unfolding L_def
      by (rule someI_ex[OF lim_exists[OF i j]])
    thus "(\<lambda>n. M_seq n $$ (i,j)) \<longlonglongrightarrow> M_lim $$ (i,j)"
      using entry_eq by simp
  qed

  text \<open>Step 4: HS-convergence to \<open>M_lim\<close>.\<close>
  have conv: "\<forall>\<epsilon>>0. \<exists>N. \<forall>n \<ge> N. hs_norm (M_seq n - M_lim) < \<epsilon>"
  proof (intro allI impI)
    fix \<epsilon> :: real assume \<epsilon>_pos: "0 < \<epsilon>"
    show "\<exists>N. \<forall>n \<ge> N. hs_norm (M_seq n - M_lim) < \<epsilon>"
    proof (cases "r = 0")
      case True
      text \<open>For \<open>r = 0\<close>, every matrix is \<open>0\<times>0\<close> and HS norm is 0.\<close>
      have hs_zero: "\<And>n. hs_norm (M_seq n - M_lim) = 0"
      proof -
        fix n :: nat
        have Mn_dr: "dim_row (M_seq n) = 0" using carrier True by auto
        have Mn_dc: "dim_col (M_seq n) = 0" using carrier True by auto
        have ML_dr: "dim_row M_lim = 0" using M_lim_c True by auto
        have ML_dc: "dim_col M_lim = 0" using M_lim_c True by auto
        have D_dr: "dim_row (M_seq n - M_lim) = 0"
          using ML_dr unfolding minus_mat_def by simp
        have D_dc: "dim_col (M_seq n - M_lim) = 0"
          using ML_dc unfolding minus_mat_def by simp
        have "\<langle>\<langle> M_seq n - M_lim | M_seq n - M_lim \<rangle>\<rangle> = 0"
          unfolding hs_inner_prod_def using D_dr D_dc by simp
        thus "hs_norm (M_seq n - M_lim) = 0"
          unfolding hs_norm_def by simp
      qed
      show ?thesis using hs_zero \<epsilon>_pos by auto
    next
      case False
      hence r_pos: "0 < r" by simp
      define \<delta> where "\<delta> = \<epsilon> / (2 * (real r + 1))"
      have \<delta>_pos: "0 < \<delta>"
        unfolding \<delta>_def using \<epsilon>_pos by (simp add: divide_pos_pos)
      text \<open>For each \<open>(i,j)\<close> there's an \<open>N\<^sub>{i,j}\<close> guaranteeing entry-closeness.\<close>
      have entry_close:
        "\<And>i j. i < r \<Longrightarrow> j < r
              \<Longrightarrow> \<exists>N. \<forall>n \<ge> N. cmod (M_seq n $$ (i,j) - M_lim $$ (i,j)) < \<delta>"
      proof -
        fix i j assume i: "i < r" and j: "j < r"
        have lim: "(\<lambda>n. M_seq n $$ (i,j)) \<longlonglongrightarrow> M_lim $$ (i,j)"
          by (rule entry_lim[OF i j])
        from lim \<delta>_pos
        obtain N where N_bd:
          "\<forall>n \<ge> N. dist (M_seq n $$ (i,j)) (M_lim $$ (i,j)) < \<delta>"
          unfolding lim_sequentially by blast
        have "\<forall>n \<ge> N. cmod (M_seq n $$ (i,j) - M_lim $$ (i,j)) < \<delta>"
          using N_bd by (simp add: dist_complex_def)
        thus "\<exists>N. \<forall>n \<ge> N. cmod (M_seq n $$ (i,j) - M_lim $$ (i,j)) < \<delta>"
          by blast
      qed
      text \<open>Pick \<open>N\<^sub>{i,j}\<close> for each \<open>(i,j)\<close> via \<open>bchoice\<close>, then
      take \<open>N\<close> = \<open>Max\<close>.\<close>
      let ?Idx = "{(i,j) | i j. i < r \<and> j < r}"
      have I_finite: "finite ?Idx"
      proof -
        have eq: "?Idx = (\<lambda>(i,j). (i,j)) ` ({..<r} \<times> {..<r})" by auto
        thus ?thesis by simp
      qed
      have N_choice:
        "\<forall>x \<in> ?Idx. \<exists>N. \<forall>n \<ge> N.
            cmod (M_seq n $$ (fst x, snd x) - M_lim $$ (fst x, snd x)) < \<delta>"
      proof
        fix x assume x_in: "x \<in> ?Idx"
        then obtain i j where xij: "x = (i,j)" and i: "i < r" and j: "j < r"
          by blast
        have "\<exists>N. \<forall>n \<ge> N. cmod (M_seq n $$ (i,j) - M_lim $$ (i,j)) < \<delta>"
          by (rule entry_close[OF i j])
        thus "\<exists>N. \<forall>n \<ge> N.
              cmod (M_seq n $$ (fst x, snd x) - M_lim $$ (fst x, snd x)) < \<delta>"
          using xij by simp
      qed
      from bchoice[OF N_choice]
      obtain N_fn :: "nat \<times> nat \<Rightarrow> nat" where
        N_fn_bd: "\<forall>x \<in> ?Idx. \<forall>n \<ge> N_fn x.
            cmod (M_seq n $$ (fst x, snd x) - M_lim $$ (fst x, snd x)) < \<delta>"
        by blast
      text \<open>Take a uniform N as the max of the finite family of \<open>N_fn\<close>.\<close>
      text \<open>Use the (finite) sum of all \<open>N_fn\<close> values as a uniform bound.\<close>
      have I_finite_set: "finite ?Idx" by (rule I_finite)
      have x_in: "\<And>i j. i < r \<Longrightarrow> j < r \<Longrightarrow> (i,j) \<in> ?Idx" by blast
      have Nbar_bd_each:
        "\<And>i j. i < r \<Longrightarrow> j < r \<Longrightarrow>
            \<forall>n \<ge> sum N_fn ?Idx.
                cmod (M_seq n $$ (i,j) - M_lim $$ (i,j)) < \<delta>"
      proof -
        fix i j assume i: "i < r" and j: "j < r"
        have ij_in: "(i,j) \<in> ?Idx" using x_in[OF i j] .
        have N_fn_le: "N_fn (i,j) \<le> sum N_fn ?Idx"
          by (rule member_le_sum[OF ij_in _ I_finite_set]) auto
        show "\<forall>n \<ge> sum N_fn ?Idx.
                cmod (M_seq n $$ (i,j) - M_lim $$ (i,j)) < \<delta>"
        proof (intro allI impI)
          fix n assume n_ge: "n \<ge> sum N_fn ?Idx"
          hence "n \<ge> N_fn (i,j)" using N_fn_le by simp
          thus "cmod (M_seq n $$ (i,j) - M_lim $$ (i,j)) < \<delta>"
            using N_fn_bd ij_in by simp
        qed
      qed

      text \<open>For \<open>n \<ge> sum N_fn ?Idx\<close>, bound the HS norm by \<open>\<epsilon>\<close>.\<close>
      show "\<exists>N. \<forall>n \<ge> N. hs_norm (M_seq n - M_lim) < \<epsilon>"
      proof (rule exI[of _ "sum N_fn ?Idx"], intro allI impI)
        fix n assume n_ge: "n \<ge> sum N_fn ?Idx"
        let ?D = "M_seq n - M_lim"
        have Mn_c: "M_seq n \<in> carrier_mat r r" using carrier by simp
        have D_c: "?D \<in> carrier_mat r r"
          by (rule minus_carrier_mat[OF M_lim_c])
        have D_dr: "dim_row ?D = r" using D_c by auto
        have D_dc: "dim_col ?D = r" using D_c by auto
        have entry_diff:
          "\<And>i j. i < r \<Longrightarrow> j < r
                \<Longrightarrow> ?D $$ (i,j) = M_seq n $$ (i,j) - M_lim $$ (i,j)"
        proof -
          fix i j assume i: "i < r" and j: "j < r"
          have ML_dr: "dim_row M_lim = r" using M_lim_c by auto
          have ML_dc: "dim_col M_lim = r" using M_lim_c by auto
          have "?D $$ (i,j)
                  = Matrix.mat (dim_row M_lim) (dim_col M_lim)
                      (\<lambda>ij. M_seq n $$ ij - M_lim $$ ij) $$ (i,j)"
            unfolding minus_mat_def by simp
          also have "\<dots> = M_seq n $$ (i,j) - M_lim $$ (i,j)"
            using i j ML_dr ML_dc by simp
          finally show "?D $$ (i,j) = M_seq n $$ (i,j) - M_lim $$ (i,j)" .
        qed
        have entry_lt: "\<And>i j. i < r \<Longrightarrow> j < r
                              \<Longrightarrow> cmod (?D $$ (i,j)) < \<delta>"
          using Nbar_bd_each n_ge entry_diff by simp
        text \<open>HS norm squared = sum of cmod-squared entries.\<close>
        have hs_sq_eq: "(hs_norm ?D)\<^sup>2
                          = (\<Sum>i\<in>{0..<r}. \<Sum>j\<in>{0..<r}.
                                (cmod (?D $$ (i,j)))\<^sup>2)"
        proof -
          have "(hs_norm ?D)\<^sup>2 = Re (\<langle>\<langle> ?D | ?D \<rangle>\<rangle>)" by (rule hs_norm_sq)
          also have "\<dots> = (\<Sum>i\<in>{0..<r}. \<Sum>j\<in>{0..<r}.
                              (cmod (?D $$ (i,j)))\<^sup>2)"
          proof -
            have body_eq:
              "\<And>i j. i \<in> {0..<r} \<Longrightarrow> j \<in> {0..<r} \<Longrightarrow>
                Re (cnj (?D $$ (i,j)) * ?D $$ (i,j)) = (cmod (?D $$ (i,j)))\<^sup>2"
            proof -
              fix i j assume "i \<in> {0..<r}" "j \<in> {0..<r}"
              let ?z = "?D $$ (i,j)"
              have e1: "cnj ?z * ?z = ?z * cnj ?z" by (simp add: mult.commute)
              have e2: "?z * cnj ?z = complex_of_real ((cmod ?z)\<^sup>2)"
                using complex_norm_square[of ?z, symmetric] by simp
              show "Re (cnj ?z * ?z) = (cmod ?z)\<^sup>2"
                using e1 e2 by simp
            qed
            have "Re (\<langle>\<langle> ?D | ?D \<rangle>\<rangle>)
                    = Re (\<Sum>i\<in>{0..<r}. \<Sum>j\<in>{0..<r}.
                              cnj (?D $$ (i,j)) * ?D $$ (i,j))"
              unfolding hs_inner_prod_def using D_dr D_dc by simp
            also have "\<dots> = (\<Sum>i\<in>{0..<r}. \<Sum>j\<in>{0..<r}.
                                Re (cnj (?D $$ (i,j)) * ?D $$ (i,j)))"
              by (simp add: Re_sum)
            also have "\<dots> = (\<Sum>i\<in>{0..<r}. \<Sum>j\<in>{0..<r}.
                                (cmod (?D $$ (i,j)))\<^sup>2)"
            proof (intro sum.cong refl)
              fix i j assume i_in: "i \<in> {0..<r}" and j_in: "j \<in> {0..<r}"
              show "Re (cnj (?D $$ (i,j)) * ?D $$ (i,j))
                      = (cmod (?D $$ (i,j)))\<^sup>2"
                by (rule body_eq[OF i_in j_in])
            qed
            finally show ?thesis .
          qed
          finally show ?thesis .
        qed
        text \<open>Bound by \<open>r\<^sup>2 \<delta>\<^sup>2\<close>.\<close>
        have entry_sq_lt:
          "\<And>i j. i < r \<Longrightarrow> j < r \<Longrightarrow> (cmod (?D $$ (i,j)))\<^sup>2 < \<delta>\<^sup>2"
        proof -
          fix i j assume i: "i < r" and j: "j < r"
          have lt: "cmod (?D $$ (i,j)) < \<delta>" using entry_lt[OF i j] .
          have nn: "0 \<le> cmod (?D $$ (i,j))" by simp
          show "(cmod (?D $$ (i,j)))\<^sup>2 < \<delta>\<^sup>2"
            using lt nn \<delta>_pos by (intro power_strict_mono) auto
        qed
        have inner_sum_bound:
          "\<And>i. i < r \<Longrightarrow> (\<Sum>j\<in>{0..<r}. (cmod (?D $$ (i,j)))\<^sup>2)
                          < (\<Sum>j\<in>{0..<r}. \<delta>\<^sup>2)"
        proof -
          fix i assume i: "i < r"
          show "(\<Sum>j\<in>{0..<r}. (cmod (?D $$ (i,j)))\<^sup>2)
                  < (\<Sum>j\<in>{0..<r}. \<delta>\<^sup>2)"
          proof (rule sum_strict_mono)
            show "finite {0..<r}" by simp
            show "{0..<r} \<noteq> {}" using r_pos by simp
            show "\<And>a. a \<in> {0..<r}
                    \<Longrightarrow> (cmod (?D $$ (i,a)))\<^sup>2 < \<delta>\<^sup>2"
            proof -
              fix a assume a_in: "a \<in> {0..<r}"
              hence a: "a < r" by simp
              show "(cmod (?D $$ (i,a)))\<^sup>2 < \<delta>\<^sup>2"
                by (rule entry_sq_lt[OF i a])
            qed
          qed
        qed
        have outer_sum_bound:
          "(\<Sum>i\<in>{0..<r}. \<Sum>j\<in>{0..<r}. (cmod (?D $$ (i,j)))\<^sup>2)
              < (\<Sum>i\<in>{0..<r}. \<Sum>j\<in>{0..<r}. \<delta>\<^sup>2)"
        proof (rule sum_strict_mono)
          show "finite {0..<r}" by simp
          show "{0..<r} \<noteq> {}" using r_pos by simp
          show "\<And>a. a \<in> {0..<r} \<Longrightarrow>
                  (\<Sum>j\<in>{0..<r}. (cmod (?D $$ (a,j)))\<^sup>2)
                    < (\<Sum>j\<in>{0..<r}. \<delta>\<^sup>2)"
          proof -
            fix a assume a_in: "a \<in> {0..<r}"
            hence a: "a < r" by simp
            show "(\<Sum>j\<in>{0..<r}. (cmod (?D $$ (a,j)))\<^sup>2)
                    < (\<Sum>j\<in>{0..<r}. \<delta>\<^sup>2)"
              by (rule inner_sum_bound[OF a])
          qed
        qed
        have const_sum: "(\<Sum>i\<in>{0..<r}. \<Sum>j\<in>{0..<r}. \<delta>\<^sup>2)
                          = real r * real r * \<delta>\<^sup>2"
          by simp
        have hs_sq_lt: "(hs_norm ?D)\<^sup>2 < real r * real r * \<delta>\<^sup>2"
          using hs_sq_eq outer_sum_bound const_sum by simp
        text \<open>And \<open>r * \<delta> < \<epsilon>\<close>.\<close>
        have r_le_r1: "real r \<le> 2 * (real r + 1)" by simp
        have r_delta_le: "real r * \<delta> \<le> \<epsilon> / 2"
          unfolding \<delta>_def
          using \<epsilon>_pos r_le_r1
          by (simp add: divide_le_eq mult_left_mono pos_le_divide_eq)
        have r_delta_lt: "real r * \<delta> < \<epsilon>"
          using r_delta_le \<epsilon>_pos by linarith
        have r_delta_nn: "0 \<le> real r * \<delta>" using \<delta>_pos by simp
        have rsq_dsq: "(real r * \<delta>)\<^sup>2 < \<epsilon>\<^sup>2"
          using r_delta_lt r_delta_nn by (intro power_strict_mono) auto
        have rsq_dsq_eq: "(real r * \<delta>)\<^sup>2 = real r * real r * \<delta>\<^sup>2"
          by (simp add: power2_eq_square algebra_simps)
        have hs_sq_lt_eps: "(hs_norm ?D)\<^sup>2 < \<epsilon>\<^sup>2"
          using hs_sq_lt rsq_dsq rsq_dsq_eq by linarith
        have eps_nn: "0 \<le> \<epsilon>" using \<epsilon>_pos by simp
        show "hs_norm ?D < \<epsilon>"
          by (rule power_less_imp_less_base[OF hs_sq_lt_eps eps_nn])
      qed
    qed
  qed

  show ?thesis using M_lim_c conv by blast
qed

(* Step 5d (closest-point existence) — assembly. *)

lemma exists_closest_point_in_separable_cone:
  fixes m p :: nat and \<rho> :: "complex Matrix.mat"
  assumes \<rho>_c: "\<rho> \<in> carrier_mat (m*p) (m*p)"
      and m_pos: "0 < m" and p_pos: "0 < p"
  shows "\<exists>p_star. separable_cone m p p_star
            \<and> (\<forall>q. separable_cone m p q
                    \<longrightarrow> hs_norm (\<rho> - p_star) \<le> hs_norm (\<rho> - q))"
proof -
  text \<open>Step 1: minimizing sequence.\<close>
  obtain q\<^sub>n where seq_cone: "\<forall>n. separable_cone m p (q\<^sub>n n)"
              and seq_bd: "\<forall>n. hs_norm (\<rho> - q\<^sub>n n)
                                  < Inf (cone_dist_set m p \<rho>)
                                    + 1 / (real n + 1)"
    using cone_dist_minimizing_sequence by metis
  have seq_carrier: "\<forall>n. q\<^sub>n n \<in> carrier_mat (m*p) (m*p)"
    using seq_cone unfolding separable_cone_def by auto

  text \<open>Step 2: HS-Cauchy.\<close>
  have hs_cauchy:
    "\<forall>\<epsilon>>0. \<exists>N. \<forall>x \<ge> N. \<forall>y \<ge> N. hs_norm (q\<^sub>n x - q\<^sub>n y) < \<epsilon>"
    by (rule minimizing_sequence_HS_Cauchy[OF \<rho>_c seq_cone seq_bd m_pos p_pos])

  text \<open>Step 3: HS-convergent (uses sorried completeness).\<close>
  obtain p_star where p_star_c: "p_star \<in> carrier_mat (m*p) (m*p)"
                  and p_star_lim: "\<forall>\<epsilon>>0. \<exists>N. \<forall>n \<ge> N.
                                          hs_norm (q\<^sub>n n - p_star) < \<epsilon>"
    using HS_Cauchy_imp_convergent[OF seq_carrier hs_cauchy]
    by blast

  text \<open>Step 4: \<open>p_star \<in> cone\<close> by closedness.\<close>
  have lim_zero: "(\<lambda>n. hs_norm (q\<^sub>n n - p_star)) \<longlonglongrightarrow> 0"
    unfolding lim_sequentially
  proof (intro allI impI)
    fix \<epsilon> :: real assume \<epsilon>_pos: "0 < \<epsilon>"
    obtain N where N_bd: "\<forall>n \<ge> N. hs_norm (q\<^sub>n n - p_star) < \<epsilon>"
      using p_star_lim \<epsilon>_pos by blast
    show "\<exists>N. \<forall>n \<ge> N. dist (hs_norm (q\<^sub>n n - p_star)) 0 < \<epsilon>"
    proof (rule exI[of _ N], intro allI impI)
      fix n assume "n \<ge> N"
      hence "hs_norm (q\<^sub>n n - p_star) < \<epsilon>" using N_bd by simp
      moreover have "0 \<le> hs_norm (q\<^sub>n n - p_star)" by (rule hs_norm_nonneg)
      ultimately show "dist (hs_norm (q\<^sub>n n - p_star)) 0 < \<epsilon>"
        by (simp add: dist_real_def)
    qed
  qed
  have p_star_cone: "separable_cone m p p_star"
    using separable_cone_HS_closed[OF m_pos p_pos] seq_cone p_star_c lim_zero
    by blast

  text \<open>Step 5: \<open>hs_norm (\<rho> - p_star) \<le> Inf cone_dist_set\<close>.
  For each \<open>\<epsilon> > 0\<close>, pick \<open>n\<close> large enough that
  \<open>hs_norm (q\<^sub>n n - p_star) < \<epsilon>/2\<close> and \<open>1/(n+1) < \<epsilon>/2\<close>;
  triangle inequality gives
  \<open>hs_norm (\<rho> - p_star) \<le> hs_norm (\<rho> - q\<^sub>n n)
                          + hs_norm (q\<^sub>n n - p_star) < D + \<epsilon>\<close>.
  Taking \<open>\<epsilon> \<to> 0\<close> closes.\<close>
  have D_le: "hs_norm (\<rho> - p_star) \<le> Inf (cone_dist_set m p \<rho>)"
  proof (rule field_le_epsilon)
    fix \<epsilon> :: real assume \<epsilon>_pos: "0 < \<epsilon>"
    let ?D = "Inf (cone_dist_set m p \<rho>)"
    obtain N1 where N1_bd:
      "\<forall>n \<ge> N1. hs_norm (q\<^sub>n n - p_star) < \<epsilon>/2"
      using p_star_lim \<epsilon>_pos by (auto dest: spec[where x="\<epsilon>/2"])
    obtain N2 where N2_big: "real N2 > 2/\<epsilon>"
      using reals_Archimedean2[of "2/\<epsilon>"] by blast
    have N2_plus1_big: "real N2 + 1 > 2/\<epsilon>" using N2_big by linarith
    have N2_recip: "1 / (real N2 + 1) < \<epsilon>/2"
    proof -
      have N2_pos: "0 < real N2 + 1" by simp
      have ratio_pos: "0 < 2 / \<epsilon>" using \<epsilon>_pos by simp
      have "(real N2 + 1) * \<epsilon> > 2"
        using N2_plus1_big \<epsilon>_pos
        by (simp add: pos_divide_less_eq mult.commute)
      hence "1 / (real N2 + 1) < \<epsilon> / 2"
        using N2_pos \<epsilon>_pos
        by (simp add: less_divide_eq pos_less_divide_eq field_simps)
      thus ?thesis .
    qed
    let ?n = "max N1 N2"
    have qn_close: "hs_norm (q\<^sub>n ?n - p_star) < \<epsilon>/2"
      using N1_bd by simp
    have rho_qn_close: "hs_norm (\<rho> - q\<^sub>n ?n) < ?D + \<epsilon>/2"
    proof -
      have "hs_norm (\<rho> - q\<^sub>n ?n) < ?D + 1 / (real ?n + 1)"
        using seq_bd by simp
      moreover have "1 / (real ?n + 1) \<le> 1 / (real N2 + 1)"
        by (auto simp: divide_left_mono)
      ultimately have "hs_norm (\<rho> - q\<^sub>n ?n) < ?D + 1 / (real N2 + 1)"
        by linarith
      thus ?thesis using N2_recip by linarith
    qed
    text \<open>Triangle: \<open>\<rho> - p_star = (\<rho> - q\<^sub>n ?n) + (q\<^sub>n ?n - p_star)\<close>.\<close>
    let ?qN = "q\<^sub>n ?n"
    have qN_c: "?qN \<in> carrier_mat (m*p) (m*p)" using seq_carrier by simp
    have rho_minus_pstar_eq:
      "\<rho> - p_star = (\<rho> - ?qN) + (?qN - p_star)"
      using \<rho>_c qN_c p_star_c
      by (intro eq_matI) (auto simp: minus_mat_def)
    have triangle: "hs_norm (\<rho> - p_star)
                      \<le> hs_norm (\<rho> - ?qN) + hs_norm (?qN - p_star)"
    proof -
      have rho_qN_c: "\<rho> - ?qN \<in> carrier_mat (m*p) (m*p)"
        by (rule minus_carrier_mat[OF qN_c])
      have qN_p_c: "?qN - p_star \<in> carrier_mat (m*p) (m*p)"
        by (rule minus_carrier_mat[OF p_star_c])
      have "hs_norm (\<rho> - p_star)
              = hs_norm ((\<rho> - ?qN) + (?qN - p_star))"
        using rho_minus_pstar_eq by simp
      also have "\<dots> \<le> hs_norm (\<rho> - ?qN) + hs_norm (?qN - p_star)"
        by (rule hs_norm_triangle[OF rho_qN_c qN_p_c])
      finally show ?thesis .
    qed
    show "hs_norm (\<rho> - p_star) \<le> ?D + \<epsilon>"
      using triangle rho_qn_close qn_close by linarith
  qed

  text \<open>Step 6: For any \<open>q \<in> cone\<close>, \<open>Inf \<le> hs_norm (\<rho> - q)\<close>.\<close>
  have inf_le_q: "\<forall>q. separable_cone m p q
                       \<longrightarrow> Inf (cone_dist_set m p \<rho>) \<le> hs_norm (\<rho> - q)"
  proof (intro allI impI)
    fix q assume q_cone: "separable_cone m p q"
    have q_in: "hs_norm (\<rho> - q) \<in> cone_dist_set m p \<rho>"
      unfolding cone_dist_set_def using q_cone by blast
    show "Inf (cone_dist_set m p \<rho>) \<le> hs_norm (\<rho> - q)"
      by (rule cInf_lower[OF q_in cone_dist_set_bdd_below])
  qed

  text \<open>Combine: \<open>hs_norm (\<rho> - p_star) \<le> hs_norm (\<rho> - q)\<close> for all
  \<open>q \<in> cone\<close>.\<close>
  have all_q: "\<forall>q. separable_cone m p q
                    \<longrightarrow> hs_norm (\<rho> - p_star) \<le> hs_norm (\<rho> - q)"
    using D_le inf_le_q by (auto intro: order_trans)

  show ?thesis using p_star_cone all_q by blast
qed

(* Cone separator from closest point.

   Pure inner-product geometry: for σ in cone, the ray
   \<open>p_star + t(σ - p_star)\<close> is in the cone for \<open>t \<in> [0,1]\<close>;
   the closest-point inequality at any \<open>t > 0\<close> forces
   \<open>Re \<langle>\<langle>\<rho>-p_star | \<sigma>-p_star\<rangle>\<rangle> \<le> 0\<close>.  Specialising to \<sigma> = 0 and
   \<sigma> = 2 p_star then gives \<open>Re \<langle>\<langle>\<rho>-p_star | p_star\<rangle>\<rangle> = 0\<close>, and
   \<open>Re \<langle>\<langle>\<rho>-p_star | \<rho>\<rangle>\<rangle> = \<parallel>\<rho>-p_star\<parallel>\<^sup>2 > 0\<close>.  Setting \<open>a = p_star - \<rho>\<close>
   flips the signs to the desired form. *)

lemma cone_separator_from_closest_point:
  fixes m p :: nat and \<rho> p_star :: "complex Matrix.mat"
  assumes \<rho>_c: "\<rho> \<in> carrier_mat (m*p) (m*p)"
      and \<rho>_nonsep: "\<not> separable_cone m p \<rho>"
      and p_star_cone: "separable_cone m p p_star"
      and p_star_min: "\<forall>q. separable_cone m p q
                          \<longrightarrow> hs_norm (\<rho> - p_star) \<le> hs_norm (\<rho> - q)"
      and m_pos: "0 < m" and p_pos: "0 < p"
  shows "\<exists>a. a \<in> carrier_mat (m*p) (m*p)
            \<and> Re (\<langle>\<langle> a | \<rho> \<rangle>\<rangle>) < 0
            \<and> (\<forall>\<sigma>. separable_cone m p \<sigma>
                    \<longrightarrow> 0 \<le> Re (\<langle>\<langle> a | \<sigma> \<rangle>\<rangle>))"
proof -
  have p_star_c: "p_star \<in> carrier_mat (m*p) (m*p)"
    using p_star_cone unfolding separable_cone_def by auto
  let ?Xdiff = "\<rho> - p_star"
  let ?aSep = "p_star - \<rho>"
  have Xdiff_c: "?Xdiff \<in> carrier_mat (m*p) (m*p)" using \<rho>_c p_star_c by auto
  have aSep_c: "?aSep \<in> carrier_mat (m*p) (m*p)" using \<rho>_c p_star_c by auto

  text \<open>Key inequality from minimality: for any \<sigma> in cone,
  \<open>Re \<langle>\<langle>?Xdiff | \<sigma> - p_star\<rangle>\<rangle> \<le> 0\<close>.\<close>
  have key: "\<And>\<sigma>. separable_cone m p \<sigma>
              \<Longrightarrow> Re (\<langle>\<langle> ?Xdiff | \<sigma> - p_star \<rangle>\<rangle>) \<le> 0"
  proof -
    fix \<sigma> assume \<sigma>_cone: "separable_cone m p \<sigma>"
    have \<sigma>_c: "\<sigma> \<in> carrier_mat (m*p) (m*p)"
      using \<sigma>_cone unfolding separable_cone_def by auto
    let ?Ydiff = "\<sigma> - p_star"
    have Ydiff_c: "?Ydiff \<in> carrier_mat (m*p) (m*p)"
      using \<sigma>_c p_star_c by auto
    let ?nval = "Re (\<langle>\<langle> ?Ydiff | ?Ydiff \<rangle>\<rangle>)"
    let ?cval = "Re (\<langle>\<langle> ?Xdiff | ?Ydiff \<rangle>\<rangle>)"
    have nval_nn: "0 \<le> ?nval" by (rule hs_inner_prod_self_nonneg)

    text \<open>Convex combinations \<open>q\<^sub>t = (1-t) p_star + t \<sigma>\<close> are in the
    cone for \<open>t \<in> [0,1]\<close>.\<close>
    have qt_cone: "\<And>t. 0 \<le> t \<Longrightarrow> t \<le> 1
                    \<Longrightarrow> separable_cone m p
                          (complex_of_real t \<cdot>\<^sub>m \<sigma>
                            + complex_of_real (1-t) \<cdot>\<^sub>m p_star)"
    proof -
      fix t :: real assume t_nn: "0 \<le> t" and t_le: "t \<le> 1"
      have part1: "separable_cone m p (complex_of_real t \<cdot>\<^sub>m \<sigma>)"
        by (rule separable_cone_smult[OF \<sigma>_cone t_nn m_pos p_pos])
      have one_t_nn: "0 \<le> 1 - t" using t_le by simp
      have part2: "separable_cone m p (complex_of_real (1-t) \<cdot>\<^sub>m p_star)"
        by (rule separable_cone_smult[OF p_star_cone one_t_nn m_pos p_pos])
      show "separable_cone m p (complex_of_real t \<cdot>\<^sub>m \<sigma>
                                + complex_of_real (1-t) \<cdot>\<^sub>m p_star)"
        by (rule separable_cone_add[OF part1 part2])
    qed

    text \<open>Expand \<open>\<rho> - q\<^sub>t = ?Xdiff + (-t) \<cdot>\<^sub>m ?Ydiff\<close>.\<close>
    have rho_minus_qt:
      "\<And>t. \<rho> - (complex_of_real t \<cdot>\<^sub>m \<sigma>
                  + complex_of_real (1-t) \<cdot>\<^sub>m p_star)
           = ?Xdiff + complex_of_real (-t) \<cdot>\<^sub>m ?Ydiff"
    proof -
      fix t :: real
      show "\<rho> - (complex_of_real t \<cdot>\<^sub>m \<sigma>
                  + complex_of_real (1-t) \<cdot>\<^sub>m p_star)
           = ?Xdiff + complex_of_real (-t) \<cdot>\<^sub>m ?Ydiff"
      proof (intro eq_matI)
        show "dim_row (\<rho> - (complex_of_real t \<cdot>\<^sub>m \<sigma>
                              + complex_of_real (1-t) \<cdot>\<^sub>m p_star))
                = dim_row (?Xdiff + complex_of_real (-t) \<cdot>\<^sub>m ?Ydiff)"
          using \<rho>_c \<sigma>_c p_star_c by auto
        show "dim_col (\<rho> - (complex_of_real t \<cdot>\<^sub>m \<sigma>
                              + complex_of_real (1-t) \<cdot>\<^sub>m p_star))
                = dim_col (?Xdiff + complex_of_real (-t) \<cdot>\<^sub>m ?Ydiff)"
          using \<rho>_c \<sigma>_c p_star_c by auto
        fix i j
        assume hi: "i < dim_row (?Xdiff + complex_of_real (-t) \<cdot>\<^sub>m ?Ydiff)"
        assume hj: "j < dim_col (?Xdiff + complex_of_real (-t) \<cdot>\<^sub>m ?Ydiff)"
        have i: "i < m*p" using hi Xdiff_c Ydiff_c by auto
        have j: "j < m*p" using hj Xdiff_c Ydiff_c by auto
        show "(\<rho> - (complex_of_real t \<cdot>\<^sub>m \<sigma>
                       + complex_of_real (1-t) \<cdot>\<^sub>m p_star)) $$ (i, j)
                = (?Xdiff + complex_of_real (-t) \<cdot>\<^sub>m ?Ydiff) $$ (i, j)"
          using i j \<rho>_c \<sigma>_c p_star_c
          by (simp add: minus_mat_def algebra_simps)
      qed
    qed

    text \<open>Constraint from minimality of \<open>p_star\<close>.\<close>
    have constraint: "\<And>t. 0 \<le> t \<Longrightarrow> t \<le> 1 \<Longrightarrow> 2*t*?cval \<le> t\<^sup>2*?nval"
    proof -
      fix t :: real assume t_nn: "0 \<le> t" and t_le: "t \<le> 1"
      let ?qt = "complex_of_real t \<cdot>\<^sub>m \<sigma>
                  + complex_of_real (1-t) \<cdot>\<^sub>m p_star"
      have qt_cone': "separable_cone m p ?qt"
        using qt_cone t_nn t_le by simp
      have norm_ineq: "hs_norm (\<rho> - p_star) \<le> hs_norm (\<rho> - ?qt)"
        using p_star_min qt_cone' by simp
      have nn1: "0 \<le> hs_norm (\<rho> - p_star)" by (simp add: hs_norm_nonneg)
      have sq_le: "(hs_norm (\<rho> - p_star))\<^sup>2 \<le> (hs_norm (\<rho> - ?qt))\<^sup>2"
        using norm_ineq nn1 by (simp add: power_mono)
      have eq1: "(hs_norm (\<rho> - p_star))\<^sup>2 = Re (\<langle>\<langle> ?Xdiff | ?Xdiff \<rangle>\<rangle>)"
        by (rule hs_norm_sq)
      have eq2: "(hs_norm (\<rho> - ?qt))\<^sup>2
                  = Re (\<langle>\<langle> ?Xdiff | ?Xdiff \<rangle>\<rangle>) - 2*t*?cval + t\<^sup>2*?nval"
        using rho_minus_qt[of t]
              hs_norm_sq_diff_expand[OF Xdiff_c Ydiff_c, of t]
        by simp
      from sq_le eq1 eq2 show "2*t*?cval \<le> t\<^sup>2*?nval" by simp
    qed

    text \<open>Conclude \<open>?cval \<le> 0\<close> by choosing a small \<open>t\<close>.\<close>
    show "?cval \<le> 0"
    proof (rule ccontr)
      assume "\<not> ?cval \<le> 0"
      then have c_pos: "0 < ?cval" by simp
      let ?t = "min 1 (?cval / (?nval + 1))"
      have nn1_pos: "0 < ?nval + 1" using nval_nn by simp
      have t_pos: "0 < ?t" using c_pos nn1_pos by (simp add: min_def)
      have t_nn: "0 \<le> ?t" using t_pos by simp
      have t_le: "?t \<le> 1" by (simp add: min_def)
      from constraint[OF t_nn t_le] have ineq: "2*?t*?cval \<le> ?t\<^sup>2*?nval" .
      have t_le_c_n1: "?t \<le> ?cval / (?nval + 1)" by simp
      have step_a: "?t * ?nval \<le> ?cval"
      proof -
        have a1: "?t * ?nval \<le> (?cval / (?nval + 1)) * ?nval"
          by (rule mult_right_mono[OF t_le_c_n1 nval_nn])
        have a2: "(?cval / (?nval + 1)) * ?nval
                    = ?cval * (?nval / (?nval + 1))" by simp
        have ratio_le_1: "?nval / (?nval + 1) \<le> 1"
          using nval_nn nn1_pos by (simp add: divide_le_eq_1)
        have a3a: "?cval * (?nval / (?nval + 1)) \<le> ?cval * 1"
          using ratio_le_1 c_pos
          by (intro mult_left_mono) (simp_all add: less_imp_le)
        have a3b: "?cval * 1 = ?cval" by simp
        from a1 a2 a3a a3b show ?thesis by linarith
      qed
      have sq_eq: "?t\<^sup>2 * ?nval = ?t * (?t * ?nval)"
        by (simp add: power2_eq_square)
      have sq_le: "?t * (?t * ?nval) \<le> ?t * ?cval"
        using step_a t_nn by (rule mult_left_mono)
      have chain1: "?t\<^sup>2 * ?nval \<le> ?t * ?cval"
      proof -
        have "?t\<^sup>2 * ?nval = ?t * (?t * ?nval)" by (rule sq_eq)
        also have "?t * (?t * ?nval) \<le> ?t * ?cval" by (rule sq_le)
        finally show ?thesis .
      qed
      have chain2: "2 * ?t * ?cval \<le> ?t * ?cval"
        using ineq chain1 by linarith
      have small: "?t * ?cval \<le> 0" using chain2 by linarith
      have big: "0 < ?t * ?cval" using t_pos c_pos by simp
      from small big show False by linarith
    qed
  qed

  text \<open>Set \<open>?bval = Re \<langle>\<langle>?Xdiff | p_star\<rangle>\<rangle>\<close>; show \<open>?bval = 0\<close>.\<close>
  let ?bval = "Re (\<langle>\<langle> ?Xdiff | p_star \<rangle>\<rangle>)"
  have apply_zero:
    "Re (\<langle>\<langle> ?Xdiff | (0\<^sub>m (m*p) (m*p) :: complex Matrix.mat) - p_star \<rangle>\<rangle>)
        \<le> 0"
    using key[OF separable_cone_zero] by simp
  have b_ge: "0 \<le> ?bval"
  proof -
    have eq: "(0\<^sub>m (m*p) (m*p) :: complex Matrix.mat) - p_star
                = complex_of_real (-1) \<cdot>\<^sub>m p_star"
      using p_star_c by (intro eq_matI) (auto simp: minus_mat_def)
    have "Re (\<langle>\<langle> ?Xdiff | (0\<^sub>m (m*p) (m*p) :: complex Matrix.mat) - p_star \<rangle>\<rangle>)
            = Re (\<langle>\<langle> ?Xdiff | complex_of_real (-1) \<cdot>\<^sub>m p_star \<rangle>\<rangle>)"
      using eq by simp
    also have "\<dots> = (-1) * ?bval"
      by (rule Re_hs_inner_prod_right_smult_real)
         (use Xdiff_c p_star_c in auto)
    finally have "(-1) * ?bval \<le> 0" using apply_zero by simp
    thus ?thesis by simp
  qed
  have two_p_cone: "separable_cone m p (complex_of_real 2 \<cdot>\<^sub>m p_star)"
    by (rule separable_cone_smult[OF p_star_cone _ m_pos p_pos]) simp
  have b_le: "?bval \<le> 0"
  proof -
    have eq: "complex_of_real 2 \<cdot>\<^sub>m p_star - p_star = p_star"
      using p_star_c by (intro eq_matI) (auto simp: minus_mat_def)
    have "Re (\<langle>\<langle> ?Xdiff | complex_of_real 2 \<cdot>\<^sub>m p_star - p_star \<rangle>\<rangle>) \<le> 0"
      using key[OF two_p_cone] .
    thus ?thesis using eq by simp
  qed
  have b_eq: "?bval = 0" using b_ge b_le by linarith

  text \<open>Conclude positivity of \<open>?aSep\<close> on cone.\<close>
  have a_pos: "\<forall>\<sigma>. separable_cone m p \<sigma>
                  \<longrightarrow> 0 \<le> Re (\<langle>\<langle> ?aSep | \<sigma> \<rangle>\<rangle>)"
  proof (intro allI impI)
    fix \<sigma> assume \<sigma>_cone: "separable_cone m p \<sigma>"
    have \<sigma>_c: "\<sigma> \<in> carrier_mat (m*p) (m*p)"
      using \<sigma>_cone unfolding separable_cone_def by auto
    have IP_split: "\<langle>\<langle> ?Xdiff | \<sigma> - p_star \<rangle>\<rangle>
                     = \<langle>\<langle> ?Xdiff | \<sigma> \<rangle>\<rangle> + \<langle>\<langle> ?Xdiff | - p_star \<rangle>\<rangle>"
    proof -
      have d1r: "dim_row \<sigma> = dim_row ?Xdiff" using \<sigma>_c Xdiff_c by auto
      have d1c: "dim_col \<sigma> = dim_col ?Xdiff" using \<sigma>_c Xdiff_c by auto
      have d2r: "dim_row (- p_star) = dim_row ?Xdiff" using p_star_c Xdiff_c by auto
      have d2c: "dim_col (- p_star) = dim_col ?Xdiff" using p_star_c Xdiff_c by auto
      have eq_minus: "\<sigma> - p_star = \<sigma> + (- p_star)"
        by (intro eq_matI) (auto simp: minus_mat_def uminus_mat_def)
      have "\<langle>\<langle> ?Xdiff | \<sigma> - p_star \<rangle>\<rangle> = \<langle>\<langle> ?Xdiff | \<sigma> + (- p_star) \<rangle>\<rangle>"
        using eq_minus by simp
      also have "\<dots> = \<langle>\<langle> ?Xdiff | \<sigma> \<rangle>\<rangle> + \<langle>\<langle> ?Xdiff | - p_star \<rangle>\<rangle>"
        by (rule hs_inner_prod_right_add[OF d1r d1c d2r d2c])
      finally show ?thesis .
    qed
    have IP_neg: "\<langle>\<langle> ?Xdiff | - p_star \<rangle>\<rangle>
                    = - \<langle>\<langle> ?Xdiff | p_star \<rangle>\<rangle>"
    proof -
      have eq_smult: "- p_star = complex_of_real (-1) \<cdot>\<^sub>m p_star"
        using p_star_c by (intro eq_matI) (auto simp: uminus_mat_def)
      have "\<langle>\<langle> ?Xdiff | - p_star \<rangle>\<rangle>
              = \<langle>\<langle> ?Xdiff | complex_of_real (-1) \<cdot>\<^sub>m p_star \<rangle>\<rangle>"
        using eq_smult by simp
      also have "\<dots> = complex_of_real (-1) * \<langle>\<langle> ?Xdiff | p_star \<rangle>\<rangle>"
        by (intro hs_inner_prod_right_smult)
           (use Xdiff_c p_star_c in auto)
      finally show ?thesis by simp
    qed
    have step_eq: "Re (\<langle>\<langle> ?Xdiff | \<sigma> - p_star \<rangle>\<rangle>)
                     = Re (\<langle>\<langle> ?Xdiff | \<sigma> \<rangle>\<rangle>) - ?bval"
      using IP_split IP_neg by simp
    have key_use: "Re (\<langle>\<langle> ?Xdiff | \<sigma> - p_star \<rangle>\<rangle>) \<le> 0"
      by (rule key[OF \<sigma>_cone])
    have X_le: "Re (\<langle>\<langle> ?Xdiff | \<sigma> \<rangle>\<rangle>) \<le> 0"
      using step_eq key_use b_eq by simp
    have a_eq: "Re (\<langle>\<langle> ?aSep | \<sigma> \<rangle>\<rangle>) = - Re (\<langle>\<langle> ?Xdiff | \<sigma> \<rangle>\<rangle>)"
    proof -
      have a_eq_smult: "?aSep = complex_of_real (-1) \<cdot>\<^sub>m ?Xdiff"
        using \<rho>_c p_star_c
        by (intro eq_matI)
           (auto simp: minus_mat_def uminus_mat_def)
      have "Re (\<langle>\<langle> ?aSep | \<sigma> \<rangle>\<rangle>)
              = Re (\<langle>\<langle> complex_of_real (-1) \<cdot>\<^sub>m ?Xdiff | \<sigma> \<rangle>\<rangle>)"
        using a_eq_smult by simp
      also have "\<dots> = Re (cnj (complex_of_real (-1)) * \<langle>\<langle> ?Xdiff | \<sigma> \<rangle>\<rangle>)"
        using Xdiff_c \<sigma>_c
        by (subst hs_inner_prod_left_smult) auto
      finally show ?thesis by simp
    qed
    show "0 \<le> Re (\<langle>\<langle> ?aSep | \<sigma> \<rangle>\<rangle>)" using a_eq X_le by simp
  qed

  text \<open>Strict negativity at \<rho>: \<open>Re \<langle>\<langle>?aSep | \<rho>\<rangle>\<rangle> = -\<parallel>?Xdiff\<parallel>\<^sup>2 < 0\<close>.\<close>
  have X_nz: "?Xdiff \<noteq> 0\<^sub>m (m*p) (m*p)"
  proof
    assume zero: "?Xdiff = 0\<^sub>m (m*p) (m*p)"
    have ps_dr: "dim_row p_star = m*p" using p_star_c by auto
    have ps_dc: "dim_col p_star = m*p" using p_star_c by auto
    have rho_dr: "dim_row \<rho> = m*p" using \<rho>_c by auto
    have rho_dc: "dim_col \<rho> = m*p" using \<rho>_c by auto
    have "\<rho> = p_star"
    proof (intro eq_matI)
      show "dim_row \<rho> = dim_row p_star" using rho_dr ps_dr by simp
      show "dim_col \<rho> = dim_col p_star" using rho_dc ps_dc by simp
      fix i j
      assume i: "i < dim_row p_star" and j: "j < dim_col p_star"
      have im: "i < m*p" using i ps_dr by simp
      have jm: "j < m*p" using j ps_dc by simp
      have "?Xdiff $$ (i,j) = \<rho> $$ (i,j) - p_star $$ (i,j)"
        using im jm \<rho>_c p_star_c by (simp add: minus_mat_def)
      moreover have "?Xdiff $$ (i,j) = 0"
        using zero im jm by simp
      ultimately show "\<rho> $$ (i,j) = p_star $$ (i,j)" by simp
    qed
    thus False using \<rho>_nonsep p_star_cone by simp
  qed
  have X_self_pos: "0 < Re (\<langle>\<langle> ?Xdiff | ?Xdiff \<rangle>\<rangle>)"
  proof -
    have X_dr: "dim_row ?Xdiff = m*p" using Xdiff_c by auto
    have X_dc: "dim_col ?Xdiff = m*p" using Xdiff_c by auto
    have nn: "0 \<le> Re (\<langle>\<langle> ?Xdiff | ?Xdiff \<rangle>\<rangle>)" by (rule hs_inner_prod_self_nonneg)
    have neq_zero: "\<langle>\<langle> ?Xdiff | ?Xdiff \<rangle>\<rangle> \<noteq> 0"
    proof
      assume "\<langle>\<langle> ?Xdiff | ?Xdiff \<rangle>\<rangle> = 0"
      hence "?Xdiff = 0\<^sub>m (dim_row ?Xdiff) (dim_col ?Xdiff)"
        using hs_inner_prod_self_zero_iff by simp
      hence "?Xdiff = 0\<^sub>m (m*p) (m*p)" using X_dr X_dc by simp
      thus False using X_nz by simp
    qed
    have "Re (\<langle>\<langle> ?Xdiff | ?Xdiff \<rangle>\<rangle>) \<noteq> 0"
    proof
      assume re_zero: "Re (\<langle>\<langle> ?Xdiff | ?Xdiff \<rangle>\<rangle>) = 0"
      have e1: "\<langle>\<langle> ?Xdiff | ?Xdiff \<rangle>\<rangle>
                  = complex_of_real (Re (\<langle>\<langle> ?Xdiff | ?Xdiff \<rangle>\<rangle>))"
        by (rule hs_inner_prod_self_eq_of_real)
      from e1 re_zero have "\<langle>\<langle> ?Xdiff | ?Xdiff \<rangle>\<rangle> = 0" by simp
      thus False using neq_zero by simp
    qed
    thus ?thesis using nn by linarith
  qed
  have a_neg: "Re (\<langle>\<langle> ?aSep | \<rho> \<rangle>\<rangle>) < 0"
  proof -
    have rho_eq: "\<rho> = ?Xdiff + p_star"
      using \<rho>_c p_star_c
      by (intro eq_matI) (auto simp: minus_mat_def)
    have d1r: "dim_row ?Xdiff = dim_row ?Xdiff" by simp
    have d1c: "dim_col ?Xdiff = dim_col ?Xdiff" by simp
    have d2r: "dim_row p_star = dim_row ?Xdiff" using p_star_c Xdiff_c by auto
    have d2c: "dim_col p_star = dim_col ?Xdiff" using p_star_c Xdiff_c by auto
    have "\<langle>\<langle> ?Xdiff | \<rho> \<rangle>\<rangle> = \<langle>\<langle> ?Xdiff | ?Xdiff + p_star \<rangle>\<rangle>"
      using rho_eq by simp
    also have "\<dots> = \<langle>\<langle> ?Xdiff | ?Xdiff \<rangle>\<rangle> + \<langle>\<langle> ?Xdiff | p_star \<rangle>\<rangle>"
      by (rule hs_inner_prod_right_add[OF d1r d1c d2r d2c])
    finally have "Re (\<langle>\<langle> ?Xdiff | \<rho> \<rangle>\<rangle>) = Re (\<langle>\<langle> ?Xdiff | ?Xdiff \<rangle>\<rangle>) + ?bval"
      by simp
    hence X_rho: "Re (\<langle>\<langle> ?Xdiff | \<rho> \<rangle>\<rangle>) = Re (\<langle>\<langle> ?Xdiff | ?Xdiff \<rangle>\<rangle>)"
      using b_eq by simp
    have a_eq_smult: "?aSep = complex_of_real (-1) \<cdot>\<^sub>m ?Xdiff"
      using \<rho>_c p_star_c
      by (intro eq_matI) (auto simp: minus_mat_def uminus_mat_def)
    have "Re (\<langle>\<langle> ?aSep | \<rho> \<rangle>\<rangle>)
            = Re (\<langle>\<langle> complex_of_real (-1) \<cdot>\<^sub>m ?Xdiff | \<rho> \<rangle>\<rangle>)"
      using a_eq_smult by simp
    also have "\<dots> = Re (cnj (complex_of_real (-1)) * \<langle>\<langle> ?Xdiff | \<rho> \<rangle>\<rangle>)"
      using Xdiff_c \<rho>_c
      by (subst hs_inner_prod_left_smult) auto
    also have "\<dots> = - Re (\<langle>\<langle> ?Xdiff | \<rho> \<rangle>\<rangle>)" by simp
    finally have "Re (\<langle>\<langle> ?aSep | \<rho> \<rangle>\<rangle>) = - Re (\<langle>\<langle> ?Xdiff | ?Xdiff \<rangle>\<rangle>)"
      using X_rho by simp
    thus ?thesis using X_self_pos by simp
  qed

  show ?thesis using aSep_c a_neg a_pos by blast
qed

(* Step 5g: Hermitian part of an arbitrary matrix \<open>A\<close> is
   \<open>(A + A\<^sup>\<dagger>)/2\<close>; for Hermitian \<sigma>, \<open>Re Tr (A \<sigma>) = Re Tr (Aherm \<sigma>)\<close>. *)

definition hermitian_part :: "complex Matrix.mat \<Rightarrow> complex Matrix.mat" where
  "hermitian_part A
     = complex_of_real (1/2) \<cdot>\<^sub>m A + complex_of_real (1/2) \<cdot>\<^sub>m (A\<^sup>\<dagger>)"

lemma hermitian_part_carrier:
  assumes "A \<in> carrier_mat n n"
  shows "hermitian_part A \<in> carrier_mat n n"
  using assms unfolding hermitian_part_def by auto

lemma hermitian_part_hermitian:
  assumes A_c: "A \<in> carrier_mat n n"
  shows "hermitian (hermitian_part A)"
proof -
  have dr: "dim_row A = n" and dc: "dim_col A = n" using A_c by auto
  have d_dr: "dim_row (A\<^sup>\<dagger>) = n" using A_c by auto
  have d_dc: "dim_col (A\<^sup>\<dagger>) = n" using A_c by auto
  have hp_dr: "dim_row (hermitian_part A) = n"
    unfolding hermitian_part_def using dr d_dr by simp
  have hp_dc: "dim_col (hermitian_part A) = n"
    unfolding hermitian_part_def using dc d_dc by simp
  show ?thesis
    unfolding hermitian_def
  proof (intro eq_matI)
    show "dim_row ((hermitian_part A)\<^sup>\<dagger>) = dim_row (hermitian_part A)"
      using hp_dr hp_dc by simp
    show "dim_col ((hermitian_part A)\<^sup>\<dagger>) = dim_col (hermitian_part A)"
      using hp_dr hp_dc by simp
    fix i j
    assume i: "i < dim_row (hermitian_part A)"
    assume j: "j < dim_col (hermitian_part A)"
    have iN: "i < n" using i hp_dr by simp
    have jN: "j < n" using j hp_dc by simp
    have lhs: "(hermitian_part A)\<^sup>\<dagger> $$ (i, j)
                 = cnj ((hermitian_part A) $$ (j, i))"
      using iN jN hp_dr hp_dc unfolding dagger_def by simp
    also have "(hermitian_part A) $$ (j, i)
                 = complex_of_real (1/2) * A $$ (j, i)
                   + complex_of_real (1/2) * (A\<^sup>\<dagger>) $$ (j, i)"
      unfolding hermitian_part_def using iN jN dr dc d_dr d_dc by simp
    also have "(A\<^sup>\<dagger>) $$ (j, i) = cnj (A $$ (i, j))"
      using iN jN dr dc unfolding dagger_def by simp
    finally have lhs2: "(hermitian_part A)\<^sup>\<dagger> $$ (i, j)
                          = complex_of_real (1/2) * cnj (A $$ (j, i))
                            + complex_of_real (1/2) * A $$ (i, j)"
      by simp
    have rhs: "(hermitian_part A) $$ (i, j)
                = complex_of_real (1/2) * A $$ (i, j)
                  + complex_of_real (1/2) * (A\<^sup>\<dagger>) $$ (i, j)"
      unfolding hermitian_part_def using iN jN dr dc d_dr d_dc by simp
    also have "(A\<^sup>\<dagger>) $$ (i, j) = cnj (A $$ (j, i))"
      using iN jN dr dc unfolding dagger_def by simp
    finally have rhs2: "(hermitian_part A) $$ (i, j)
                          = complex_of_real (1/2) * A $$ (i, j)
                            + complex_of_real (1/2) * cnj (A $$ (j, i))" .
    show "(hermitian_part A)\<^sup>\<dagger> $$ (i, j) = (hermitian_part A) $$ (i, j)"
      using lhs2 rhs2 by (simp add: add.commute)
  qed
qed

(* Helper: Tr of dagger is conjugate of Tr (for square matrices). *)

lemma Tr_dagger:
  fixes M :: "complex Matrix.mat"
  assumes M_c: "M \<in> carrier_mat n n"
  shows "Tr (M\<^sup>\<dagger>) = cnj (Tr M)"
proof -
  have dr: "dim_row M = n" and dc: "dim_col M = n" using M_c by auto
  have d_dr: "dim_row (M\<^sup>\<dagger>) = n" using dc by simp
  have d_dc: "dim_col (M\<^sup>\<dagger>) = n" using dr by simp
  have "Tr (M\<^sup>\<dagger>) = (\<Sum>r<n. (M\<^sup>\<dagger>) $$ (r,r))"
    unfolding Tr_def using d_dr d_dc by simp
  also have "\<dots> = (\<Sum>r<n. cnj (M $$ (r,r)))"
    using dr dc unfolding dagger_def by simp
  also have "\<dots> = cnj (\<Sum>r<n. M $$ (r,r))" by simp
  also have "\<dots> = cnj (Tr M)"
    unfolding Tr_def using dr dc by simp
  finally show ?thesis .
qed

(* Helper: trace of a product (X) * c·M = c * Tr(X * M) for square X, M. *)

lemma Tr_smult_mat:
  fixes M :: "complex Matrix.mat" and c :: complex
  assumes M_c: "M \<in> carrier_mat n n"
  shows "Tr (c \<cdot>\<^sub>m M) = c * Tr M"
proof -
  have dr: "dim_row M = n" and dc: "dim_col M = n" using M_c by auto
  have "Tr (c \<cdot>\<^sub>m M) = (\<Sum>r<n. (c \<cdot>\<^sub>m M) $$ (r,r))"
    unfolding Tr_def using dr dc by simp
  also have "\<dots> = (\<Sum>r<n. c * M $$ (r,r))"
    using dr dc by (intro sum.cong refl) simp
  also have "\<dots> = c * (\<Sum>r<n. M $$ (r,r))"
    by (simp add: sum_distrib_left)
  also have "\<dots> = c * Tr M"
    unfolding Tr_def using dr dc by simp
  finally show ?thesis .
qed

lemma Re_Tr_hermitian_part_eq:
  fixes A \<sigma> :: "complex Matrix.mat"
  assumes A_c: "A \<in> carrier_mat n n"
      and \<sigma>_c: "\<sigma> \<in> carrier_mat n n"
      and \<sigma>_h: "hermitian \<sigma>"
  shows "Re (Tr (hermitian_part A * \<sigma>)) = Re (Tr (A * \<sigma>))"
proof -
  let ?Ad = "A\<^sup>\<dagger>"
  have Ad_c: "?Ad \<in> carrier_mat n n" using A_c by auto
  have A\<sigma>_c: "A * \<sigma> \<in> carrier_mat n n" using A_c \<sigma>_c by auto
  have Ad\<sigma>_c: "?Ad * \<sigma> \<in> carrier_mat n n" using Ad_c \<sigma>_c by auto
  have h2A_c: "complex_of_real (1/2) \<cdot>\<^sub>m A \<in> carrier_mat n n" using A_c by auto
  have h2Ad_c: "complex_of_real (1/2) \<cdot>\<^sub>m ?Ad \<in> carrier_mat n n" using Ad_c by auto
  text \<open>Step 1: distribute hermitian_part * \<sigma>.\<close>
  have step1: "hermitian_part A * \<sigma>
                  = complex_of_real (1/2) \<cdot>\<^sub>m (A * \<sigma>)
                    + complex_of_real (1/2) \<cdot>\<^sub>m (?Ad * \<sigma>)"
  proof -
    have part1: "(complex_of_real (1/2) \<cdot>\<^sub>m A
                   + complex_of_real (1/2) \<cdot>\<^sub>m ?Ad) * \<sigma>
                   = complex_of_real (1/2) \<cdot>\<^sub>m A * \<sigma>
                     + complex_of_real (1/2) \<cdot>\<^sub>m ?Ad * \<sigma>"
      using h2A_c h2Ad_c \<sigma>_c by (rule add_mult_distrib_mat)
    have part2: "complex_of_real (1/2) \<cdot>\<^sub>m A * \<sigma>
                   = complex_of_real (1/2) \<cdot>\<^sub>m (A * \<sigma>)"
      by (rule mult_smult_assoc_mat[OF A_c \<sigma>_c])
    have part3: "complex_of_real (1/2) \<cdot>\<^sub>m ?Ad * \<sigma>
                   = complex_of_real (1/2) \<cdot>\<^sub>m (?Ad * \<sigma>)"
      by (rule mult_smult_assoc_mat[OF Ad_c \<sigma>_c])
    show ?thesis
      using part1 part2 part3 unfolding hermitian_part_def by simp
  qed
  text \<open>Step 2: trace is linear over the sum.\<close>
  have step2: "Tr (hermitian_part A * \<sigma>)
                  = complex_of_real (1/2) * Tr (A * \<sigma>)
                    + complex_of_real (1/2) * Tr (?Ad * \<sigma>)"
  proof -
    have h2A\<sigma>_c: "complex_of_real (1/2) \<cdot>\<^sub>m (A * \<sigma>) \<in> carrier_mat n n"
      using A\<sigma>_c by auto
    have h2Ad\<sigma>_c: "complex_of_real (1/2) \<cdot>\<^sub>m (?Ad * \<sigma>) \<in> carrier_mat n n"
      using Ad\<sigma>_c by auto
    have d1r: "dim_row (complex_of_real (1/2) \<cdot>\<^sub>m (A * \<sigma>)) = n" using h2A\<sigma>_c by auto
    have d1c: "dim_col (complex_of_real (1/2) \<cdot>\<^sub>m (A * \<sigma>)) = n" using h2A\<sigma>_c by auto
    have d2r: "dim_row (complex_of_real (1/2) \<cdot>\<^sub>m (?Ad * \<sigma>)) = n" using h2Ad\<sigma>_c by auto
    have d2c: "dim_col (complex_of_real (1/2) \<cdot>\<^sub>m (?Ad * \<sigma>)) = n" using h2Ad\<sigma>_c by auto
    have add_eq: "Tr (complex_of_real (1/2) \<cdot>\<^sub>m (A * \<sigma>)
                       + complex_of_real (1/2) \<cdot>\<^sub>m (?Ad * \<sigma>))
                    = Tr (complex_of_real (1/2) \<cdot>\<^sub>m (A * \<sigma>))
                      + Tr (complex_of_real (1/2) \<cdot>\<^sub>m (?Ad * \<sigma>))"
      unfolding Tr_def using d1r d1c d2r d2c by (simp add: sum.distrib)
    have smult_eq1: "Tr (complex_of_real (1/2) \<cdot>\<^sub>m (A * \<sigma>))
                       = complex_of_real (1/2) * Tr (A * \<sigma>)"
      by (rule Tr_smult_mat[OF A\<sigma>_c])
    have smult_eq2: "Tr (complex_of_real (1/2) \<cdot>\<^sub>m (?Ad * \<sigma>))
                       = complex_of_real (1/2) * Tr (?Ad * \<sigma>)"
      by (rule Tr_smult_mat[OF Ad\<sigma>_c])
    have "Tr (hermitian_part A * \<sigma>)
            = Tr (complex_of_real (1/2) \<cdot>\<^sub>m (A * \<sigma>)
                   + complex_of_real (1/2) \<cdot>\<^sub>m (?Ad * \<sigma>))"
      using step1 by simp
    also have "\<dots> = Tr (complex_of_real (1/2) \<cdot>\<^sub>m (A * \<sigma>))
                    + Tr (complex_of_real (1/2) \<cdot>\<^sub>m (?Ad * \<sigma>))"
      using add_eq .
    also have "\<dots> = complex_of_real (1/2) * Tr (A * \<sigma>)
                    + complex_of_real (1/2) * Tr (?Ad * \<sigma>)"
      unfolding smult_eq1 smult_eq2 ..
    finally show ?thesis .
  qed
  text \<open>Step 3: \<open>Tr(A\<^sup>\<dagger> \<sigma>) = cnj (Tr(A \<sigma>))\<close> for hermitian \<sigma>.\<close>
  have step3: "Tr (?Ad * \<sigma>) = cnj (Tr (A * \<sigma>))"
  proof -
    have dim_match: "dim_col A = dim_row \<sigma>" using A_c \<sigma>_c by auto
    have "(A * \<sigma>)\<^sup>\<dagger> = \<sigma>\<^sup>\<dagger> * ?Ad"
      by (rule dagger_of_prod[OF dim_match])
    also have "\<sigma>\<^sup>\<dagger> = \<sigma>" using \<sigma>_h unfolding hermitian_def by simp
    finally have dag_eq: "(A * \<sigma>)\<^sup>\<dagger> = \<sigma> * ?Ad" .
    have cyc: "Tr (\<sigma> * ?Ad) = Tr (?Ad * \<sigma>)"
    proof (rule Tr_cyclic)
      show "dim_col \<sigma> = dim_row ?Ad" using \<sigma>_c Ad_c by auto
      show "dim_row \<sigma> = dim_col ?Ad" using \<sigma>_c Ad_c by auto
    qed
    have "Tr (?Ad * \<sigma>) = Tr (\<sigma> * ?Ad)" using cyc by simp
    also have "\<dots> = Tr ((A * \<sigma>)\<^sup>\<dagger>)" using dag_eq by simp
    also have "\<dots> = cnj (Tr (A * \<sigma>))" by (rule Tr_dagger[OF A\<sigma>_c])
    finally show ?thesis .
  qed
  text \<open>Step 4: combine.\<close>
  have "Re (Tr (hermitian_part A * \<sigma>))
           = Re (complex_of_real (1/2) * Tr (A * \<sigma>)
                  + complex_of_real (1/2) * Tr (?Ad * \<sigma>))"
    using step2 by simp
  also have "\<dots> = (1/2) * Re (Tr (A * \<sigma>)) + (1/2) * Re (Tr (?Ad * \<sigma>))"
    by simp
  also have "\<dots> = (1/2) * Re (Tr (A * \<sigma>)) + (1/2) * Re (cnj (Tr (A * \<sigma>)))"
    using step3 by simp
  also have "\<dots> = Re (Tr (A * \<sigma>))" by simp
  finally show ?thesis .
qed

(* Step 5h: relate Re \<langle>\<langle>a|\<sigma>\<rangle>\<rangle> to Re Tr(W * \<sigma>) for Hermitian W. *)

lemma Re_hs_inner_eq_Re_Tr_dagger:
  fixes A B :: "complex Matrix.mat"
  assumes A_c: "A \<in> carrier_mat n n"
      and B_c: "B \<in> carrier_mat n n"
  shows "Re (\<langle>\<langle> A | B \<rangle>\<rangle>) = Re (Tr ((A\<^sup>\<dagger>) * B))"
  using A_c B_c hs_inner_prod_as_trace by auto

(* Assembly of the geometric Hahn-Banach. *)

lemma separable_cone_separating_hyperplane:
  fixes m p :: nat and \<rho> :: "complex Matrix.mat"
  assumes \<rho>_c: "\<rho> \<in> carrier_mat (m*p) (m*p)"
      and \<rho>_h: "hermitian \<rho>"
      and \<rho>_nonsep: "\<not> separable_cone m p \<rho>"
      and m_pos: "0 < m" and p_pos: "0 < p"
  shows "\<exists>W. W \<in> carrier_mat (m*p) (m*p) \<and> hermitian W
            \<and> (\<forall>\<sigma>. separable_cone m p \<sigma>
                    \<longrightarrow> 0 \<le> Re (Tr (W * \<sigma>)))
            \<and> Re (Tr (W * \<rho>)) < 0"
proof -
  obtain p_star where p_star_cone: "separable_cone m p p_star"
              and p_star_min: "\<forall>q. separable_cone m p q
                              \<longrightarrow> hs_norm (\<rho> - p_star) \<le> hs_norm (\<rho> - q)"
    using exists_closest_point_in_separable_cone[OF \<rho>_c m_pos p_pos] by blast
  obtain a where a_c: "a \<in> carrier_mat (m*p) (m*p)"
             and a_neg: "Re (\<langle>\<langle> a | \<rho> \<rangle>\<rangle>) < 0"
             and a_pos: "\<forall>\<sigma>. separable_cone m p \<sigma>
                              \<longrightarrow> 0 \<le> Re (\<langle>\<langle> a | \<sigma> \<rangle>\<rangle>)"
    using cone_separator_from_closest_point
            [OF \<rho>_c \<rho>_nonsep p_star_cone p_star_min m_pos p_pos]
    by blast
  let ?A = "a\<^sup>\<dagger>"
  have A_c: "?A \<in> carrier_mat (m*p) (m*p)" using a_c by auto
  let ?W = "hermitian_part ?A"
  have W_c: "?W \<in> carrier_mat (m*p) (m*p)"
    by (rule hermitian_part_carrier[OF A_c])
  have W_h: "hermitian ?W"
    by (rule hermitian_part_hermitian[OF A_c])
  text \<open>Translate the inner-product inequalities to \<open>Re Tr (?W \<cdot>)\<close>.\<close>
  have W_pos: "\<forall>\<sigma>. separable_cone m p \<sigma>
                  \<longrightarrow> 0 \<le> Re (Tr (?W * \<sigma>))"
  proof (intro allI impI)
    fix \<sigma> assume \<sigma>_cone: "separable_cone m p \<sigma>"
    from \<sigma>_cone have \<sigma>_c: "\<sigma> \<in> carrier_mat (m*p) (m*p)"
      unfolding separable_cone_def by auto
    have \<sigma>_psd: "psd \<sigma>"
      by (rule separable_cone_psd[OF \<sigma>_cone m_pos p_pos])
    have \<sigma>_h: "hermitian \<sigma>" by (rule psd_hermitian[OF \<sigma>_psd])
    have eq1: "Re (\<langle>\<langle> a | \<sigma> \<rangle>\<rangle>) = Re (Tr (?A * \<sigma>))"
      by (rule Re_hs_inner_eq_Re_Tr_dagger[OF a_c \<sigma>_c])
    have eq2: "Re (Tr (?A * \<sigma>)) = Re (Tr (?W * \<sigma>))"
      using Re_Tr_hermitian_part_eq[OF A_c \<sigma>_c \<sigma>_h] by simp
    show "0 \<le> Re (Tr (?W * \<sigma>))"
      using a_pos[rule_format, OF \<sigma>_cone] eq1 eq2 by simp
  qed
  have W_neg: "Re (Tr (?W * \<rho>)) < 0"
  proof -
    have eq1: "Re (\<langle>\<langle> a | \<rho> \<rangle>\<rangle>) = Re (Tr (?A * \<rho>))"
      by (rule Re_hs_inner_eq_Re_Tr_dagger[OF a_c \<rho>_c])
    have eq2: "Re (Tr (?A * \<rho>)) = Re (Tr (?W * \<rho>))"
      using Re_Tr_hermitian_part_eq[OF A_c \<rho>_c \<rho>_h] by simp
    show ?thesis using a_neg eq1 eq2 by simp
  qed
  show ?thesis using W_c W_h W_pos W_neg by blast
qed

(* Step 6: a Hermitian \<open>W\<close> non-negative on the cone is an
   entanglement witness in the sense of \<open>entanglement_witness\<close>. *)

lemma cone_separator_is_witness:
  fixes m p :: nat and W :: "complex Matrix.mat"
  assumes W_c: "W \<in> carrier_mat (m*p) (m*p)"
      and W_h: "hermitian W"
      and W_cone_nonneg: "\<forall>\<sigma>. separable_cone m p \<sigma>
                              \<longrightarrow> 0 \<le> Re (Tr (W * \<sigma>))"
      and m_pos: "0 < m" and p_pos: "0 < p"
  shows "entanglement_witness m p W"
proof -
  have witness_bound:
    "\<forall>\<sigma> \<tau>. \<sigma> \<in> carrier_mat m m \<and> psd \<sigma>
              \<and> \<tau> \<in> carrier_mat p p \<and> psd \<tau>
              \<longrightarrow> 0 \<le> Re (Tr (W * (\<sigma> \<Otimes> \<tau>)))"
  proof (intro allI impI)
    fix \<sigma> \<tau>
    assume h: "\<sigma> \<in> carrier_mat m m \<and> psd \<sigma>
                \<and> \<tau> \<in> carrier_mat p p \<and> psd \<tau>"
    have \<sigma>_c: "\<sigma> \<in> carrier_mat m m" using h by simp
    have \<sigma>_psd: "psd \<sigma>" using h by simp
    have \<tau>_c: "\<tau> \<in> carrier_mat p p" using h by simp
    have \<tau>_psd: "psd \<tau>" using h by simp
    text \<open>The single product \<open>\<sigma> \<otimes> \<tau>\<close> with weight 1 is in the
    separable cone.\<close>
    let ?ts = "[(1::real, \<sigma>, \<tau>)]"
    have ts_v: "sep_cone_valid m p ?ts"
      using \<sigma>_c \<sigma>_psd \<tau>_c \<tau>_psd
      unfolding sep_cone_valid_def by simp
    have st_c: "\<sigma> \<Otimes> \<tau> \<in> carrier_mat (m*p) (m*p)"
      using \<sigma>_c \<tau>_c by auto
    have ts_eq: "sep_sum m p ?ts = \<sigma> \<Otimes> \<tau>"
    proof -
      have step1: "sep_sum m p ?ts
                    = complex_of_real 1 \<cdot>\<^sub>m (\<sigma> \<Otimes> \<tau>) + sep_sum m p []"
        by simp
      also have "\<dots> = (\<sigma> \<Otimes> \<tau>) + 0\<^sub>m (m*p) (m*p)"
        using st_c by (intro eq_matI) auto
      also have "\<dots> = \<sigma> \<Otimes> \<tau>"
        using st_c by simp
      finally show ?thesis .
    qed
    have st_cone: "separable_cone m p (\<sigma> \<Otimes> \<tau>)"
      unfolding separable_cone_def using st_c ts_v ts_eq by force
    show "0 \<le> Re (Tr (W * (\<sigma> \<Otimes> \<tau>)))"
      using W_cone_nonneg st_cone by blast
  qed
  show ?thesis
    unfolding entanglement_witness_def
    using W_c W_h witness_bound by blast
qed

(* Step 7: a density matrix is Hermitian. *)

lemma density_matrix_hermitian:
  fixes \<rho> :: "complex Matrix.mat" and n :: nat
  assumes "density_matrix n \<rho>"
  shows "hermitian \<rho>"
  using assms unfolding density_matrix_def
  by (blast dest: psd_hermitian)

(* Step 8: for trace-1 ρ in the separable cone, normalising weights
   gives a separable density decomposition. (Cone form of a density
   matrix collapses to convex form.)

   Strategy: rescale each (w, σ, τ) so σ and τ become unit-trace,
   absorbing Tr σ * Tr τ into the weight; drop terms whose σ or τ
   has trace 0 (such PSD terms must be the zero matrix). *)

(* Sub-helper 8a: a hermitian matrix has real trace. *)

lemma Tr_hermitian_real:
  assumes A_h: "hermitian A"
      and A_c: "A \<in> carrier_mat n n"
  shows "Tr A = complex_of_real (Re (Tr A))"
proof -
  have dr: "dim_row A = n" and dc: "dim_col A = n" using A_c by auto
  have diag_eq: "\<And>i. i < n \<Longrightarrow> A $$ (i,i) = cnj (A $$ (i,i))"
  proof -
    fix i assume i: "i < n"
    have "A $$ (i,i) = (A\<^sup>\<dagger>) $$ (i,i)" using A_h unfolding hermitian_def by simp
    also have "\<dots> = cnj (A $$ (i,i))"
      using i dr dc unfolding dagger_def by simp
    finally show "A $$ (i,i) = cnj (A $$ (i,i))" .
  qed
  have Im_diag: "\<And>i. i < n \<Longrightarrow> Im (A $$ (i,i)) = 0"
    using diag_eq by (simp add: complex_eq_iff)
  have "Tr A = (\<Sum>r<n. A $$ (r,r))"
    unfolding Tr_def using dr dc by simp
  hence "Im (Tr A) = (\<Sum>r<n. Im (A $$ (r,r)))"
    by (simp add: Im_sum)
  also have "\<dots> = 0" using Im_diag by simp
  finally have Im_Tr: "Im (Tr A) = 0" .
  show ?thesis by (simp add: complex_eq_iff Im_Tr)
qed

(* Sub-helper 8b: a PSD matrix with vanishing trace is the zero matrix. *)

lemma psd_Tr_zero_imp_zero:
  assumes P_psd: "psd P"
      and P_c: "P \<in> carrier_mat n n"
      and P_Tr: "Tr P = 0"
  shows "P = 0\<^sub>m n n"
proof -
  obtain Q where Q_c: "Q \<in> carrier_mat n n"
             and Q_psd: "psd Q"
             and Q_sq: "Q * Q = P"
    using psd_sqrt_exists[OF P_c P_psd] by blast
  have Q_h: "hermitian Q" by (rule psd_hermitian[OF Q_psd])
  have Q_dag: "Q\<^sup>\<dagger> = Q" using Q_h unfolding hermitian_def by simp
  have hs_eq: "\<langle>\<langle> Q | Q \<rangle>\<rangle> = Tr (Q\<^sup>\<dagger> * Q)"
    by (rule hs_inner_prod_self_as_trace)
  also have "\<dots> = Tr (Q * Q)" using Q_dag by simp
  also have "\<dots> = Tr P" using Q_sq by simp
  also have "\<dots> = 0" using P_Tr .
  finally have hs_zero: "\<langle>\<langle> Q | Q \<rangle>\<rangle> = 0" .
  have Q_dr: "dim_row Q = n" and Q_dc: "dim_col Q = n" using Q_c by auto
  have Q_entries_zero:
    "\<And>i j. i < n \<Longrightarrow> j < n \<Longrightarrow> Q $$ (i,j) = 0"
    using hs_inner_prod_eq_zero_imp[OF hs_zero] Q_dr Q_dc by simp
  have Q_zero: "Q = 0\<^sub>m n n"
    by (intro eq_matI) (auto simp: Q_dr Q_dc Q_entries_zero)
  have "P = Q * Q" using Q_sq by simp
  also have "\<dots> = 0\<^sub>m n n * 0\<^sub>m n n" using Q_zero by simp
  also have "\<dots> = 0\<^sub>m n n" by simp
  finally show ?thesis .
qed

(* Sub-helper 8c: renormalised list. Drops terms with zero-trace σ or
   τ, rescales surviving terms so σ', τ' are unit-trace. *)

definition sep_renorm ::
    "(real \<times> complex Matrix.mat \<times> complex Matrix.mat) list
       \<Rightarrow> (real \<times> complex Matrix.mat \<times> complex Matrix.mat) list"
where
  "sep_renorm ts =
     map (\<lambda>(w, \<sigma>, \<tau>).
            (w * Re (Tr \<sigma>) * Re (Tr \<tau>),
             complex_of_real (1 / Re (Tr \<sigma>)) \<cdot>\<^sub>m \<sigma>,
             complex_of_real (1 / Re (Tr \<tau>)) \<cdot>\<^sub>m \<tau>))
         (filter (\<lambda>(w, \<sigma>, \<tau>). 0 < Re (Tr \<sigma>) \<and> 0 < Re (Tr \<tau>)) ts)"

(* Helper: smult absorbs through tensor product on either side. *)

lemma tensor_mat_smult_left:
  fixes A B :: "complex Matrix.mat" and c :: complex
  assumes A_c: "A \<in> carrier_mat ra ca"
      and B_c: "B \<in> carrier_mat rb cb"
      and ra_pos: "0 < ra" and ca_pos: "0 < ca"
      and rb_pos: "0 < rb" and cb_pos: "0 < cb"
  shows "(c \<cdot>\<^sub>m A) \<Otimes> B = c \<cdot>\<^sub>m (A \<Otimes> B)"
proof (intro eq_matI)
  show "dim_row ((c \<cdot>\<^sub>m A) \<Otimes> B) = dim_row (c \<cdot>\<^sub>m (A \<Otimes> B))" using A_c B_c by simp
  show "dim_col ((c \<cdot>\<^sub>m A) \<Otimes> B) = dim_col (c \<cdot>\<^sub>m (A \<Otimes> B))" using A_c B_c by simp
  fix i j
  assume i: "i < dim_row (c \<cdot>\<^sub>m (A \<Otimes> B))"
  assume j: "j < dim_col (c \<cdot>\<^sub>m (A \<Otimes> B))"
  have i_lt: "i < ra * rb" using i A_c B_c by simp
  have j_lt: "j < ca * cb" using j A_c B_c by simp
  have idiv: "i div rb < ra" using i_lt rb_pos
    by (simp add: less_mult_imp_div_less)
  have jdiv: "j div cb < ca" using j_lt cb_pos
    by (simp add: less_mult_imp_div_less)
  have imod: "i mod rb < rb" using rb_pos by simp
  have jmod: "j mod cb < cb" using cb_pos by simp
  have lhs: "((c \<cdot>\<^sub>m A) \<Otimes> B) $$ (i,j)
                = (c \<cdot>\<^sub>m A) $$ (i div rb, j div cb)
                  * B $$ (i mod rb, j mod cb)"
    using A_c B_c i_lt j_lt ca_pos cb_pos by simp
  also have "\<dots> = c * A $$ (i div rb, j div cb) * B $$ (i mod rb, j mod cb)"
    using idiv jdiv A_c by simp
  finally have lhs': "((c \<cdot>\<^sub>m A) \<Otimes> B) $$ (i,j)
                       = c * A $$ (i div rb, j div cb) * B $$ (i mod rb, j mod cb)" .
  have rhs: "(c \<cdot>\<^sub>m (A \<Otimes> B)) $$ (i,j)
                = c * (A \<Otimes> B) $$ (i,j)"
    using i j by simp
  also have "\<dots> = c * (A $$ (i div rb, j div cb) * B $$ (i mod rb, j mod cb))"
    using A_c B_c i_lt j_lt ca_pos cb_pos by simp
  finally have rhs': "(c \<cdot>\<^sub>m (A \<Otimes> B)) $$ (i,j)
                       = c * (A $$ (i div rb, j div cb) * B $$ (i mod rb, j mod cb))" .
  show "((c \<cdot>\<^sub>m A) \<Otimes> B) $$ (i,j) = (c \<cdot>\<^sub>m (A \<Otimes> B)) $$ (i,j)"
    using lhs' rhs' by (simp add: mult.assoc)
qed

lemma tensor_mat_smult_right:
  fixes A B :: "complex Matrix.mat" and c :: complex
  assumes A_c: "A \<in> carrier_mat ra ca"
      and B_c: "B \<in> carrier_mat rb cb"
      and ra_pos: "0 < ra" and ca_pos: "0 < ca"
      and rb_pos: "0 < rb" and cb_pos: "0 < cb"
  shows "A \<Otimes> (c \<cdot>\<^sub>m B) = c \<cdot>\<^sub>m (A \<Otimes> B)"
proof (intro eq_matI)
  show "dim_row (A \<Otimes> (c \<cdot>\<^sub>m B)) = dim_row (c \<cdot>\<^sub>m (A \<Otimes> B))" using A_c B_c by simp
  show "dim_col (A \<Otimes> (c \<cdot>\<^sub>m B)) = dim_col (c \<cdot>\<^sub>m (A \<Otimes> B))" using A_c B_c by simp
  fix i j
  assume i: "i < dim_row (c \<cdot>\<^sub>m (A \<Otimes> B))"
  assume j: "j < dim_col (c \<cdot>\<^sub>m (A \<Otimes> B))"
  have i_lt: "i < ra * rb" using i A_c B_c by simp
  have j_lt: "j < ca * cb" using j A_c B_c by simp
  have idiv: "i div rb < ra" using i_lt rb_pos
    by (simp add: less_mult_imp_div_less)
  have jdiv: "j div cb < ca" using j_lt cb_pos
    by (simp add: less_mult_imp_div_less)
  have imod: "i mod rb < rb" using rb_pos by simp
  have jmod: "j mod cb < cb" using cb_pos by simp
  have lhs: "(A \<Otimes> (c \<cdot>\<^sub>m B)) $$ (i,j)
                = A $$ (i div rb, j div cb)
                  * (c \<cdot>\<^sub>m B) $$ (i mod rb, j mod cb)"
    using A_c B_c i_lt j_lt ca_pos cb_pos by simp
  also have "\<dots> = A $$ (i div rb, j div cb) * (c * B $$ (i mod rb, j mod cb))"
    using imod jmod B_c by simp
  finally have lhs': "(A \<Otimes> (c \<cdot>\<^sub>m B)) $$ (i,j)
                       = A $$ (i div rb, j div cb) * (c * B $$ (i mod rb, j mod cb))" .
  have rhs: "(c \<cdot>\<^sub>m (A \<Otimes> B)) $$ (i,j)
                = c * (A \<Otimes> B) $$ (i,j)"
    using i j by simp
  also have "\<dots> = c * (A $$ (i div rb, j div cb) * B $$ (i mod rb, j mod cb))"
    using A_c B_c i_lt j_lt ca_pos cb_pos by simp
  finally have rhs': "(c \<cdot>\<^sub>m (A \<Otimes> B)) $$ (i,j)
                       = c * (A $$ (i div rb, j div cb) * B $$ (i mod rb, j mod cb))" .
  show "(A \<Otimes> (c \<cdot>\<^sub>m B)) $$ (i,j) = (c \<cdot>\<^sub>m (A \<Otimes> B)) $$ (i,j)"
    using lhs' rhs' by (simp add: mult.assoc mult.left_commute)
qed

(* Sub-helper 8d: rescaling preserves the sum (zero-trace summands
   contribute 0 because PSD with trace 0 vanishes). *)

lemma sep_sum_renorm:
  fixes m p :: nat
      and ts :: "(real \<times> complex Matrix.mat \<times> complex Matrix.mat) list"
  assumes ts_v: "sep_cone_valid m p ts"
      and m_pos: "0 < m" and p_pos: "0 < p"
  shows "sep_sum m p ts = sep_sum m p (sep_renorm ts)"
  using ts_v
proof (induction ts)
  case Nil
  show ?case unfolding sep_renorm_def by simp
next
  case (Cons t ts)
  obtain w \<sigma> \<tau> where t_eq: "t = (w, \<sigma>, \<tau>)" by (cases t)
  from Cons.prems t_eq have w_nn: "w \<ge> 0"
                       and \<sigma>_c: "\<sigma> \<in> carrier_mat m m"
                       and \<sigma>_psd: "psd \<sigma>"
                       and \<tau>_c: "\<tau> \<in> carrier_mat p p"
                       and \<tau>_psd: "psd \<tau>"
    unfolding sep_cone_valid_def by auto
  from Cons.prems t_eq have ts_v': "sep_cone_valid m p ts"
    unfolding sep_cone_valid_def by auto
  have IH: "sep_sum m p ts = sep_sum m p (sep_renorm ts)"
    using Cons.IH ts_v' by blast
  have st_c: "\<sigma> \<Otimes> \<tau> \<in> carrier_mat (m*p) (m*p)" using \<sigma>_c \<tau>_c by auto
  have R_c: "sep_sum m p ts \<in> carrier_mat (m*p) (m*p)" by (rule sep_sum_carrier)
  have R'_c: "sep_sum m p (sep_renorm ts) \<in> carrier_mat (m*p) (m*p)"
    by (rule sep_sum_carrier)
  have \<sigma>_h: "hermitian \<sigma>" by (rule psd_hermitian[OF \<sigma>_psd])
  have \<tau>_h: "hermitian \<tau>" by (rule psd_hermitian[OF \<tau>_psd])
  have Tr\<sigma>_real: "Tr \<sigma> = complex_of_real (Re (Tr \<sigma>))"
    by (rule Tr_hermitian_real[OF \<sigma>_h \<sigma>_c])
  have Tr\<tau>_real: "Tr \<tau> = complex_of_real (Re (Tr \<tau>))"
    by (rule Tr_hermitian_real[OF \<tau>_h \<tau>_c])
  have Tr\<sigma>_nn: "0 \<le> Re (Tr \<sigma>)" by (rule Tr_psd_Re_nonneg[OF \<sigma>_psd \<sigma>_c])
  have Tr\<tau>_nn: "0 \<le> Re (Tr \<tau>)" by (rule Tr_psd_Re_nonneg[OF \<tau>_psd \<tau>_c])
  show ?case
  proof (cases "0 < Re (Tr \<sigma>) \<and> 0 < Re (Tr \<tau>)")
    case True
    define s where "s = Re (Tr \<sigma>)"
    define t where "t = Re (Tr \<tau>)"
    have s_pos: "0 < s" using True s_def by simp
    have t_pos: "0 < t" using True t_def by simp
    have s_neq: "s \<noteq> 0" using s_pos by simp
    have t_neq: "t \<noteq> 0" using t_pos by simp
    define \<sigma>' where "\<sigma>' = complex_of_real (1/s) \<cdot>\<^sub>m \<sigma>"
    define \<tau>' where "\<tau>' = complex_of_real (1/t) \<cdot>\<^sub>m \<tau>"
    have \<sigma>'_c: "\<sigma>' \<in> carrier_mat m m" using \<sigma>_c \<sigma>'_def by auto
    have \<tau>'_c: "\<tau>' \<in> carrier_mat p p" using \<tau>_c \<tau>'_def by auto
    define w' where "w' = w * s * t"
    have ren_step: "sep_renorm ((w, \<sigma>, \<tau>) # ts)
                     = (w', \<sigma>', \<tau>') # sep_renorm ts"
      using True unfolding sep_renorm_def s_def t_def \<sigma>'_def \<tau>'_def w'_def
      by simp
    have step1: "\<sigma>' \<Otimes> \<tau>' = complex_of_real (1/(s*t)) \<cdot>\<^sub>m (\<sigma> \<Otimes> \<tau>)"
    proof -
      have "\<sigma>' \<Otimes> \<tau>'
              = complex_of_real (1/s) \<cdot>\<^sub>m (\<sigma> \<Otimes> \<tau>')"
        unfolding \<sigma>'_def
        by (rule tensor_mat_smult_left[OF \<sigma>_c \<tau>'_c m_pos m_pos p_pos p_pos])
      also have "\<sigma> \<Otimes> \<tau>'
                  = complex_of_real (1/t) \<cdot>\<^sub>m (\<sigma> \<Otimes> \<tau>)"
        unfolding \<tau>'_def
        by (rule tensor_mat_smult_right[OF \<sigma>_c \<tau>_c m_pos m_pos p_pos p_pos])
      finally have "\<sigma>' \<Otimes> \<tau>'
                      = complex_of_real (1/s) \<cdot>\<^sub>m (complex_of_real (1/t)
                          \<cdot>\<^sub>m (\<sigma> \<Otimes> \<tau>))" .
      also have "\<dots> = complex_of_real (1/(s*t)) \<cdot>\<^sub>m (\<sigma> \<Otimes> \<tau>)"
        by (intro eq_matI) (auto simp: of_real_mult mult.assoc)
      finally show ?thesis .
    qed
    have summand_eq: "complex_of_real w' \<cdot>\<^sub>m (\<sigma>' \<Otimes> \<tau>')
                       = complex_of_real w \<cdot>\<^sub>m (\<sigma> \<Otimes> \<tau>)"
    proof -
      have "complex_of_real w' \<cdot>\<^sub>m (\<sigma>' \<Otimes> \<tau>')
              = complex_of_real w' \<cdot>\<^sub>m (complex_of_real (1/(s*t))
                                          \<cdot>\<^sub>m (\<sigma> \<Otimes> \<tau>))"
        using step1 by simp
      also have "\<dots> = complex_of_real (w' * (1/(s*t))) \<cdot>\<^sub>m (\<sigma> \<Otimes> \<tau>)"
        by (intro eq_matI) (auto simp: of_real_mult mult.assoc)
      also have "w' * (1/(s*t)) = w"
        unfolding w'_def using s_neq t_neq by simp
      finally show ?thesis by simp
    qed
    have "sep_sum m p ((w, \<sigma>, \<tau>) # ts)
            = complex_of_real w \<cdot>\<^sub>m (\<sigma> \<Otimes> \<tau>) + sep_sum m p ts" by simp
    also have "\<dots> = complex_of_real w' \<cdot>\<^sub>m (\<sigma>' \<Otimes> \<tau>')
                     + sep_sum m p (sep_renorm ts)"
      using summand_eq IH by simp
    also have "\<dots> = sep_sum m p ((w', \<sigma>', \<tau>') # sep_renorm ts)" by simp
    also have "\<dots> = sep_sum m p (sep_renorm ((w, \<sigma>, \<tau>) # ts))"
      using ren_step by simp
    finally show ?thesis using t_eq by simp
  next
    case False
    have "Re (Tr \<sigma>) \<le> 0 \<or> Re (Tr \<tau>) \<le> 0" using False by linarith
    then have st_zero: "\<sigma> \<Otimes> \<tau> = 0\<^sub>m (m*p) (m*p)"
    proof
      assume "Re (Tr \<sigma>) \<le> 0"
      hence "Re (Tr \<sigma>) = 0" using Tr\<sigma>_nn by simp
      hence "Tr \<sigma> = 0" using Tr\<sigma>_real by simp
      hence \<sigma>_zero: "\<sigma> = 0\<^sub>m m m" by (rule psd_Tr_zero_imp_zero[OF \<sigma>_psd \<sigma>_c])
      show "\<sigma> \<Otimes> \<tau> = 0\<^sub>m (m*p) (m*p)"
      proof (intro eq_matI)
        show "dim_row (\<sigma> \<Otimes> \<tau>) = dim_row (0\<^sub>m (m*p) (m*p))" using \<sigma>_c \<tau>_c by simp
        show "dim_col (\<sigma> \<Otimes> \<tau>) = dim_col (0\<^sub>m (m*p) (m*p))" using \<sigma>_c \<tau>_c by simp
        fix i j
        assume i: "i < dim_row (0\<^sub>m (m*p) (m*p))" and j: "j < dim_col (0\<^sub>m (m*p) (m*p))"
        have i_lt: "i < m*p" using i by simp
        have j_lt: "j < m*p" using j by simp
        have idiv: "i div p < m" using i_lt p_pos by (simp add: less_mult_imp_div_less)
        have jdiv: "j div p < m" using j_lt p_pos by (simp add: less_mult_imp_div_less)
        have "(\<sigma> \<Otimes> \<tau>) $$ (i, j)
                = \<sigma> $$ (i div p, j div p) * \<tau> $$ (i mod p, j mod p)"
          using \<sigma>_c \<tau>_c i_lt j_lt m_pos p_pos by simp
        also have "\<sigma> $$ (i div p, j div p) = 0"
          using \<sigma>_zero idiv jdiv by simp
        finally show "(\<sigma> \<Otimes> \<tau>) $$ (i, j) = 0\<^sub>m (m*p) (m*p) $$ (i, j)"
          using i j by simp
      qed
    next
      assume "Re (Tr \<tau>) \<le> 0"
      hence "Re (Tr \<tau>) = 0" using Tr\<tau>_nn by simp
      hence "Tr \<tau> = 0" using Tr\<tau>_real by simp
      hence \<tau>_zero: "\<tau> = 0\<^sub>m p p" by (rule psd_Tr_zero_imp_zero[OF \<tau>_psd \<tau>_c])
      show "\<sigma> \<Otimes> \<tau> = 0\<^sub>m (m*p) (m*p)"
      proof (intro eq_matI)
        show "dim_row (\<sigma> \<Otimes> \<tau>) = dim_row (0\<^sub>m (m*p) (m*p))" using \<sigma>_c \<tau>_c by simp
        show "dim_col (\<sigma> \<Otimes> \<tau>) = dim_col (0\<^sub>m (m*p) (m*p))" using \<sigma>_c \<tau>_c by simp
        fix i j
        assume i: "i < dim_row (0\<^sub>m (m*p) (m*p))" and j: "j < dim_col (0\<^sub>m (m*p) (m*p))"
        have i_lt: "i < m*p" using i by simp
        have j_lt: "j < m*p" using j by simp
        have imod: "i mod p < p" using p_pos by simp
        have jmod: "j mod p < p" using p_pos by simp
        have "(\<sigma> \<Otimes> \<tau>) $$ (i, j)
                = \<sigma> $$ (i div p, j div p) * \<tau> $$ (i mod p, j mod p)"
          using \<sigma>_c \<tau>_c i_lt j_lt m_pos p_pos by simp
        also have "\<tau> $$ (i mod p, j mod p) = 0"
          using \<tau>_zero imod jmod by simp
        finally show "(\<sigma> \<Otimes> \<tau>) $$ (i, j) = 0\<^sub>m (m*p) (m*p) $$ (i, j)"
          using i j by simp
      qed
    qed
    have summand_zero: "complex_of_real w \<cdot>\<^sub>m (\<sigma> \<Otimes> \<tau>) = 0\<^sub>m (m*p) (m*p)"
      using st_zero by (intro eq_matI) auto
    have ren_step: "sep_renorm ((w, \<sigma>, \<tau>) # ts) = sep_renorm ts"
      using False unfolding sep_renorm_def by simp
    have "sep_sum m p ((w, \<sigma>, \<tau>) # ts)
            = complex_of_real w \<cdot>\<^sub>m (\<sigma> \<Otimes> \<tau>) + sep_sum m p ts" by simp
    also have "\<dots> = 0\<^sub>m (m*p) (m*p) + sep_sum m p ts"
      using summand_zero by simp
    also have "\<dots> = sep_sum m p ts" using R_c by auto
    also have "\<dots> = sep_sum m p (sep_renorm ts)" using IH .
    also have "\<dots> = sep_sum m p (sep_renorm ((w, \<sigma>, \<tau>) # ts))"
      using ren_step by simp
    finally show ?thesis using t_eq by simp
  qed
qed

(* Helper: trace of sep_sum is the (complex-of-real) sum of weighted
   trace products w_i * Re(Tr σ_i) * Re(Tr τ_i). *)

lemma Tr_sep_sum_real:
  fixes m p :: nat
      and ts :: "(real \<times> complex Matrix.mat \<times> complex Matrix.mat) list"
  assumes ts_v: "sep_cone_valid m p ts"
      and m_pos: "0 < m" and p_pos: "0 < p"
  shows "Tr (sep_sum m p ts)
          = complex_of_real (\<Sum>(w, \<sigma>, \<tau>) \<leftarrow> ts. w * Re (Tr \<sigma>) * Re (Tr \<tau>))"
  using ts_v
proof (induction ts)
  case Nil
  show ?case by (simp add: Tr_def zero_mat_def)
next
  case (Cons t ts)
  obtain w \<sigma> \<tau> where t_eq: "t = (w, \<sigma>, \<tau>)" by (cases t)
  from Cons.prems t_eq have \<sigma>_c: "\<sigma> \<in> carrier_mat m m"
                       and \<sigma>_psd: "psd \<sigma>"
                       and \<tau>_c: "\<tau> \<in> carrier_mat p p"
                       and \<tau>_psd: "psd \<tau>"
    unfolding sep_cone_valid_def by auto
  from Cons.prems t_eq have ts_v': "sep_cone_valid m p ts"
    unfolding sep_cone_valid_def by auto
  have IH: "Tr (sep_sum m p ts)
              = complex_of_real (\<Sum>(w, \<sigma>, \<tau>) \<leftarrow> ts. w * Re (Tr \<sigma>) * Re (Tr \<tau>))"
    using Cons.IH ts_v' by blast
  have st_c: "\<sigma> \<Otimes> \<tau> \<in> carrier_mat (m*p) (m*p)" using \<sigma>_c \<tau>_c by auto
  have w\<sigma>\<tau>_c: "complex_of_real w \<cdot>\<^sub>m (\<sigma> \<Otimes> \<tau>) \<in> carrier_mat (m*p) (m*p)"
    using st_c by auto
  have R_c: "sep_sum m p ts \<in> carrier_mat (m*p) (m*p)" by (rule sep_sum_carrier)
  have Tr\<sigma>_real: "Tr \<sigma> = complex_of_real (Re (Tr \<sigma>))"
    by (rule Tr_hermitian_real[OF psd_hermitian[OF \<sigma>_psd] \<sigma>_c])
  have Tr\<tau>_real: "Tr \<tau> = complex_of_real (Re (Tr \<tau>))"
    by (rule Tr_hermitian_real[OF psd_hermitian[OF \<tau>_psd] \<tau>_c])
  have Tr_st: "Tr (\<sigma> \<Otimes> \<tau>) = Tr \<sigma> * Tr \<tau>"
    by (rule trace_tensor[OF \<sigma>_c \<tau>_c m_pos p_pos])
  have Tr_smult_st:
    "Tr (complex_of_real w \<cdot>\<^sub>m (\<sigma> \<Otimes> \<tau>)) = complex_of_real w * Tr (\<sigma> \<Otimes> \<tau>)"
  proof -
    have dr: "dim_row (complex_of_real w \<cdot>\<^sub>m (\<sigma> \<Otimes> \<tau>)) = m * p" using st_c by auto
    have dc: "dim_col (complex_of_real w \<cdot>\<^sub>m (\<sigma> \<Otimes> \<tau>)) = m * p" using st_c by auto
    have st_dr: "dim_row (\<sigma> \<Otimes> \<tau>) = m * p" using st_c by auto
    have st_dc: "dim_col (\<sigma> \<Otimes> \<tau>) = m * p" using st_c by auto
    have "Tr (complex_of_real w \<cdot>\<^sub>m (\<sigma> \<Otimes> \<tau>))
            = (\<Sum>r<m*p. (complex_of_real w \<cdot>\<^sub>m (\<sigma> \<Otimes> \<tau>)) $$ (r,r))"
      unfolding Tr_def using dr dc by simp
    also have "\<dots> = (\<Sum>r<m*p. complex_of_real w * (\<sigma> \<Otimes> \<tau>) $$ (r,r))"
      using st_dr st_dc by (intro sum.cong refl) simp
    also have "\<dots> = complex_of_real w * (\<Sum>r<m*p. (\<sigma> \<Otimes> \<tau>) $$ (r,r))"
      by (simp add: sum_distrib_left)
    also have "\<dots> = complex_of_real w * Tr (\<sigma> \<Otimes> \<tau>)"
      unfolding Tr_def using st_dr st_dc by simp
    finally show ?thesis .
  qed
  have Tr_w_st: "Tr (complex_of_real w \<cdot>\<^sub>m (\<sigma> \<Otimes> \<tau>))
                  = complex_of_real (w * Re (Tr \<sigma>) * Re (Tr \<tau>))"
  proof -
    have "Tr (complex_of_real w \<cdot>\<^sub>m (\<sigma> \<Otimes> \<tau>)) = complex_of_real w * Tr (\<sigma> \<Otimes> \<tau>)"
      by (rule Tr_smult_st)
    also have "\<dots> = complex_of_real w * (Tr \<sigma> * Tr \<tau>)" using Tr_st by simp
    also have "\<dots> = complex_of_real w * (complex_of_real (Re (Tr \<sigma>))
                                          * complex_of_real (Re (Tr \<tau>)))"
      using Tr\<sigma>_real Tr\<tau>_real by simp
    also have "\<dots> = complex_of_real (w * Re (Tr \<sigma>) * Re (Tr \<tau>))"
      by (simp add: of_real_mult mult.assoc)
    finally show ?thesis .
  qed
  have add_split: "Tr (complex_of_real w \<cdot>\<^sub>m (\<sigma> \<Otimes> \<tau>) + sep_sum m p ts)
                    = Tr (complex_of_real w \<cdot>\<^sub>m (\<sigma> \<Otimes> \<tau>)) + Tr (sep_sum m p ts)"
  proof -
    have dr1: "dim_row (complex_of_real w \<cdot>\<^sub>m (\<sigma> \<Otimes> \<tau>)) = m * p" using w\<sigma>\<tau>_c by auto
    have dc1: "dim_col (complex_of_real w \<cdot>\<^sub>m (\<sigma> \<Otimes> \<tau>)) = m * p" using w\<sigma>\<tau>_c by auto
    have dr2: "dim_row (sep_sum m p ts) = m * p" using R_c by auto
    have dc2: "dim_col (sep_sum m p ts) = m * p" using R_c by auto
    show ?thesis
      unfolding Tr_def using dr1 dc1 dr2 dc2 by (simp add: sum.distrib)
  qed
  have "Tr (sep_sum m p ((w, \<sigma>, \<tau>) # ts))
          = Tr (complex_of_real w \<cdot>\<^sub>m (\<sigma> \<Otimes> \<tau>) + sep_sum m p ts)" by simp
  also have "\<dots> = Tr (complex_of_real w \<cdot>\<^sub>m (\<sigma> \<Otimes> \<tau>)) + Tr (sep_sum m p ts)"
    by (rule add_split)
  also have "\<dots> = complex_of_real (w * Re (Tr \<sigma>) * Re (Tr \<tau>))
                  + complex_of_real (\<Sum>(w, \<sigma>, \<tau>) \<leftarrow> ts. w * Re (Tr \<sigma>) * Re (Tr \<tau>))"
    using Tr_w_st IH by simp
  also have "\<dots> = complex_of_real (\<Sum>(w', \<sigma>', \<tau>') \<leftarrow> ((w, \<sigma>, \<tau>) # ts). w' * Re (Tr \<sigma>') * Re (Tr \<tau>'))"
    by (simp add: of_real_add)
  finally show ?case using t_eq by simp
qed

(* Sub-helper 8e: renormalised list is sep_decomp_valid when the
   total trace of the original sum is 1. *)

lemma sep_renorm_valid:
  fixes m p :: nat
      and ts :: "(real \<times> complex Matrix.mat \<times> complex Matrix.mat) list"
  assumes ts_v: "sep_cone_valid m p ts"
      and Tr_one: "Tr (sep_sum m p ts) = 1"
      and m_pos: "0 < m" and p_pos: "0 < p"
  shows "sep_decomp_valid m p (sep_renorm ts)"
proof -
  let ?wt = "\<lambda>(w::real, \<sigma>::complex Matrix.mat, \<tau>::complex Matrix.mat).
                w * Re (Tr \<sigma>) * Re (Tr \<tau>)"
  let ?wt' = "\<lambda>(w::real, _::complex Matrix.mat, _::complex Matrix.mat). w"
  let ?keep = "\<lambda>(w::real, \<sigma>::complex Matrix.mat, \<tau>::complex Matrix.mat).
                  0 < Re (Tr \<sigma>) \<and> 0 < Re (Tr \<tau>)"
  let ?ren = "\<lambda>(w::real, \<sigma>::complex Matrix.mat, \<tau>::complex Matrix.mat).
                  (w * Re (Tr \<sigma>) * Re (Tr \<tau>),
                   complex_of_real (1 / Re (Tr \<sigma>)) \<cdot>\<^sub>m \<sigma>,
                   complex_of_real (1 / Re (Tr \<tau>)) \<cdot>\<^sub>m \<tau>)"
  have ren_def: "sep_renorm ts = map ?ren (filter ?keep ts)"
    unfolding sep_renorm_def by simp

  text \<open>Element-wise validity: each surviving renormalised triple
  has nonneg weight and unit-trace PSD factors of the right size.\<close>
  have valid_elt:
    "\<forall>x \<in> set (sep_renorm ts).
        case x of (w, \<sigma>, \<tau>) \<Rightarrow>
          w \<ge> 0
          \<and> \<sigma> \<in> carrier_mat m m \<and> psd \<sigma>
          \<and> \<tau> \<in> carrier_mat p p \<and> psd \<tau>"
  proof (intro ballI)
    fix x assume x_in: "x \<in> set (sep_renorm ts)"
    from x_in obtain w0 \<sigma>0 \<tau>0 where
      orig_in: "(w0, \<sigma>0, \<tau>0) \<in> set ts"
      and keep0: "?keep (w0, \<sigma>0, \<tau>0)"
      and x_eq: "x = ?ren (w0, \<sigma>0, \<tau>0)"
      unfolding ren_def by auto
    from ts_v orig_in have w0_nn: "w0 \<ge> 0"
                       and \<sigma>0_c: "\<sigma>0 \<in> carrier_mat m m"
                       and \<sigma>0_psd: "psd \<sigma>0"
                       and \<tau>0_c: "\<tau>0 \<in> carrier_mat p p"
                       and \<tau>0_psd: "psd \<tau>0"
      unfolding sep_cone_valid_def by auto
    have s_pos: "0 < Re (Tr \<sigma>0)" using keep0 by auto
    have t_pos: "0 < Re (Tr \<tau>0)" using keep0 by auto
    have w'_nn: "w0 * Re (Tr \<sigma>0) * Re (Tr \<tau>0) \<ge> 0"
      using w0_nn s_pos t_pos by simp
    have \<sigma>'_c: "complex_of_real (1 / Re (Tr \<sigma>0)) \<cdot>\<^sub>m \<sigma>0 \<in> carrier_mat m m"
      using \<sigma>0_c by auto
    have inv_s_nn: "0 \<le> 1 / Re (Tr \<sigma>0)" using s_pos by simp
    have inv_t_nn: "0 \<le> 1 / Re (Tr \<tau>0)" using t_pos by simp
    have \<sigma>'_psd: "psd (complex_of_real (1 / Re (Tr \<sigma>0)) \<cdot>\<^sub>m \<sigma>0)"
      by (rule psd_smult_nonneg[OF inv_s_nn \<sigma>0_psd \<sigma>0_c])
    have \<tau>'_c: "complex_of_real (1 / Re (Tr \<tau>0)) \<cdot>\<^sub>m \<tau>0 \<in> carrier_mat p p"
      using \<tau>0_c by auto
    have \<tau>'_psd: "psd (complex_of_real (1 / Re (Tr \<tau>0)) \<cdot>\<^sub>m \<tau>0)"
      by (rule psd_smult_nonneg[OF inv_t_nn \<tau>0_psd \<tau>0_c])
    have x_eq': "x = (w0 * Re (Tr \<sigma>0) * Re (Tr \<tau>0),
                       complex_of_real (1 / Re (Tr \<sigma>0)) \<cdot>\<^sub>m \<sigma>0,
                       complex_of_real (1 / Re (Tr \<tau>0)) \<cdot>\<^sub>m \<tau>0)"
      using x_eq by simp
    show "case x of (w, \<sigma>, \<tau>) \<Rightarrow>
            w \<ge> 0
            \<and> \<sigma> \<in> carrier_mat m m \<and> psd \<sigma>
            \<and> \<tau> \<in> carrier_mat p p \<and> psd \<tau>"
      unfolding x_eq'
      using w'_nn \<sigma>'_c \<sigma>'_psd \<tau>'_c \<tau>'_psd by simp
  qed

  text \<open>Weight sum: filtered triples contribute the same as all
  triples (dropped terms have a zero factor), and that sum equals
  Re (Tr (sep_sum ts)) = 1.\<close>
  have keep_unfilt:
    "(\<Sum>x\<leftarrow>filter ?keep ts. ?wt x) = (\<Sum>x\<leftarrow>ts. ?wt x)"
  proof -
    have drop_zero: "\<And>x. x \<in> set ts \<Longrightarrow> \<not> ?keep x \<Longrightarrow> ?wt x = 0"
    proof -
      fix x assume xs: "x \<in> set ts" and nk: "\<not> ?keep x"
      obtain w0 \<sigma>0 \<tau>0 where x_eq: "x = (w0, \<sigma>0, \<tau>0)" by (cases x)
      from ts_v xs x_eq have \<sigma>0_c: "\<sigma>0 \<in> carrier_mat m m"
                         and \<sigma>0_psd: "psd \<sigma>0"
                         and \<tau>0_c: "\<tau>0 \<in> carrier_mat p p"
                         and \<tau>0_psd: "psd \<tau>0"
        unfolding sep_cone_valid_def by auto
      have s_nn: "0 \<le> Re (Tr \<sigma>0)" by (rule Tr_psd_Re_nonneg[OF \<sigma>0_psd \<sigma>0_c])
      have t_nn: "0 \<le> Re (Tr \<tau>0)" by (rule Tr_psd_Re_nonneg[OF \<tau>0_psd \<tau>0_c])
      have "Re (Tr \<sigma>0) \<le> 0 \<or> Re (Tr \<tau>0) \<le> 0" using nk x_eq by auto
      hence "Re (Tr \<sigma>0) = 0 \<or> Re (Tr \<tau>0) = 0" using s_nn t_nn by linarith
      thus "?wt x = 0" using x_eq by auto
    qed
    have "(\<Sum>x\<leftarrow>ts. ?wt x)
            = (\<Sum>x\<leftarrow>filter ?keep ts. ?wt x)
              + (\<Sum>x\<leftarrow>filter (\<lambda>x. \<not> ?keep x) ts. ?wt x)"
      by (induction ts) auto
    moreover have "(\<Sum>x\<leftarrow>filter (\<lambda>x. \<not> ?keep x) ts. ?wt x) = 0"
      using drop_zero
      by (induction ts) auto
    ultimately show ?thesis by simp
  qed

  have Tr_eq: "Tr (sep_sum m p ts) = complex_of_real (\<Sum>x\<leftarrow>ts. ?wt x)"
    by (rule Tr_sep_sum_real[OF ts_v m_pos p_pos])
  hence sum_real: "(\<Sum>x\<leftarrow>ts. ?wt x) = 1" using Tr_one by (simp add: of_real_eq_iff)

  have map_wt:
    "(\<Sum>(w, \<sigma>, \<tau>)\<leftarrow>sep_renorm ts. w)
       = (\<Sum>x\<leftarrow>filter ?keep ts. ?wt x)"
    unfolding ren_def by (simp add: case_prod_beta map_concat o_def)

  have weight_sum: "(\<Sum>(w, \<sigma>, \<tau>)\<leftarrow>sep_renorm ts. w) = 1"
    using map_wt keep_unfilt sum_real by simp

  show ?thesis
    unfolding sep_decomp_valid_def
    using valid_elt weight_sum by auto
qed

lemma separable_cone_density_imp_separable_density:
  fixes m p :: nat and \<rho> :: "complex Matrix.mat"
  assumes \<rho>_cone: "separable_cone m p \<rho>"
      and \<rho>_dm: "density_matrix (m*p) \<rho>"
      and m_pos: "0 < m" and p_pos: "0 < p"
  shows "separable_density m p \<rho>"
proof -
  obtain ts where ts_v: "sep_cone_valid m p ts"
              and \<rho>_eq: "\<rho> = sep_sum m p ts"
    using \<rho>_cone unfolding separable_cone_def by blast
  have Tr_\<rho>: "Tr \<rho> = 1"
    using \<rho>_dm unfolding density_matrix_def by simp
  have Tr_sum: "Tr (sep_sum m p ts) = 1"
    using \<rho>_eq Tr_\<rho> by simp
  let ?ts' = "sep_renorm ts"
  have eq: "\<rho> = sep_sum m p ?ts'"
    using \<rho>_eq sep_sum_renorm[OF ts_v m_pos p_pos] by simp
  have ts'_v: "sep_decomp_valid m p ?ts'"
    by (rule sep_renorm_valid[OF ts_v Tr_sum m_pos p_pos])
  show ?thesis
    unfolding separable_density_def using ts'_v eq by blast
qed

(* Main theorem: hard direction of universal entanglement witnesses. *)

theorem nonseparable_implies_witness:
  fixes m p :: nat and \<rho> :: "complex Matrix.mat"
  assumes \<rho>_dm: "density_matrix (m*p) \<rho>"
      and \<rho>_nonsep: "\<not> separable_density m p \<rho>"
      and m_pos: "0 < m" and p_pos: "0 < p"
  shows "\<exists>W. entanglement_witness m p W \<and> Re (Tr (W * \<rho>)) < 0"
proof -
  have \<rho>_c: "\<rho> \<in> carrier_mat (m*p) (m*p)"
    using \<rho>_dm unfolding density_matrix_def by simp
  have \<rho>_h: "hermitian \<rho>"
    by (rule density_matrix_hermitian[OF \<rho>_dm])
  have \<rho>_noncone: "\<not> separable_cone m p \<rho>"
    using \<rho>_nonsep
    using separable_cone_density_imp_separable_density[OF _ \<rho>_dm m_pos p_pos]
    by blast
  obtain W where W_c: "W \<in> carrier_mat (m*p) (m*p)"
             and W_h: "hermitian W"
             and W_pos: "\<forall>\<sigma>. separable_cone m p \<sigma>
                              \<longrightarrow> 0 \<le> Re (Tr (W * \<sigma>))"
             and W_neg: "Re (Tr (W * \<rho>)) < 0"
    using separable_cone_separating_hyperplane
            [OF \<rho>_c \<rho>_h \<rho>_noncone m_pos p_pos]
    by blast
  have W_wit: "entanglement_witness m p W"
    by (rule cone_separator_is_witness[OF W_c W_h W_pos m_pos p_pos])
  show ?thesis using W_wit W_neg by blast
qed


(* ============================================================================
   DAY 29 \<mdash> 7 / Nov / 11
   Topic: Classical Error Correction; Hamming Weight and Distance
   ============================================================================ *)

(* --------------------------------------------------------------------------
   Classical binary strings as \<open>nat list\<close>s with entries in \<open>{0,1}\<close>.
   -------------------------------------------------------------------------- *)

definition hamming_weight :: "nat list \<Rightarrow> nat" where
  "hamming_weight v \<equiv> length (filter (\<lambda>b. b \<noteq> 0) v)"

definition hamming_dist :: "nat list \<Rightarrow> nat list \<Rightarrow> nat" where
  "hamming_dist v w \<equiv> hamming_weight (map2 (\<lambda>a b. (a + b) mod 2) v w)"

lemma hamming_weight_Nil [simp]: "hamming_weight [] = 0"
  by (simp add: hamming_weight_def)

lemma hamming_weight_Cons:
  "hamming_weight (a # v)
     = (if a \<noteq> 0 then Suc (hamming_weight v) else hamming_weight v)"
  by (simp add: hamming_weight_def)

lemma hamming_dist_Nil [simp]:
  "hamming_dist [] [] = 0"
  by (simp add: hamming_dist_def)

lemma hamming_dist_Cons:
  "hamming_dist (a # v) (b # w)
     = (if (a + b) mod 2 \<noteq> 0
        then Suc (hamming_dist v w)
        else hamming_dist v w)"
  by (simp add: hamming_dist_def hamming_weight_Cons)

lemma hamming_dist_symm:
  assumes "length v = length w"
  shows "hamming_dist v w = hamming_dist w v"
  using assms
proof (induction v arbitrary: w)
  case Nil thus ?case by (cases w) simp_all
next
  case (Cons a v)
  then obtain b ws where w_eq: "w = b # ws"
    by (cases w) auto
  with Cons.prems have len_eq: "length v = length ws" by simp
  show ?case
    using Cons.IH[OF len_eq] w_eq
    by (simp add: hamming_dist_Cons add.commute)
qed

lemma hamming_dist_zero:
  assumes lenw:   "length v = length w"
      and bits_v: "\<forall>x \<in> set v. x < 2"
      and bits_w: "\<forall>x \<in> set w. x < 2"
  shows "hamming_dist v w = 0 \<longleftrightarrow> v = w"
  using lenw bits_v bits_w
proof (induction v arbitrary: w)
  case Nil
  hence "w = []" by (cases w) auto
  thus ?case by simp
next
  case (Cons a v)
  obtain b ws where w_eq: "w = b # ws"
    using Cons.prems(1) by (cases w) auto
  have len_eq: "length v = length ws"
    using Cons.prems(1) w_eq by simp
  have a_lt: "a < 2" using Cons.prems(2) by simp
  have b_lt: "b < 2" using Cons.prems(3) w_eq by simp
  have bits_v': "\<forall>x \<in> set v. x < 2" using Cons.prems(2) by simp
  have bits_ws: "\<forall>x \<in> set ws. x < 2" using Cons.prems(3) w_eq by simp
  have bit_eq_iff_mod: "((a + b) mod 2 = 0) \<longleftrightarrow> a = b"
    using a_lt b_lt by arith
  have IH: "hamming_dist v ws = 0 \<longleftrightarrow> v = ws"
    using Cons.IH[OF len_eq bits_v' bits_ws] .
  show ?case
    using w_eq bit_eq_iff_mod IH
    by (auto simp: hamming_dist_Cons)
qed

lemma hamming_dist_self [simp]:
  "hamming_dist v v = 0"
  by (induction v, auto simp: hamming_dist_Cons)


(* --------------------------------------------------------------------------
   Code distance and error-correction capacity.
   -------------------------------------------------------------------------- *)

definition code_distance :: "nat list set \<Rightarrow> nat" where
  "code_distance code \<equiv>
     if (\<exists>v \<in> code. \<exists>w \<in> code. v \<noteq> w)
     then Min {hamming_dist v w | v w. v \<in> code \<and> w \<in> code \<and> v \<noteq> w}
     else 0"

definition corrects_errors :: "nat list set \<Rightarrow> nat \<Rightarrow> bool" where
  "corrects_errors code t \<equiv> code_distance code \<ge> 2*t + 1"


(* --------------------------------------------------------------------------
   Parity-check encoding: append the XOR of all bits.

   Adding any single-bit error changes one bit of the codeword, so the
   corrupted word differs from the original.
   -------------------------------------------------------------------------- *)

definition parity_bit :: "nat list \<Rightarrow> nat" where
  "parity_bit v \<equiv> foldr (\<lambda>a b. (a + b) mod 2) v 0"

definition parity_check_encode :: "nat list \<Rightarrow> nat list" where
  "parity_check_encode v \<equiv> v @ [parity_bit v]"

lemma length_parity_check_encode [simp]:
  "length (parity_check_encode v) = length v + 1"
  by (simp add: parity_check_encode_def)

lemma hamming_weight_pos_iff:
  "0 < hamming_weight v \<longleftrightarrow> (\<exists>x \<in> set v. x \<noteq> 0)"
  by (induction v, auto simp: hamming_weight_Cons)

lemma hamming_dist_pos_iff:
  assumes lenw:   "length v = length w"
      and bits_v: "\<forall>x \<in> set v. x < 2"
      and bits_w: "\<forall>x \<in> set w. x < 2"
  shows "0 < hamming_dist v w \<longleftrightarrow> v \<noteq> w"
  using hamming_dist_zero[OF lenw bits_v bits_w] by linarith

lemma parity_bit_lt_2: "parity_bit v < 2"
  by (induction v, auto simp: parity_bit_def)

lemma parity_check_encode_binary:
  assumes "\<forall>x \<in> set v. x < 2"
  shows "\<forall>x \<in> set (parity_check_encode v). x < 2"
  using assms parity_bit_lt_2
  by (auto simp: parity_check_encode_def)

(* Adding any single-bit error to a parity-check codeword changes that bit:
   the corrupted word differs from the original.  Both \<open>v\<close> and \<open>e\<close>
   are required to be binary; without that, a non-binary error of even
   value could leave the codeword unchanged modulo 2. *)

lemma parity_check_detects_one_error:
  assumes lenE:   "length e = length v + 1"
      and bits_v: "\<forall>x \<in> set v. x < 2"
      and bits_e: "\<forall>x \<in> set e. x < 2"
      and weight: "hamming_weight e = 1"
  shows "parity_check_encode v
           \<noteq> map2 (\<lambda>a b. (a + b) mod 2) (parity_check_encode v) e"
proof
  let ?c = "parity_check_encode v"
  let ?d = "map2 (\<lambda>a b. (a + b) mod 2) ?c e"
  assume eq: "?c = ?d"

  have len_c: "length ?c = length v + 1" by simp

  (* The error is binary with exactly one nonzero entry, hence e ! i = 1 there. *)
  have "0 < hamming_weight e" using weight by simp
  hence "\<exists>x \<in> set e. x \<noteq> 0" by (simp add: hamming_weight_pos_iff)
  then obtain x where x_in: "x \<in> set e" and x_nz: "x \<noteq> 0" by blast
  from x_in obtain i where i_lt: "i < length e" and x_eq: "e ! i = x"
    by (metis in_set_conv_nth)
  from x_in bits_e have x_lt: "x < 2" by simp
  from x_nz x_lt x_eq have ei_one: "e ! i = 1" by linarith

  have i_lt_c: "i < length ?c" using i_lt lenE by simp

  (* The codeword is binary, so its i-th entry is in {0,1}. *)
  have ci_bin: "?c ! i < 2"
  proof -
    have "?c ! i \<in> set ?c"
      using i_lt_c by (rule nth_mem)
    thus ?thesis
      using parity_check_encode_binary[OF bits_v] by blast
  qed

  (* The XOR'ed word at index i is (?c ! i + e ! i) mod 2. *)
  have d_at_i: "?d ! i = (?c ! i + e ! i) mod 2"
    using i_lt i_lt_c lenE by simp

  have eq_i: "?c ! i = (?c ! i + 1) mod 2"
    using eq d_at_i ei_one by simp
  thus False using ci_bin by presburger
qed


definition repetition_encode :: "nat list \<Rightarrow> nat list" where
  "repetition_encode v \<equiv> v @ v"

lemma length_repetition_encode [simp]:
  "length (repetition_encode v) = 2 * length v"
  by (simp add: repetition_encode_def)

lemma hamming_dist_repetition_doubles:
  assumes "length v = length w"
  shows "hamming_dist (repetition_encode v) (repetition_encode w)
           = 2 * hamming_dist v w"
  using assms
  unfolding repetition_encode_def hamming_dist_def hamming_weight_def
  by (simp add: zip_append1 zip_append2 mult_2)


